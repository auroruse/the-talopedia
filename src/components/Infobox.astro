---
import { renderInline, asset } from '../lib/inline.mjs';
const { title, nativeTitle, romaji, rows = [] } = Astro.props;
// Italics mark a transliteration. When the native name is already in Latin script
// the second line is another language's name, not a romanisation, so it stays upright.
const transliterated = /[^\u0000-\u024F]/.test([].concat(nativeTitle ?? '').join(''));
const lines = (v) => (Array.isArray(v) ? v : [v]).filter((x) => x != null && x !== '');
/**
 * A nested list's items as the nested lists they stand for. Two spaces of indent are a
 * level, and an item goes no deeper than one past the item above it or than the row's
 * depth, so a stray space never leaves one hanging off nothing.
 */
function outline(items = [], depth = 3) {
  let html = '', open = -1;
  for (const raw of items) {
    const text = raw.trim();
    if (!text) continue;
    const level = Math.max(0, Math.min(Math.floor((raw.length - raw.trimStart().length) / 2), open + 1, depth));
    html += level > open ? '<ul><li>' : '</li>' + '</ul></li>'.repeat(open - level) + '<li>';
    html += renderInline(text);
    open = level;
  }
  return html + '</li></ul>'.repeat(open + 1);
}
/** A cell's lines as a nested list, when any of them is indented under another; otherwise nothing. */
const tree = (items, r) => (items.some((l) => /^ {2,}\S/.test(l))
  ? `<div class="${r.guides === false ? 'ib-tree bare' : 'ib-tree'}">${outline(items, r.depth)}</div>` : '');
// The Nested List row that came first is a field whose value nests.
const view = rows.map((r) => (r.tree && r.value == null ? { ...r, value: r.tree } : r));
---
<aside class="infobox">
  <table class="ib">
    <tbody>
      <tr><td class="ib-head" colspan="2">
        <b>{title}</b>
        {lines(nativeTitle).map((n) => <span class="native" set:html={renderInline(n)} />)}
        {lines(romaji).map((r) => <span class:list={['romaji', !transliterated && 'upright']} set:html={renderInline(r)} />)}
      </td></tr>
      {view.map((r) =>
        r.pair ? (
          <tr class="ib-pair">
            {r.pair.map((col) => (
              <td>
                {col.heading && <b set:html={renderInline(col.heading)} />}
                {tree(col.items, r)
                  ? <Fragment set:html={tree(col.items, r)} />
                  : col.items.map((it) => <div class={it.trimStart().startsWith('•') ? 'sub' : ''} set:html={renderInline(it.replace(/^\s*•\s*/, ''))} />)}
              </td>
            ))}
          </tr>
        ) : r.office ? (
          <tr class="ib-office"><td colspan="2">
            <b set:html={renderInline(r.office)} />
            {lines(r.term).map((t) => <span set:html={renderInline(t)} />)}
          </td></tr>
        ) : r.section ? (
          <tr class="ib-section"><td colspan="2" set:html={renderInline(r.section)} /></tr>
        ) : r.images?.length || r.image ? (
          <tr class={r.join ? 'ib-join' : undefined}><td class="ib-media" colspan="2">
            {(() => {
              const shown = r.images?.length ? r.images.filter((im) => im.src) : [{ src: r.image, caption: r.caption }];
              // Side by side, each keeps a caption line even when empty, so every caption
              // stays under its own picture.
              const figs = shown.map((im) => (
                <figure style="margin:0">
                  <img src={asset(im.src)} alt={im.caption || title} />
                  {(im.caption || shown.length > 1) && <figcaption set:html={renderInline(im.caption || '')} />}
                </figure>
              ));
              // The cell stays a cell, spanning the row; the pictures share a box inside it.
              return shown.length > 1 ? <div class="ib-media-row">{figs}</div> : figs;
            })()}
          </td></tr>
        ) : !r.label ? (
          // A value with no label spans both columns, as a casualty total does.
          <tr><td class="ib-full" colspan="2">{tree(lines(r.value), r)
            ? <Fragment set:html={tree(lines(r.value), r)} />
            : lines(r.value).map((l) => <div set:html={renderInline(l)} />)}</td></tr>
        ) : (
          <tr>
            <th class={r.sub ? 'sub' : undefined} set:html={renderInline(r.label)} />
            <td>{tree(lines(r.value), r)
              ? <Fragment set:html={tree(lines(r.value), r)} />
              : lines(r.value).map((l) => <div set:html={renderInline(l)} />)}</td>
          </tr>
        )
      )}
    </tbody>
  </table>
</aside>
