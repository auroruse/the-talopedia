      .ctl-menu { left: 0; right: auto; top: calc(100% + 4px); }
    }

    /* ---- phone: the toolbar menus span the toolbar rather than overflowing ---- */
    @media (max-width: 700px) {
      .ed-tools { gap: 3px; padding: 5px; margin: 8px 10px; }
      .ed-tools .div { margin: 0 3px; }
