    .pub-steps { font-size: 12.5px; line-height: 1.6; color: var(--muted); margin: 8px 0 0; padding-left: 20px; }
    .pub-steps li { margin: 6px 0; }
    .pub-steps ul { margin: 4px 0; padding-left: 18px; }
    .pub-steps b { color: var(--ink); font-weight: 600; }
    .pub-steps code { font: 12px ui-monospace, monospace; color: var(--ink); }
    .cart-list { margin: 12px 0 4px; max-height: 260px; overflow-y: auto; }
    .cart-row {
      display: flex; align-items: center; gap: 9px; padding: 8px 10px; margin-bottom: 6px;
      background: var(--band); border: 1px solid var(--rule); border-radius: 6px;
    }
    .cart-tag {
      flex: none; font: 10px var(--body); text-transform: uppercase; letter-spacing: .05em;
