      display: none; position: absolute; left: 100%; top: -5px; z-index: 31;
      min-width: 232px; padding: 12px 14px;
      background: var(--lift); border: 1px solid var(--rule); border-radius: 8px;
      box-shadow: 0 10px 28px rgb(0 0 0 / .55);
    }
    .ins-item:hover > .ins-sub, .ins-item:focus-within > .ins-sub { display: block; }
    /* A label above its control, which is what stops the rows looking like a form
       printed by a machine. */
    .ins-f { display: block; font: 700 11px/1 var(--body); color: var(--muted); margin-bottom: 12px; }
    .ins-f > input, .ins-f > .mp-seg { display: flex; margin-top: 6px; width: 100%; }
    .ins-f > input { box-sizing: border-box; }
    .ins-sub .mp-seg button { flex: 1; white-space: nowrap; }
    .ins-sub .mp-hint { margin: 0 0 12px; }
    .ins-sub #dt-go { width: 100%; }
  .tbl-pick {
      display: grid; grid-template-columns: repeat(8, 20px); gap: 3px;
      padding: 12px 12px 6px; justify-content: center;
    }
    .tbl-cell {
      width: 20px; height: 18px; border: 1px solid var(--rule);
      border-radius: 2px; background: var(--paper); cursor: pointer;
    }
    .tbl-cell.on { background: var(--link); border-color: var(--link); }
    .tbl-size { margin: 0; padding: 0 12px 12px; text-align: center; font-size: 12px; color: var(--muted); }
    /* ---- the portal template ---- */
    .f-with-btn { display: flex; gap: 6px; }
    .f-with-btn input { flex: 1; min-width: 0; }
    .f-with-btn button {
      flex: none; font: 12px var(--body); color: var(--ink); background: var(--band);
      border: 1px solid var(--rule); border-radius: 4px; padding: 0 10px; cursor: pointer;
    }
    .f-with-btn button:hover { background: var(--hair); }
    .portal-note {
      border: 1px solid var(--rule); border-left: 4px solid var(--link);
      background: var(--band); padding: 16px 20px; border-radius: 4px;
    }
    .portal-note h2 { font: 400 20px/1.3 var(--display); margin: 0 0 10px; }
    .portal-note p { font-size: 13.5px; line-height: 1.65; color: var(--muted); margin: 0 0 10px; }
    .portal-note p:last-child { margin: 14px 0 0; }
    .portal-note b { color: var(--ink); font-weight: 600; }
    .portal-note button {
      font: 12.5px var(--body); color: var(--ink); background: var(--paper);
      border: 1px solid var(--rule); border-radius: 4px; padding: 6px 13px; cursor: pointer;
    }
    .portal-note button:hover:not(:disabled) { background: var(--lift); }
    .portal-note button:disabled { opacity: .45; cursor: default; }
    /* Nothing is inserted into a portal, and it has no headings to list. */
    .ed[data-kind="portal"] .drop:has(#style),
    .ed[data-kind="portal"] .drop:has(#insert),
    .ed[data-kind="portal"] [data-cmd],
    .ed[data-kind="portal"] #undo,
    .ed[data-kind="portal"] #redo,
    .ed[data-kind="portal"] .ed-rail { display: none; }

    /* ---- page settings ---- */
    /* Four columns at most: wider than that and a dozen fields scatter across the
       screen with nothing to tie them together. */
    .set-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 20px; align-items: start; }
    @media (min-width: 900px)  { .set-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (min-width: 1240px) { .set-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .set-toggles {
      display: flex; flex-wrap: wrap; gap: 10px 28px;
      margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--rule);
    }
    .ed-settings .opt, .ins-f .opt { font-size: 11px; color: var(--muted); font-weight: 400; margin-left: 4px; }
    .req-star { color: #d88; margin-left: 2px; }
    /* ---- floating image ---- */
    /* The block deliberately contains nothing: the picture floats out of it, which is
       the only way the paragraphs after it can wrap around it, as the article does.
       Any containment here (overflow, a bar in the flow) both stops the wrap and
       clips the move/remove controls, which sit outside the block in the gutter. */
    .blk-float { margin-top: 12px; }
    .float-edit { position: relative; z-index: 3; margin: 0; max-width: 100%; }
    .float-edit.float-right { float: right; margin-left: 20px; }
    .float-edit.float-left { float: left; margin-right: 20px; }
    .float-edit img { width: 100%; height: auto; display: block; }
    .float-grip {
      position: absolute; top: 34%; width: 12px; height: 34px; cursor: ew-resize;
      background: var(--link); border-radius: 3px; opacity: 0; transition: opacity .12s;
    }
    .float-edit.float-right .float-grip { left: -6px; }
    .float-edit.float-left .float-grip { right: -6px; }
    .float-edit:hover .float-grip { opacity: .85; }
    .float-bar {
      position: absolute; top: 0; left: 0; z-index: 4;
      display: flex; align-items: center; gap: 5px; padding: 5px;
      opacity: 0; transition: opacity .12s;
    }
    .float-edit:hover .float-bar, .float-edit:focus-within .float-bar { opacity: 1; }
    .float-edit > .ctl { top: 5px; right: 5px; left: auto; z-index: 6; }
    .float-edit:hover > .ctl, .float-edit:focus-within > .ctl, .float-edit > .ctl:hover {
      visibility: visible; opacity: 1;
    }
    /* The picture overlaps the blocks it floats past, so those blocks are hovered at
       the same time and would raise their own controls in the gutter beside it. While
       the pointer is on the picture, the picture's controls are the only ones. */
    #body:has(.float-edit:hover) .blk > .ctl { visibility: hidden; opacity: 0; }
    .float-bar button, .float-size {
      font: 12px var(--body); color: var(--ink); background: var(--lift);
      border: 1px solid var(--rule); border-radius: 4px; padding: 3px 9px;
    }
    .float-bar button { cursor: pointer; }
    .float-bar button:hover { background: var(--band); }
    .ib-add { display: flex; gap: 4px; padding: 7px; border-top: 1px solid var(--hair); }
    .ib-add button {
      flex: 1; font: 11.5px var(--body); color: var(--muted); background: transparent;
      border: 1px dashed var(--rule); border-radius: 3px; padding: 5px 4px; cursor: pointer;
    }
    .ib-add button:hover { color: var(--ink); border-style: solid; background: var(--band); }

    /* ---- block chrome ---- */
    /* Spacing lives on the block, not the text inside it, so the gutter label and
       controls line up with the line you are actually looking at. */
    .blk { position: relative; }
    .blk-section { margin-top: 26px; }
    .blk-subsection { margin-top: 18px; }
    .blk-para, .blk-list, .blk-table, .blk-image, .blk-grid { margin: 12px 0; }
    /* A block-level <img> is a replaced element, and CSS forbids one from overlapping
       a float: beside the sidebar the picture is pushed below it while its block stays
       put, which left the block's controls stranded a screen above the picture. Making
       the block its own formatting context moves the whole thing as a unit, the way a
       grid already does by being flex. */
    .blk-image { display: flow-root; }
    .blk-section .ce { font: 400 24px/1.3 var(--display); padding-bottom: 5px; border-bottom: 1px solid var(--rule); }
    .blk-subsection .ce { font: 700 17px/1.3 var(--body); }
    .ce-list { margin: 0; padding-left: 22px; }
    .ce-list li { margin: 3px 0; position: relative; padding-right: 26px; }
    /* A nested item, as the page shows it: a step in, and the bullet changes. */
    .ce-list li[data-level="1"] { margin-left: 24px; list-style-type: circle; }
    .ce-list li[data-level="2"] { margin-left: 48px; list-style-type: square; }
    .ce-list li[data-level="3"] { margin-left: 72px; }
    .ce-list li[data-level="4"] { margin-left: 96px; list-style-type: circle; }
    .ce-list li[data-level="5"] { margin-left: 120px; list-style-type: square; }
    .li-x {
      position: absolute; top: 0; right: 0; font: 11px/1 var(--body);
      color: var(--muted); background: var(--lift); border: 1px solid var(--rule);
      border-radius: 3px; padding: 2px 5px; cursor: pointer; opacity: 0; transition: opacity .12s;
    }
    .ce-list li:hover .li-x, .ce-list li:focus-within .li-x { opacity: 1; }
    .li-x:hover { color: var(--ink); background: var(--band); }

    #body { padding-left: 96px; margin-left: -96px; }
    .blk-tag {
      position: absolute; left: -96px; top: 1px; width: 88px; text-align: right;
      font: 10px var(--body); text-transform: uppercase; letter-spacing: .06em;
      color: #5c656e; opacity: 0; pointer-events: none;
    }
    .blk:hover > .blk-tag, .blk:focus-within > .blk-tag { opacity: 1; }

    /* Controls sit outside the content: in the gutter for blocks, beside the sidebar
       for its rows. A transparent border bridges the visual gap so the pointer can
       travel from the content to the buttons without the cluster vanishing. */
    .ctl {
      position: absolute; z-index: 5; display: flex; gap: 2px;
      padding: 2px; background: var(--lift); border: 1px solid var(--rule); border-radius: 5px;
      background-clip: padding-box;
      visibility: hidden; opacity: 0; transition: opacity .1s;
    }
    .blk > .ctl { top: 18px; right: 100%; left: auto; border-right: 9px solid transparent; }
    .blk:hover > .ctl, .blk:focus-within > .ctl, .blk > .ctl:hover,
    .ib-edit tr:hover .ctl, .ib-edit tr:focus-within .ctl, .ib-edit .ctl:hover {
