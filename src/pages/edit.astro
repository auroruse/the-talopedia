    /* The sidebar's picture cell behaves like a figure: hidden path, corner button. */
    .ib-media { position: relative; }
    .ib-media[data-slots="2"] { display: flex; gap: 8px; align-items: flex-start; }
    .ib-slot { position: relative; flex: 1; min-width: 0; }
    .ib-media input.path { position: absolute; width: 1px; height: 1px; padding: 0; border: 0; opacity: 0; }
    .ib-media .fig-empty { height: 60px; }
    .ib-slot:hover .fig-tools, .ib-slot:focus-within .fig-tools { opacity: 1; }
    .sub-add {
      font: 12px var(--body); color: var(--muted); background: transparent;
      border: 1px dashed var(--rule); border-radius: 3px; padding: 5px 12px; cursor: pointer;
    }
