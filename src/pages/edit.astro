    .pub label { display: block; font: 500 12px/1.4 var(--body); color: var(--ink); margin: 14px 0 0; }
    .pub input {
      display: block; box-sizing: border-box; width: 100%; margin-top: 5px;
      font: 13.5px var(--body); padding: 8px 9px; color: var(--ink);
