    .lp-empty { font-size: 12px; color: var(--muted); margin: 0; padding: 8px; }
    .lp-remove {
      width: 100%; margin-top: 6px; height: 30px; font: 12.5px var(--body); color: var(--link-new);
      background: transparent; border: 1px solid var(--rule); border-radius: 6px; cursor: pointer;
