      box-shadow: 0 12px 32px rgb(0 0 0 / .6);
    }
    .link-pop[hidden] { display: none; }
    .lp-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
    .lp-row svg { width: 15px; height: 15px; flex: none; fill: none; stroke: var(--muted); stroke-width: 1.4; stroke-linecap: round; }
    .lp-row input {
      flex: 1; min-width: 0; height: 32px; padding: 0 9px; font: 13.5px var(--body);
      color: var(--ink); background: var(--paper); border: 1px solid var(--rule); border-radius: 6px;
    }
