        position: static; left: auto; right: auto; top: auto; display: none;
        flex-direction: row; width: max-content; margin-top: 6px; border-left-width: 1px;
      }
      .ib-edit tr:hover .ctl, .ib-edit tr:focus-within .ctl, .ib-edit .ctl:hover {
        display: flex; visibility: visible; opacity: 1;
      }
      .ib-edit .ctl button { width: auto; min-width: 26px; }
