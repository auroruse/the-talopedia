    #lp-apply {
      height: 32px; padding: 0 14px; font: 13px var(--body); font-weight: 600; color: #f2f7f3;
      background: #3d6b53; border: 1px solid #4a7d62; border-radius: 6px; cursor: pointer;
    }
    #lp-apply:hover { background: #48795f; }
