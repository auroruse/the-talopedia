---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { TEMPLATES } from '../lib/templates.mjs';
import { ARTICLE_TYPES } from '../content.config';
import { nations, url } from '../lib/registry.mjs';
import slugTitleSource from '../lib/slug-title.mjs?raw';
import { icNow } from '../lib/icclock.mjs';
import { BUILT_FROM } from '../lib/revisions.mjs';
import { ACCOUNT_OF } from '../lib/contributors.mjs';
import fs from 'node:fs';
import { parse as parseYaml } from 'yaml';

// The byline a page carries, which is who may edit it once it exists. Same reading as
// .github/gate.mjs: `authors` when it is set, `nation` when it is not.
const credit = (d) => (d.authors?.length ? d.authors : d.nation ? [d.nation] : []);

const existing = [
  ...(await getCollection('articles')).map((e) => ({ slug: e.id, title: e.data.title, by: credit(e.data) })),
  // A portal is edited like anything else; the prefix is what tells the two apart,
  // since a portal and its nation's article share a slug.
  ...(await getCollection('portals')).map((e) => ({ slug: 'portal:' + e.id, title: e.data.title, by: [e.data.nation] })),
  // Navboxes are YAML rather than a collection, so they are read straight off disk.
  ...fs.readdirSync('src/content/data/navboxes').filter((f) => f.endsWith('.yaml')).map((f) => {
    const id = f.replace(/\.yaml$/, '');
    const d = parseYaml(fs.readFileSync(`src/content/data/navboxes/${f}`, 'utf8')) || {};
    // A navbox belongs to the nation it is named after. The site navbox is everybody's
    // and therefore nobody's, so it is the one that waits for a look.
    return { slug: 'navbox:' + id, title: `Navbox: ${d.title || id}`, by: id === 'site' ? [] : [id] };
  }),
].sort((a, b) => a.title.localeCompare(b.title));
const nationList = nations().map((n) => ({ id: n.id, name: n.name }));
const FLAGS = Object.fromEntries(nations().filter((n) => n.flag).map((n) => [n.id, n.flag]));
// A nation's own name, for labelling its flag in the icon picker: "E.S.U.", not "Esu".
const NATION_NAMES = Object.fromEntries(nations().map((n) => [n.id, n.name]));
const DEV = import.meta.env.DEV;
// Which repository a contributor's work goes to. The deploy workflow passes the one
// it is building, so a rename carries; the fallback is only for local use.
const REPO = process.env.GITHUB_REPO || 'auroruse/the-talopedia';
// Which nation a GitHub account writes for, so the editor can say whether a push will
// merge itself or wait. The owner of the repository is exempt from the byline rule,
// the same way .github/gate.mjs exempts them.
const NATION_OF = Object.fromEntries(Object.entries(ACCOUNT_OF).map(([n, a]) => [a, n]));
const ADMIN = REPO.split('/')[0];
---
<Base title="Editor" chrome={false} wide>
  <div class="ed">
    <div class="ed-tools">
      <button id="back" type="button" title="Back to the article" disabled>
        <svg viewBox="0 0 16 16"><path d="M13.2 8H3.4M7.6 3.8 3.2 8l4.4 4.2"/></svg>
      </button>
      <span class="div"></span>
      <div class="drop">
        <button id="file" type="button">File <span class="caret">▾</span></button>
        <div class="drop-menu list" id="file-menu" hidden>
          <button id="new" type="button">New article</button>
          <button id="new-portal" type="button">New portal</button>
          <button id="new-navbox" type="button">New navbox</button>
          <div class="menu-sep"></div>
          <button id="open-file" type="button">Open a file…</button>
          <button id="duplicate" type="button">Duplicate as a new page…</button>
          <input id="open-file-input" type="file" accept=".md,.markdown,.yaml,.yml" hidden />
          <div class="menu-sep"></div>
          <input id="file-q" type="search" placeholder="Search articles" autocomplete="off" />
          <div class="menu-list" id="file-list"></div>
        </div>
      </div>

      <span class="div"></span>
      <button id="undo" type="button" title="Undo (⌘Z)" disabled>
        <svg viewBox="0 0 16 16"><path d="M3 7h7a3.5 3.5 0 0 1 0 7H7"/><path d="M5.5 4.5 3 7l2.5 2.5"/></svg>
      </button>
      <button id="redo" type="button" title="Redo (⇧⌘Z)" disabled>
        <svg viewBox="0 0 16 16"><path d="M13 7H6a3.5 3.5 0 0 0 0 7h3"/><path d="M10.5 4.5 13 7l-2.5 2.5"/></svg>
      </button>

      <span class="div"></span>
      <button data-cmd="bold" title="Bold (⌘B)"><b>B</b></button>
      <button data-cmd="italic" title="Italic (⌘I)"><i>I</i></button>
      <button data-cmd="superscript" title="Superscript"><span class="xs">x<sup>2</sup></span></button>
      <button data-cmd="subscript" title="Subscript"><span class="xs">x<sub>2</sub></span></button>
      <button data-cmd="link" title="Link (⌘K)">
        <svg viewBox="0 0 16 16"><path d="M6.5 9.5a3 3 0 0 0 4.24 0l2-2a3 3 0 1 0-4.24-4.25l-1 1M9.5 6.5a3 3 0 0 0-4.24 0l-2 2a3 3 0 1 0 4.24 4.25l1-1"/></svg>
      </button>

      <span class="div"></span>
      <div class="drop">
        <button id="style" type="button" title="Insert text">
          <svg viewBox="0 0 16 16"><path d="M3 4V2.6h10V4M8 2.8v10.4M6 13.4h4"/></svg>
          Text <span class="caret">▾</span>
        </button>
        <div class="drop-menu list" id="style-menu" hidden>
          <button data-add="para"><span class="sty sty-para">Paragraph</span></button>
          <button data-add="section"><span class="sty sty-section">Heading</span></button>
          <button data-add="subsection"><span class="sty sty-subsection">Sub-heading</span></button>
          <button data-add="list"><span class="sty sty-list">Bulleted list</span></button>
        </div>
      </div>
      <div class="drop">
        <button id="insert" type="button" title="Insert media">
          <svg viewBox="0 0 16 16"><rect x="2" y="3" width="12" height="10" rx="1.5"/><circle cx="5.6" cy="6.4" r="1.1"/><path d="m2.6 11.4 3.2-3 2.4 2.2 2.6-2.5 3.2 3"/></svg>
          Media <span class="caret">▾</span>
        </button>
        <div class="drop-menu wide" id="insert-menu" hidden>
          <div class="mp-tabs">
            <button type="button" class="on" data-pane="images">Images</button>
            <button type="button" data-pane="icons">Icons</button>
          </div>

          <div class="mp-pane" id="pane-images">
            <div class="mp-row">
              <span class="mp-lbl">Insert as</span>
              <span class="mp-seg">
                <button type="button" class="on" data-as="image">Static</button>
                <button type="button" data-as="float">Floating</button>
                <button type="button" data-as="grid">Grid</button>
              </span>
            </div>
            <div class="mp-row">
              <span class="mp-lbl">Shape</span>
              <span class="mp-seg" id="mp-ratio">
                <button type="button" class="on" data-ratio="">Original</button>
                <button type="button" data-ratio="16x9">16:9</button>
                <button type="button" data-ratio="3x2">3:2</button>
                <button type="button" data-ratio="4x3">4:3</button>
                <button type="button" data-ratio="1x1">1:1</button>
                <button type="button" data-ratio="3x4">3:4</button>
              </span>
            </div>
            <div class="mp-row mp-link-row">
              <span class="mp-lbl">Link</span>
              <input id="mp-link" type="url" placeholder="https://i.ibb.co/…" autocomplete="off" />
              <button id="mp-link-go" type="button">Insert</button>
            </div>
            <p class="mp-hint" id="mp-link-note"></p>
            {DEV && (
              <Fragment>
                <div class="mp-row">
                  <span class="mp-lbl">Upload</span>
                  <button id="mp-add" type="button" class="mp-file-btn">Choose files…</button>
                  <input id="mp-file" type="file" accept="image/*" multiple hidden />
                </div>
                <div class="mp-queue" id="mp-queue" hidden>
                  <div id="mp-queue-list"></div>
                  <button id="mp-upload" type="button" class="primary" disabled>Upload</button>
                </div>
              </Fragment>
            )}
          </div>

          <div class="mp-pane" id="pane-icons" hidden>
            <input id="mp-iq" type="search" placeholder="Search icons" autocomplete="off" />
            <div class="mp-body" id="mp-icons"></div>
          </div>

        </div>
      </div>

      <div class="drop">
        <button id="ins" type="button" title="Insert">
          <svg viewBox="0 0 16 16"><path d="M8 3.2v9.6M3.2 8h9.6"/></svg>
          Insert <span class="caret">▾</span>
        </button>
        <div class="drop-menu list ins-menu" id="ins-menu" hidden>
          <div class="ins-item" data-ins="table">
            <button type="button">Table<span class="ins-arrow">›</span></button>
            <div class="ins-sub">
              <div class="tbl-pick" id="tbl-pick"></div>
              <p class="tbl-size"><span id="tbl-label">0 × 0</span></p>
            </div>
          </div>
          <div class="ins-item" data-ins="data-table">
            <button type="button">Data table<span class="ins-arrow">›</span></button>
            <div class="ins-sub">
              <div class="tbl-pick" id="dtbl-pick"></div>
              <p class="tbl-size"><span id="dtbl-label">0 × 0</span></p>
            </div>
          </div>
          <div class="ins-item" data-ins="date">
            <button type="button">Date<span class="ins-arrow">›</span></button>
            <div class="ins-sub ins-sub-date">
              <label class="ins-f"><span id="dt-date-label">Date</span><input id="dt-date" type="date" /></label>
              <label class="ins-f">Show
                <span class="mp-seg" id="dt-mode">
                  <button type="button" class="on" data-mode="">Plain</button>
                  <button type="button" data-mode="ago">Elapsed</button>
                  <button type="button" data-mode="age">Age</button>
                </span>
              </label>
              <label class="ins-f" id="dt-died-row" hidden>Died <span class="opt">optional</span><input id="dt-died" type="date" /></label>
              <p class="mp-hint" id="dt-preview"></p>
              <button id="dt-go" type="button" class="primary">Insert</button>
            </div>
          </div>
        </div>
      </div>

      <button id="settings-btn" type="button" title="Page settings"><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="4.6"/><circle cx="8" cy="8" r="2.1"/><path d="M8 1.7v2.3M8 12v2.3M14.3 8H12M4 8H1.7M12.46 3.54 10.83 5.17M5.17 10.83 3.54 12.46M12.46 12.46 10.83 10.83M5.17 5.17 3.54 3.54"/></svg></button>

      <span class="spacer"></span>
      <span id="status" class="status"></span>
      <span class="save-group">
        {/* Writing straight to disk needs the dev server, so Save is only there. Setting
            a page aside for a pull request works in both, or it could never be tried
            out while developing. */}
        {DEV && (
          <Fragment>
            <input id="slug" type="text" placeholder="file-name" spellcheck="false" />
            <button id="save" type="button" class="primary">Save</button>
          </Fragment>
        )}
        <input id="f-summary" type="text" placeholder="What changed?" spellcheck="false"
          title="A line describing this edit. It becomes the commit message and shows in the page's history." />
        <button id="cart-add" type="button" class="commit"
          title="Put this page with the others, to be pushed as one pull request">Commit</button>
        <button id="cart-open" type="button" title="Pages waiting to be pushed">
          Changes <span class="cart-n" id="cart-n">0</span>
        </button>
      </span>
      <div class="drop">
        <button id="more" type="button" title="More">⋯</button>
        <div class="drop-menu right list" id="more-menu" hidden>
          <button id="download">Download .md</button>
          <button id="copy">Copy Markdown</button>
          <button id="source">View Markdown</button>
        </div>
      </div>
    </div>

    <div class="ed-settings" id="settings" hidden>
      <div class="set-grid">
        <label>Title <span class="req-star">*</span><input id="f-title" type="text" placeholder="Nichirin" /></label>
        <label id="crumb-field" hidden>Breadcrumb <span class="opt">navbox</span>
          <input id="f-crumb" type="text" placeholder="[[portal:nichirin|Portal:Nichirin]] • [[nichirin|Overview]]" /></label>
        {/* The sidebar heading is edited at the top of the sidebar itself. These carry
            the same three values, so the markdown, the draft and the slug still have
            one place to read them from. */}
        <input id="f-boxtitle" type="hidden" />
        <textarea id="f-native" hidden></textarea>
        <input id="f-romaji" type="hidden" />
        <label id="url-field">Article URL <span class="opt">the file name</span>
          <input id="f-slug" type="text" placeholder="emeka-okafor" spellcheck="false"
            title="The address this page is served at, and the name of its file" /></label>
        <label id="type-field">Article type<select id="f-type">{ARTICLE_TYPES.map((t) => <option value={t}>{t}</option>)}</select></label>
        <label id="nation-field">Associated nation<select id="f-nation"><option value="">(none)</option>
          {nationList.map((n) => <option value={n.id}>{n.name}</option>)}</select></label>
        <label id="authors-field">Author(s)<input id="f-authors" type="text" placeholder="nichirin, alemannia" /></label>
        <label id="coords-field" hidden>Coordinates
          <input id="f-coords" type="text" placeholder="35.68°N 139.69°E" /></label>
        <label id="icon-field">Icon <span class="opt">optional</span>
          <input id="f-icon" type="text" placeholder="/assets/flags/nichirin.png" /></label>
        <label id="banner-field" hidden>Banner <span class="opt">portal</span>
          <span class="f-with-btn">
            <input id="f-banner" class="path" type="text" placeholder="/assets/media/nichirin-portal-banner.jpg" />
            <button id="f-banner-pick" type="button">Choose…</button>
          </span></label>
        <label id="welcome-field" hidden>Welcome line <span class="opt">portal</span>
          <input id="f-welcome" type="text" placeholder="「日輪へようこそ！」" /></label>
      </div>
      <div class="set-toggles">
        <label class="check"><input id="f-ooc" type="checkbox" /> Contains out-of-character information</label>
        <label class="check"><input id="f-sidebar-on" type="checkbox" checked /> Display sidebar
          <span class="opt" id="sidebar-note"></span></label>
        <label class="check"><input id="f-navbox-on" type="checkbox" checked /> Display navbox
          <span class="opt" id="navbox-note"></span></label>
      </div>
    </div>

    <div class="ed-main">
    <aside class="ed-rail">
      <div class="toc-head"><b>Contents</b><button id="ed-toc-toggle" type="button">hide</button></div>
      <ul class="toc-list" id="ed-toc"></ul>
    </aside>
    <div class="ed-canvas">
      <p class="notice" id="ooc-note" hidden>
        This article contains out-of-character (OOC) information. Some details presented here are
        not publicly available in-character (IC).
      </p>
      <h1 id="canvas-title" contenteditable="true" spellcheck="false" data-ph="Article title"></h1>
      <div class="canvas-sub"><span id="canvas-by"></span></div>

      <div class="article">
        <aside class="infobox ib-edit">
          <table class="ib"><tbody id="ib">
            {/* Edited where it is read. Blank takes the article's own title; the two
                below are left out of the page entirely when they are empty. */}
            <tr><td class="ib-head" colspan="2">
              <b id="ib-title" contenteditable="true" spellcheck="false" data-ph="Article title"></b>
              <span class="native" id="ib-native" contenteditable="true" spellcheck="false"
                data-ph="Native title" title="Shift ↵ for another language"></span>
              <span class="romaji" id="ib-romaji" contenteditable="true" spellcheck="false"
                data-ph="Romanisation"></span>
            </td></tr>
          </tbody></table>
          <div class="ib-add"><button id="ib-first" type="button">+ Add a field</button></div>
        </aside>
        <div class="portal-note" id="portal-note" hidden>
          <h2>A portal is a template</h2>
          <p>Three things are yours to set: the <b>banner</b> and the <b>welcome line</b>,
             both in page settings, and the nation's <b>navbox</b>.</p>
          <p>The opening paragraph is not written here. It is taken from the nation's
             overview article automatically, as soon as one exists —
             <span id="portal-overview"></span></p>
          <p><button id="go-navbox" type="button">Edit this nation's navbox</button></p>
        </div>
        <div id="body"></div>
      </div>
    </div>

    </div>

    <div class="link-pop" id="link-pop" hidden>
      <div class="lp-row">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h7"/></svg>
        <input id="lp-text" type="text" placeholder="Text to display" autocomplete="off" />
      </div>
      <div class="lp-row">
        <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.6"/><path d="M10.4 10.4 14 14"/></svg>
        <input id="lp-target" type="text" placeholder="Search for an article or paste a link" autocomplete="off" />
        <button id="lp-apply" type="button">Apply</button>
      </div>
      <div class="lp-list" id="lp-list"></div>
      <button id="lp-remove" type="button" class="lp-remove" hidden>Remove link</button>
    </div>

    <div class="pub-back" id="pub-panel" hidden>
      <div class="pub">
        <h2>Changes waiting</h2>
        <p class="pub-note" id="pub-intro">
          All of it goes as one pull request. Nothing reaches the site until reviewed.
        </p>

        <div class="cart-list" id="cart-list"></div>

        <label>GitHub token
          <input id="pub-token" type="password" autocomplete="off" spellcheck="false"
            placeholder="ghp_…" /></label>

        <details class="pub-help" id="pub-help">
          <summary>Need a token?</summary>
          <ol class="pub-steps">
            <li><a id="pub-make" href="#" target="_blank" rel="noopener">Open token page</a>.
              Log in if asked.</li>
            <li>Name filled. <b>public_repo</b> ticked. <b>Touch nothing else.</b></li>
            <li>Pick expiry. Any.</li>
            <li>Scroll down. Press <b>Generate token</b>.</li>
            <li>Copy it. Starts with <code>ghp_</code>. Shown once.</li>
            <li>Paste in box above.</li>
          </ol>
          <p class="pub-note">Your token stays in this browser and goes only to GitHub.</p>
        </details>

        <p class="pub-status" id="pub-status"></p>
        <div class="pub-row">
          <button id="pub-go" type="button" class="primary">Push</button>
          <button id="pub-forget" type="button">Forget token</button>
          <span class="spacer"></span>
          <button id="pub-close" type="button">Close</button>
        </div>
      </div>
    </div>

    <div class="ed-source" id="source-panel" hidden>
      <div class="src-head"><b>Markdown</b><button id="source-close" type="button">Close</button></div>
      <pre id="preview"></pre>
    </div>
  </div>

  <script is:inline set:html={`window.slugTitle = (() => {\n${slugTitleSource.replace('export function', 'function')}\nreturn slugTitle;\n})();`} />
  <script is:inline define:vars={{ TEMPLATES, BASE: url('/'), DEV, REPO, FLAGS, NATION_NAMES, ARTICLES: existing,
    NATION_OF, ADMIN, BUILT_FROM, IC_NOW: icNow().toISOString().slice(0, 10) }}>
    const $ = (s, r = document) => r.querySelector(s);
    const el = (t, c, txt) => { const n = document.createElement(t); if (c) n.className = c; if (txt != null) n.textContent = txt; return n; };
    const q = (s) => '"' + String(s ?? '').replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"';
    const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    // What is open: an article, a nation portal, or a navbox. Each lives in its own
    // directory and writes a different file, and a portal and a navbox both share
    // their slug with the nation's article, so the kind cannot be read off the name.
    let pageKind = 'article';
    // The file this page came from. The slug box only exists on the dev server, so on
    // the published site this is the only thing that knows a portal is filed under its
    // nation rather than under "Portal:Nichirin".
    let pageSlug = '';
    // The commit of main the open page was read from. It goes out with every commit as
    // a Based-on line, and the auto-merge merges against it: a writer whose copy is
    // behind main then neither collides with what landed since nor quietly undoes it.
    // Empty where it cannot be known (a file opened from disk), which merges the old way.
    let loadedFrom = '';
    // The title and the text the open page had when it was loaded. Saving under the
    // same file name with a different title is how an article gets used as a template
    // and overwritten; the text is what tells a rename apart from a replacement.
    let loadedTitle = '', loadedBody = '';
    let navboxLead = '';
    // A portal's body is not editable here. Two nations have no overview article yet
    // and their portal still carries its own paragraph, so whatever was loaded is
    // written back rather than dropped.
    let portalBody = '';

    /* ---------- names ---------- */
    // slugTitle is src/lib/slug-title.mjs, inlined above, so the site reads slugs the same way.
    let TITLES = {};
    const ICONS = { ...FLAGS };
    const titlesReady = fetch(`${BASE.replace(/\/$/, '')}/articles.json`)
      .then((r) => r.json())
      .then((l) => { for (const a of l) { TITLES[a.slug] = a.title; if (a.icon && !ICONS[a.slug]) ICONS[a.slug] = a.icon; } })
      .catch(() => {});
    const displayOf = (slug) => TITLES[slug] || slugTitle(slug);

    // Arrows and flags are shown as themselves, not as :up or :flag[nichirin].
    const ARROW = { up: '\u25B2', down: '\u25BC' };
    const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'];
    const longDate = (iso) => {
      const [y, m, d] = iso.split('-').map(Number);
      return `${MONTHS[m - 1]} ${d}, ${y}`;
    };
    /** Whole years from one date to another, the way an age is counted. */
    function yearsBetween(fromIso, toIso) {
      const [fy, fm, fd] = fromIso.split('-').map(Number);
      const [ty, tm, td] = toIso.split('-').map(Number);
      return ty - fy - (tm < fm || (tm === fm && td < fd) ? 1 : 0);
    }
    /**
     * What :date[...] will say once published. The article stores the date and the
     * kind of working-out; the number is recomputed on every build against the Avium
     * clock, so an age never goes stale in the text.
     */
    function dateLabel(arg) {
      const [iso, mode = ''] = String(arg).split('|');
      const date = iso.trim();
      if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return arg;
      const long = longDate(date);
      const [kind, from] = mode.trim().split(':');
      if (kind === 'ago') {
        const n = yearsBetween(date, IC_NOW);
        return `${long} (${n === 0 ? 'this year' : `${n} year${n === 1 ? '' : 's'} ago`})`;
      }
      if (kind === 'age') {
        return `${long} (aged ${/^\d{4}-\d{2}-\d{2}$/.test(from || '')
          ? yearsBetween(from, date) : yearsBetween(date, IC_NOW)})`;
      }
      return long;
    }

    function tokenHtml(kind, arg) {
      if (kind === 'up' || kind === 'down') {
        return `<span class="tok arrow ${kind}" data-tok="${kind}" contenteditable="false">${ARROW[kind]}</span>`;
      }
      if (kind === 'date') {
        return `<span class="tok date" data-tok="date" data-slug="${esc(arg)}" contenteditable="false">`
          + `${esc(dateLabel(arg))}</span>`;
      }
      // :img carries its own path and an optional pixel width; :icon and :flag look
      // the subject up in the registry.
      const [path, w] = kind === 'img' ? arg.split('|') : [arg];
      const size = parseInt(w, 10);
      const src = srcFor(kind === 'img' ? path.trim() : ICONS[arg]);
      const sym = kind === 'img' && path.trim().startsWith('/assets/icons/') ? ' sym' : '';
      const style = size > 0 ? ` style="width:${size}px;height:auto"` : '';
      return src
        ? `<img class="tok ico${size > 0 ? ' sized' : ''}${sym}" data-tok="${kind}" data-slug="${esc(arg)}" src="${src}"${style} alt="" contenteditable="false">`
        : `<span class="tok missing" data-tok="${kind}" data-slug="${esc(arg)}" contenteditable="false">:${kind}[${arg}]</span>`;
    }

    /* ---------- markdown <-> editable html ---------- */
    function mdToHtml(md) {
      return esc(md)
        .replace(/&lt;br\s*\/?&gt;/g, '<br>')
        // The same four the site reads. Leaving date out of this list left it sitting
        // in the editor as the words ":date[1888-06-09|age]".
        .replace(/:(icon|flag|img|date)\[([^\]]+?)\]/g, (_, k, a) => tokenHtml(k, a.trim()))
        .replace(/:(up|down)(?![A-Za-z])/g, (_, k) => tokenHtml(k))
        .replace(/\[\[([^\]|]+?)\|([^\]]+?)\]\]/g, (_, s, d) => `<a href="#" data-slug="${s}">${d}</a>`)
        .replace(/\[\[([^\]|]+?)\]\]/g, (_, s) => `<a href="#" data-slug="${s}">${displayOf(s)}</a>`)
        .replace(/\[([^\]]+)\]\((https?:[^)]+)\)/g, '<a href="$2">$1</a>')
        .replace(/&lt;(sup|sub|small)&gt;([\s\S]*?)&lt;\/\1&gt;/g, '<$1>$2</$1>')
        .replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>')
        .replace(/\*([^*]+)\*/g, '<i>$1</i>');
    }

    /**
     * Bold or italic marks around text, with any space at its edges put outside them.
     * Markdown will not close ** after a space or open it before one, so a bold word
     * that took its trailing space along printed on the page as **word **, asterisks
     * and all. Marks around nothing but a comma or a space are dropped.
     */
    const emphasis = (m, s) => {
      const [, lead, core, tail] = s.match(/^(\s*)([\s\S]*?)(\s*)$/);
      return /[^\s\p{P}]/u.test(core) ? `${lead}${m}${core}${m}${tail}` : s;
    };

    function htmlToMd(node, br = ' ') {
      let out = '';
      for (const n of node.childNodes) {
        // A no-break space is how a browser keeps a space visible at the end of a line
        // or beside an arrow; none of them were typed as one, and none belong on the page.
        if (n.nodeType === 3) { out += n.nodeValue.replace(/\u00a0/g, ' '); continue; }
        if (n.nodeType !== 1) continue;
        const tag = n.tagName.toLowerCase();
        if (tag === 'br') { out += br; continue; }
        const tok = n.dataset?.tok;
        if (tok === 'up' || tok === 'down') {
          // A digit straight after reads fine (:down1 is down one); a letter would read
          // as part of the name, so it gets a space.
          out += `:${tok}` + (/^[A-Za-z]/.test(n.nextSibling?.nodeValue || '') ? ' ' : '');
          continue;
        }
        if (tok) { out += `:${tok}[${n.dataset.slug}]`; continue; }
        const inner = htmlToMd(n, br);
        if (tag === 'b' || tag === 'strong') out += emphasis('**', inner);
        else if (tag === 'i' || tag === 'em') out += emphasis('*', inner);
        // Markdown has no superscript or small print, so these stay as the HTML they are.
        else if (tag === 'sup' || tag === 'sub' || tag === 'small') out += inner.trim() ? `<${tag}>${inner}</${tag}>` : '';
        else if (tag === 'a') {
          const slug = n.dataset.slug;
          if (slug) out += displayOf(slug) === inner ? `[[${slug}]]` : `[[${slug}|${inner}]]`;
          else out += `[${inner}](${n.getAttribute('href')})`;
        } else if (tag === 'div' || tag === 'p') out += (out && !out.endsWith(br) ? br : '') + inner;
        else out += inner;
      }
      return out;
    }

    /**
     * Word processors mark emphasis with styles rather than tags, so a tag list alone
     * reads a Google Docs paste as unformatted. These answer the same question the
     * tags do, and Docs' own wrapper is the reason the negative cases are checked:
     * every copied run arrives inside a <b style="font-weight:normal">.
     */
    function marksOf(n) {
      const st = n.style || {};
      const w = st.fontWeight;
      const bold = w ? (w === 'bold' || w === 'bolder' || Number(w) >= 600)
                     : (n.tagName === 'B' || n.tagName === 'STRONG');
      const italic = st.fontStyle ? st.fontStyle === 'italic'
                                  : (n.tagName === 'I' || n.tagName === 'EM');
      const va = st.verticalAlign;
      const sup = va === 'super' || n.tagName === 'SUP';
      const sub = va === 'sub' || n.tagName === 'SUB';
      return [bold && 'b', italic && 'i', sup && 'sup', sub && 'sub'].filter(Boolean);
    }

    /** A link's real target. Google rewrites every one it copies through a redirect. */
    function hrefOf(n) {
      const raw = n.getAttribute('href') || '';
      const m = raw.match(/^https?:\/\/(?:www\.)?google\.[a-z.]+\/url\?(.*)$/i);
      if (!m) return raw;
      const q = new URLSearchParams(m[1]).get('q');
      return q || raw;
    }

    /** Strip a pasted fragment down to what this editor can represent. */
    function keepTokens(html) {
      const doc = new DOMParser().parseFromString(html, 'text/html');
      // A block on the clipboard is a line here: the editor's own blocks are made by
      // the writer, never by whatever the text was pasted out of.
      const BLOCK = new Set(['P', 'DIV', 'LI', 'TR', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6']);
      const walk = (node) => {
        let out = '';
        for (const n of node.childNodes) {
          if (n.nodeType === 3) { out += esc(n.nodeValue); continue; }
          if (n.nodeType !== 1) continue;
          const tag = n.tagName;
          if (tag === 'IMG' && n.dataset.tok) {
            out += tokenHtml(n.dataset.tok, n.dataset.slug || n.getAttribute('src'));
            continue;
          }
          if (tag === 'SPAN' && n.dataset.tok) {
            out += tokenHtml(n.dataset.tok, n.dataset.slug || '');
            continue;
          }
          if (tag === 'BR') { out += '<br>'; continue; }
          if (tag === 'STYLE' || tag === 'SCRIPT' || tag === 'IMG') continue;

          let inner = walk(n);
          for (const mark of marksOf(n)) inner = inner.trim() ? `<${mark}>${inner}</${mark}>` : inner;
          if (tag === 'A') {
            const href = n.dataset.slug ? '#' : hrefOf(n);
            const slug = n.dataset.slug ? ` data-slug="${esc(n.dataset.slug)}"` : '';
            if (href && inner.trim()) inner = `<a href="${esc(href)}"${slug}>${inner}</a>`;
          }
          if (BLOCK.has(tag) && out && !out.endsWith('<br>') && inner.trim()) out += '<br>';
          out += inner;
        }
        return out;
      };
      return walk(doc.body);
    }

    /** Fill a table from tab-separated text, growing it to fit. */
    function pasteGrid(startCell, text) {
      const table = startCell.closest('.ed-tbl');
      const grid = text.replace(/\r/g, '').replace(/\n+$/, '').split('\n').map((r) => r.split('\t'));
      const row0 = startCell.parentElement;
      const r0 = [...table.tBodies[0].rows].indexOf(row0);
      const c0 = [...row0.children].indexOf(startCell);
      for (let r = 0; r < grid.length; r++) {
        while (table.tBodies[0].rows.length <= r0 + r) table._addRow();
        const tr = table.tBodies[0].rows[r0 + r];
        for (let c = 0; c < grid[r].length; c++) {
          while (tr.children.length <= c0 + c) table._addCol();
          const td = tr.children[c0 + c];
          if (!td) continue;
          td.querySelector('.ce').innerHTML = mdToHtml(grid[r][c].trim());
        }
      }
      sync();
    }

    /** Every editable surface: plain text in, plain text out, no pasted styling. */
    function editable(html, ph, onEnter) {
      const d = el('div', 'ce');
      d.contentEditable = 'true';
      d.spellcheck = false;
      if (ph) d.dataset.ph = ph;
      d.innerHTML = html || '';
      d.addEventListener('paste', (e) => {
        const dt = e.clipboardData;
        const text = dt.getData('text/plain');
        const html = dt.getData('text/html');
        e.preventDefault();
        // Bold, italics, superscript and links come across from wherever the text
        // was copied. Everything else is dropped, because the stylesheet is the
        // Manual of Style and there is nothing else to paste into.
        const clean = plainPaste || !html ? '' : keepTokens(html);
        plainPaste = false;
        if (clean.replace(/<[^>]*>/g, '').trim()) {
          document.execCommand('insertHTML', false, clean);
          unglue(d);
          return;
        }
        document.execCommand('insertText', false, text);
      });
      d.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); onEnter?.(d, e); }
      });
      d.addEventListener('input', sync);
      d.addEventListener('focusin', () => { focused = d; });
      return d;
    }

    /**
     * Set by the shortcut for pasting without formatting, and read by the next paste.
     * The event itself does not say which shortcut opened it.
     */
    let plainPaste = false;
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.shiftKey && (e.key === 'v' || e.key === 'V')) plainPaste = true;
    }, true);

    let focused = null;      // last focused rich-text surface
    let lastPath = null;     // last focused image path field
    // Which of the two was touched most recently, and the last block in the article
    // body the writer stood in. Without these a picked image lands wherever it last
    // landed: in a stale path field, or at the end of the article.
    let focusedAt = 0, lastPathAt = 0;
    let lastBodyBlk = null;
    const lineBreak = () => document.execCommand('insertLineBreak');
    // mousedown fires before focus moves, so this survives clicking a toolbar menu.
    for (const ev of ['focusin', 'mousedown', 'keyup']) {
      document.addEventListener(ev, (e) => {
        const p = e.target.closest?.('input.path');
        if (p) { lastPath = p; lastPathAt = Date.now(); }
        let c = e.target.closest?.('.ce');
        if (!c && e.target.closest?.('.ed-tbl')) {
          const n = getSelection().anchorNode;
          c = (n?.nodeType === 1 ? n : n?.parentElement)?.closest?.('.ce');
        }
        if (c) {
          focused = c; focusedAt = Date.now();
          // By id, not by the `body` binding: this listener is registered before that
          // const is initialised, and touching it early would throw in the handler.
          const blk = c.closest('.blk');
          if (blk?.parentElement?.id === 'body') lastBodyBlk = blk;
        }
      }, true);
    }
    const activeField = () => {
      const a = document.activeElement;
      if (a?.matches?.('input.path')) return a;
      // A field the writer has left only stays the target while it is still the most
      // recent thing they touched. Once the caret is back in the article, the article wins.
      return lastPath?.isConnected && lastPathAt >= focusedAt ? lastPath : null;
    };
    // The caret, as it was before the toolbar took focus.
    let caret = null;
    document.addEventListener('selectionchange', () => {
      const sel = getSelection();
      if (!sel.rangeCount) return;
      const n = sel.anchorNode;
      const host = (n?.nodeType === 1 ? n : n?.parentElement)?.closest?.('.ce, .ed-tbl');
      if (host) caret = sel.getRangeAt(0).cloneRange();
    });

    /**
     * Chrome keeps the spaces beside anything insertHTML puts in by turning them into
     * no-break spaces. Beside a new link that glues the words either side of it into
     * one run that cannot wrap, so the run drops to the next line with room left on
     * this one. A no-break space with a character on both sides of it is only ever
     * that, so it goes back to an ordinary space. One at the very end of a line stays:
     * it is what keeps a trailing space visible while the writer is still typing.
     */
    function unglue(box) {
      if (!box) return;
      const sel = getSelection();
      const keep = sel.rangeCount && [sel.anchorNode, sel.anchorOffset, sel.focusNode, sel.focusOffset];
      const nodes = [];
      const walk = document.createTreeWalker(box, NodeFilter.SHOW_TEXT);
      while (walk.nextNode()) nodes.push(walk.currentNode);
      const all = nodes.map((n) => n.nodeValue).join('');
      let base = 0;
      for (const n of nodes) {
        const v = n.nodeValue;
        let w = '';
        for (let i = 0; i < v.length; i++) {
          const g = base + i;
          w += v[i] === '\u00a0' && /\S/.test(all[g - 1] || '') && /\S/.test(all[g + 1] || '') ? ' ' : v[i];
        }
        if (w !== v) n.nodeValue = w;
        base += v.length;
      }
      // Same length, so the caret's offsets still point where they did.
      if (keep) sel.setBaseAndExtent(...keep);
    }

    /** Put the caret back and insert there, in a plain field or a table cell. */
    function insertAtCaret(html) {
      const where = activeText();
      if (!where) return false;
      // A table cell is not its own editing host; the table is.
      const host = where.closest('.ed-tbl') || where;
      const sel = getSelection();
      // Read the target range before touching focus: focusing a host that is not
      // already focused collapses the caret to its start, which in a table means
      // the header cell rather than the one the writer clicked.
      const range = sel.rangeCount && host.contains(sel.anchorNode) ? sel.getRangeAt(0).cloneRange()
        : caret && host.contains(caret.startContainer) ? caret.cloneRange()
        : null;
      if (document.activeElement !== host) host.focus();
      if (range) { sel.removeAllRanges(); sel.addRange(range); }
      document.execCommand('insertHTML', false, html);
      // Inserting at a cell boundary can drop the content beside the .ce wrapper
      // rather than inside it, where the serializer would never see it again.
      const cellNow = (sel.anchorNode?.nodeType === 1 ? sel.anchorNode : sel.anchorNode?.parentElement)
        ?.closest?.('td, th');
      if (cellNow) {
        // The writer's own box, and only one sitting directly in the cell: a picture
        // row holds a box per picture, and sweeping into the first would swallow the
        // rest of the row.
        const box = [...cellNow.children].find((n) => n.classList.contains('ce'));
        // What execCommand can strand beside it is text or an inline mark. Everything
        // else in the cell is the editor's own furniture and stays where it is.
        // Rescuing by exclusion instead put the row controls' own labels into two
        // published articles, since a control is a div and only buttons were skipped.
        const loose = (n) => n.nodeType === 3
          || (n.nodeType === 1 && /^(IMG|A|I|B|EM|STRONG|SPAN|BR|CODE|SUP|SUB)$/.test(n.tagName));
        if (box) {
          const stray = [...cellNow.childNodes].filter((n) => n !== box && loose(n));
          stray.reverse().forEach((n) => box.insertBefore(n, box.firstChild));
        }
      }
      unglue(ceOf(sel.anchorNode) || where);
      caret = sel.rangeCount ? sel.getRangeAt(0).cloneRange() : caret;
      sync();
      return true;
    }

    const ceOf = (n) => (n?.nodeType === 1 ? n : n?.parentElement)?.closest?.('.ce') || null;
    const activeText = () => {
      const a = document.activeElement;
      if (a?.classList?.contains('ce')) return a;
      // Inside a table the host is the table itself, so read the cell from the
      // selection, falling back to the caret remembered before the toolbar stole focus.
      const live = ceOf(getSelection().anchorNode);
      if (live) return live;
      const saved = caret && ceOf(caret.startContainer);
      if (saved?.isConnected) return saved;
      return focused?.isConnected ? focused : null;
    };

    /* ---------- controls ---------- */
    function controls(node, extra = []) {
      const c = el('div', 'ctl');
      const add = (label, title, fn) => {
        const b = el('button', null, label); b.type = 'button'; b.title = title;
        b.onmousedown = (e) => e.preventDefault();
        b.onclick = () => { fn(); sync(); };
        c.append(b);
      };
      for (const [label, title, fn] of extra) add(label, title, fn);
      add('↑', 'Move up', () => node.previousElementSibling?.before(node));
      add('↓', 'Move down', () => node.nextElementSibling?.after(node));
      add('✕', 'Remove', () => node.remove());
      return c;
    }

    /* ---------- infobox ---------- */
    const ib = $('#ib');

    function ibRow(r = {}) {
      const kind = r.pair ? 'pair'
        : r.office != null ? 'office'
        : r.section != null ? 'section'
        // Both shapes of a picture row: one picture, or the list of two.
        : (r.image != null || r.images) ? 'image'
        : r.label == null ? 'full' : 'row';
      const tr = el('tr', kind === 'section' ? 'ib-section' : kind === 'pair' ? 'ib-pair'
        : kind === 'office' ? 'ib-office' : null);
      tr.dataset.kind = kind;

      if (kind === 'section') {
        const td = el('td'); td.colSpan = 2;
        const c = controls(tr);
        c.prepend(ibAddMenu(tr));
        td.append(editable(esc(r.section || ''), 'Heading', lineBreak), c);
        tr.append(td);
      } else if (kind === 'image') {
        const td = el('td', 'ib-media'); td.colSpan = 2;

        /** One picture slot: the picture, its caption, and the button that changes it. */
        const slot = (d = {}) => {
          const box = el('div', 'ib-slot');
          const img = el('img'); img.alt = '';
          // Same as a picture in the article: the path is what the Media panel fills
          // in, never something typed, so it stays out of the way.
          const src = el('input', 'path'); src.value = d.src || '';
          src.tabIndex = -1;
          const choose = (e) => { e.stopPropagation(); openFor(src); };
          const empty = el('button', 'fig-empty', 'No picture'); empty.type = 'button';
          empty.onclick = choose;
          const paint = () => {
            if (src.value) { img.src = srcFor(src.value); img.hidden = false; } else img.hidden = true;
            empty.hidden = !!src.value;
          };
          img.onerror = () => { img.hidden = true; };
          src.oninput = (e) => { paint(); sync(e); };
          paint();
          const tools = el('div', 'fig-tools');
          const swap = el('button', null, '⇄'); swap.type = 'button'; swap.title = 'Change this picture';
          swap.onmousedown = (e) => e.preventDefault();
          swap.onclick = choose;
          tools.append(swap);
          // mdToHtml, not esc: a caption is read back with htmlToMd like every other
          // box here, so writing it as plain text turned an arrow into the words ":up".
          box.append(img, empty, src, editable(mdToHtml(d.caption || ''), 'Caption', lineBreak), tools);
          return box;
        };

        // One picture, or two side by side. A sidebar column is narrow, so two is
        // as many as will read.
        const held = r.images?.length ? r.images.slice(0, 2) : [{ src: r.image || '', caption: r.caption || '' }];
        held.forEach((d) => td.append(slot(d)));
        td.dataset.slots = held.length;
        const c = controls(tr);
        c.prepend(ibAddMenu(tr));
        td.append(c);
        tr.append(td);
      } else if (kind === 'pair') {
        // Two lists side by side, as the belligerents of a war. One item per line.
        const c = controls(tr);
        c.prepend(ibAddMenu(tr));
        (r.pair.length ? r.pair : [{}, {}]).slice(0, 2).forEach((col, i) => {
          const td = el('td');
          td.append(editable(mdToHtml(col.heading || ''), 'Side', lineBreak));
          td.firstChild.classList.add('pair-head');
          td.append(editable((col.items || []).map(mdToHtml).join('<br>'), 'One per line', lineBreak));
          if (i === 1) td.append(c);
          tr.append(td);
        });
      } else if (kind === 'office') {
        // An office and the term served in it. Two rows read as two separate things,
        // so this is one row holding both, the way the old documents had it.
        const td = el('td'); td.colSpan = 2;
        const c = controls(tr);
        c.prepend(ibAddMenu(tr));
        const post = editable(mdToHtml(r.office || ''), 'Office', lineBreak);
        const term = editable(mdToHtml(r.term || ''), 'Term', lineBreak);
        // Named so the band is set the same here as on the page: the editor shows
        // the row, not a pair of boxes standing in for it.
        post.classList.add('off-post');
        term.classList.add('off-term');
        td.append(post, term, c);
        tr.append(td);
      } else if (kind === 'full') {
        // A value with no field name, spanning both columns, as a casualty total.
        const td = el('td', 'ib-full'); td.colSpan = 2;
        const c = controls(tr);
        c.prepend(ibAddMenu(tr));
        const lines = Array.isArray(r.value) ? r.value : (r.value ? [r.value] : []);
        td.append(editable(lines.map(mdToHtml).join('<br>'), 'Full-width value', lineBreak), c);
        tr.append(td);
      } else {
        const th = el('th'); if (r.sub) th.className = 'sub';
        th.append(editable(mdToHtml(r.label || ''), 'Field', lineBreak));
        const td = el('td');
        const lines = Array.isArray(r.value) ? r.value : (r.value ? [r.value] : []);
        const c = controls(tr, [['⇥', 'Indent as a sub-field', () => th.classList.toggle('sub')]]);
        c.prepend(ibAddMenu(tr));
        td.append(editable(lines.map(mdToHtml).join('<br>'), 'Value', lineBreak), c);
        tr.append(th, td);
      }
      return tr;
    }

    const setInfobox = (rows) => {
      [...ib.querySelectorAll('tr[data-kind]')].forEach((r) => r.remove());
      rows.forEach((r) => ib.append(ibRow(r)));
    };

    function readInfobox() {
      return [...ib.querySelectorAll('tr[data-kind]')].map((tr) => {
        const ce = (sel) => tr.querySelector(sel);
        if (tr.dataset.kind === 'section') return { section: htmlToMd(ce('.ce')).trim() };
        if (tr.dataset.kind === 'office') {
          const [post, term] = tr.querySelectorAll('.ce');
          return { office: htmlToMd(post).trim(), term: htmlToMd(term).trim() };
        }
        if (tr.dataset.kind === 'image') {
          const slots = [...tr.querySelectorAll('.ib-slot')].map((b) => ({
            src: b.querySelector('input.path').value.trim(),
            caption: htmlToMd(b.querySelector('.ce')).trim(),
          }));
          // One picture writes the plain form it always had; two write a list.
          return slots.length > 1
            ? { images: slots }
            : { image: slots[0]?.src ?? '', caption: slots[0]?.caption ?? '' };
        }
        const asLines = (cell) => htmlToMd(cell, '\n').split('\n').map((x) => x.trim()).filter(Boolean);
        if (tr.dataset.kind === 'pair') {
          return { pair: [...tr.querySelectorAll('td')].map((td) => {
            const [head, items] = td.querySelectorAll('.ce');
            return { heading: htmlToMd(head).trim(), items: asLines(items) };
          }) };
        }
        if (tr.dataset.kind === 'full') {
          const lines = asLines(ce('.ce'));
          return { value: lines.length > 1 ? lines : (lines[0] ?? '') };
        }
        const [labelCell, valueCell] = tr.querySelectorAll('.ce');
        const lines = htmlToMd(valueCell, '\n').split('\n').map((s) => s.trim()).filter(Boolean);
        const o = { label: htmlToMd(labelCell).trim(), value: lines.length > 1 ? lines : (lines[0] ?? '') };
        if (tr.querySelector('th')?.classList.contains('sub')) o.sub = true;
        return o;
      });
    }

    // The three rows every infobox is made of, then the two that answer a shape a
    // plain field cannot. A null is the line between the two groups.
    const SEEDS = [
      ['Heading', () => ({ section: '' })],
      ['Field', () => ({ label: '', value: '' })],
      ['Image', () => ({ image: '', caption: '' })],
      null,
      ['Full-Width Value', () => ({ value: '' })],
      ['Parallel Lists', () => ({ pair: [{ heading: '', items: [] }, { heading: '', items: [] }] })],
      ['Occupation', () => ({ office: '', term: '' })],
    ];

    /** The + on a row's controls, which adds the next row right below it. */
    function ibAddMenu(tr) {
      const wrap = el('div', 'ctl-add');
      const b = el('button', null, '+');
      b.type = 'button';
      b.title = 'Add a row below';
      const menu = el('div', 'drop-menu ctl-menu');
      menu.hidden = true;
      for (const entry of SEEDS) {
        if (!entry) { menu.append(el('div', 'menu-sep')); continue; }
        const [label, seed] = entry;
        const item = el('button', null, label);
        item.type = 'button';
        item.onmousedown = (e) => e.preventDefault();
        item.onclick = () => {
          menu.hidden = true;
          const row = ibRow(seed());
          tr.after(row);
          (row.querySelector('.ce') || row.querySelector('input'))?.focus();
          sync();
        };
        menu.append(item);
      }
      b.onmousedown = (e) => e.preventDefault();
      b.onclick = (e) => {
        e.stopPropagation();
        document.querySelectorAll('.drop-menu').forEach((m) => { if (m !== menu) m.hidden = true; });
        menu.hidden = !menu.hidden;
      };
      wrap.append(b, menu);
      return wrap;
    }

    $('#ib-first').onclick = () => {
      const row = ibRow({});
      ib.append(row);
      row.querySelector('.ce')?.focus();
      sync();
    };

    /* ---------- body blocks ---------- */
    const body = $('#body');
    const TEXT = { section: 'h2', subsection: 'h3', para: 'p', list: 'ul' };
    const LABEL = {
      section: 'Section', subsection: 'Subsection', para: 'Paragraph',
      list: 'List', image: 'Image', float: 'Floating image', grid: 'Image grid', table: 'Table',
    };

    function block(kind, data = {}) {
      const b = el('div', `blk blk-${kind}`);
      b.dataset.kind = kind;
      b.append(el('span', 'blk-tag', LABEL[kind] || kind));

      if (kind in TEXT) {
        if (kind === 'list') {
          // A list works as one does in Google Docs. Tab and Shift+Tab nest an item and
          // bring it back; Shift+Enter is a new line inside the item; Enter splits the
          // item at the caret, and on an empty item climbs out a level or, from the top,
          // out of the list. Backspace at an item's start climbs out a level or joins the
          // item above, and Delete at its end pulls the next one up.
          const ul = el('ul', 'ce-list');
          const levelOf = (li) => +li.dataset.level || 0;
          const boxOf = (li) => li.querySelector('.ce');
          /** No deeper than one below the item above, which is as far as markdown can
              nest, and the first item always at the top. */
          const tidy = () => {
            let prev = -1;
            for (const li of ul.children) {
              const n = Math.min(levelOf(li), prev + 1, 5);
              if (n > 0) li.dataset.level = n; else delete li.dataset.level;
              prev = n;
            }
          };
          const nest = (li, n) => { li.dataset.level = Math.max(0, n); tidy(); sync(); };
          /** The item out of the list and into a paragraph of its own, the list split
              around it: Enter on an empty item at the top level, or Backspace at the start
              of the first item, whose bullet comes off. */
          const unbullet = (li) => {
            const rest = [...ul.children].slice([...ul.children].indexOf(li) + 1);
            const para = block('para', { text: itemMd(boxOf(li)) });
            b.after(para);
            if (rest.length) {
              para.after(block('list', { items: rest.map((x) => itemMd(boxOf(x))), levels: rest.map(levelOf) }));
              rest.forEach((x) => x.remove());
            }
            li.remove();
            if (!ul.children.length) b.remove();
            landIn(para.querySelector('.ce'), false);
            sync();
          };
          /** Two items made one: the second's text on the end of the first, caret at the join. */
          const join = (a, c) => {
            const into = boxOf(a), from = boxOf(c);
            if (into.lastChild?.nodeName === 'BR') into.lastChild.remove();
            into.focus({ preventScroll: true });
            const at = document.createRange();
            at.selectNodeContents(into);
            at.collapse(false);
            while (from.firstChild) into.append(from.firstChild);
            c.remove();
            putRange(at);
            tidy();
            sync();
          };
          const item = (html, level = 0) => {
            const li = el('li');
            if (level > 0) li.dataset.level = level;
            const box = editable(html, 'List item', (d, e) => {
              if (e?.shiftKey) { lineBreak(); return; }
              if (!d.textContent.trim() && !d.querySelector('img')) {
                if (levelOf(li) > 0) nest(li, levelOf(li) - 1); else unbullet(li);
                return;
              }
              // What follows the caret goes down into a new item, as Enter splits a line.
              const s = getSelection();
              if (!s.isCollapsed) document.execCommand('delete');
              const tail = document.createRange();
              tail.selectNodeContents(d);
              tail.setStart(s.focusNode, s.focusOffset);
              const next = item('', levelOf(li));
              boxOf(next).append(tail.extractContents());
              li.after(next);
              landIn(boxOf(next), false);
              sync();
            });
            box.addEventListener('keydown', (e) => {
              if (e.isComposing || e.ctrlKey || e.metaKey || e.altKey) return;
              if (e.key === 'Tab') { e.preventDefault(); nest(li, levelOf(li) + (e.shiftKey ? -1 : 1)); return; }
              if (!getSelection().isCollapsed) return;
              if (e.key === 'Backspace' && caretEdges(box).atStart) {
                e.preventDefault();
                if (levelOf(li) > 0) nest(li, levelOf(li) - 1);
                else if (li.previousElementSibling) join(li.previousElementSibling, li);
                else unbullet(li);
              } else if (e.key === 'Delete' && li.nextElementSibling && caretEdges(box).atEnd) {
                e.preventDefault();
                join(li, li.nextElementSibling);
              }
            });
            li.append(box);
            // Its own remove button. The only one before this was the block's, out in
            // the gutter, so reaching for it took the whole list rather than the line.
            const x = el('button', 'li-x', '✕');
            x.type = 'button';
            x.title = 'Remove this item';
            x.onmousedown = (e) => e.preventDefault();
            x.onclick = () => {
              if (ul.children.length <= 1) b.remove(); else { li.remove(); tidy(); }
              sync();
            };
            li.append(x);
            return li;
          };
          (data.items?.length ? data.items : ['']).forEach((i, n) => ul.append(item(mdToHtml(i), data.levels?.[n] || 0)));
          tidy();
          b.append(ul);
        } else {
          const ph = kind === 'section' ? 'Section heading'
            : kind === 'subsection' ? 'Subsection heading' : 'Write here';
          b.append(editable(mdToHtml(data.text || ''), ph, () => {
            const n = block('para');
            b.after(n);
            n.querySelector('.ce').focus();
            sync();
          }));
        }
      } else if (kind === 'image') {
        b.append(figure(data));
      } else if (kind === 'grid') {
        const wrap = el('div', 'imgrid');
        const addOne = (d = {}) => {
          const f = figure(d, true);
          wrap.append(f);
          return f;
        };
        (data.items?.length ? data.items : [{}, {}]).forEach(addOne);
        const add = el('button', 'sub-add', '+ Image');
        add.type = 'button';
        add.onclick = (e) => {
          e.stopPropagation();          // or the document handler shuts the menu again
          const fresh = addOne();
          sync();
          openFor(fresh.querySelector('input.path'));
        };
        b.append(wrap, add);
      } else if (kind === 'float') {
        const f = figure(data, false);
        f.classList.add('float-edit', data.align === 'left' ? 'float-left' : 'float-right');
        f.style.width = `${data.width || 300}px`;
        const bar = el('div', 'float-bar');
        const side = el('button', null, data.align === 'left' ? '\u25e7 Left' : 'Right \u25e8');
        side.type = 'button';
        side.onclick = () => {
          const left = f.classList.toggle('float-left');
          f.classList.toggle('float-right', !left);
          side.textContent = left ? '\u25e7 Left' : 'Right \u25e8';
          sync();
        };
        const size = el('span', 'float-size');
        const showSize = () => { size.textContent = `${Math.round(parseFloat(f.style.width))}px`; };
        showSize();
        bar.append(side, size);
        bar.onmousedown = (e) => e.preventDefault();   // flipping the side keeps the caret
        // Drag the edge to size it, the way a word processor does.
        const grip = el('div', 'float-grip');
        grip.title = 'Drag to resize';
        grip.onmousedown = (e) => {
          e.preventDefault();
          const x0 = e.clientX, w0 = parseFloat(f.style.width);
          const dir = f.classList.contains('float-left') ? 1 : -1;
          const move = (ev) => {
            const w = Math.max(120, Math.min(720, w0 + dir * (ev.clientX - x0)));
            f.style.width = `${Math.round(w)}px`;
            showSize();
          };
          const up = () => {
            removeEventListener('mousemove', move);
            removeEventListener('mouseup', up);
            sync();
          };
          addEventListener('mousemove', move);
          addEventListener('mouseup', up);
        };
        f.append(grip, bar);
        b.append(f);
      } else if (kind === 'table') {
        // The picker gives a size; a loaded article gives the cells themselves.
        const seed = data.rows?.length ? data.rows
          : data.cols ? Array.from({ length: data.rows || 2 },
              (_, r) => Array.from({ length: data.cols }, () => r === 0 ? 'Column' : ''))
          : null;
        b.append(tableEditor(seed));
        if (data.sortable) {
          b.dataset.sortable = '';
          b.querySelector('.blk-tag').textContent = 'Data table';
        }
      }

      const ctl = controls(b);
      if (kind === 'float') b.querySelector('figure').append(ctl);
      else b.append(ctl);
      return b;
    }

    // The three shapes a picture can take, in the order the button walks them.
    const LAYOUTS = ['image', 'float', 'grid'];
    const LAYOUT_GLYPH = { image: '\u25AD', float: '\u25E7', grid: '\u25A6' };
    const LAYOUT_NAME = { image: 'static', float: 'floating', grid: 'grid' };

    /** Rebuild this picture's block as the next shape, keeping what it holds. */
    function cycleLayout(fig) {
      const blk = fig.closest('.blk');
      if (!blk || !LAYOUTS.includes(blk.dataset.kind)) return;
      const to = LAYOUTS[(LAYOUTS.indexOf(blk.dataset.kind) + 1) % LAYOUTS.length];
      const held = [...blk.querySelectorAll('figure')].map((x) => ({
        src: x.querySelector('input.path')?.value.trim() || '',
        caption: htmlToMd(x.querySelector('.cap')).trim(),
      }));
      // A grid holds several pictures; leaving it gives each one a block of its own
      // rather than quietly dropping all but the first.
      const made = to === 'grid'
        ? [block('grid', { items: held })]
        : held.map((h) => block(to, to === 'float' ? { ...h, align: 'right', width: 320 } : h));
      blk.replaceWith(...made);
      const tools = made[0]?.querySelector('.fig-tools');
      if (tools) {
        tools.classList.add('stay');
        addEventListener('mousemove', () => tools.classList.remove('stay'), { once: true });
      }
      made[0]?.querySelector('.cap')?.focus();
      sync();
      flash(`Now ${LAYOUT_NAME[to]}${made.length > 1 ? `, ${made.length} blocks` : ''}.`);
    }

    function figure(d = {}, removable = false) {
      const f = el('figure');
      if (d.ratio) f.classList.add(`r-${d.ratio}`);
      const img = el('img'); img.alt = '';
      // Nobody types a path any more; the Media panel fills it. The field stays
      // because it is what the panel aims at, and stays out of sight otherwise.
      const src = el('input', 'path'); src.value = d.src || '';
      src.tabIndex = -1;
      const choose = (e) => { e.stopPropagation(); openFor(src); };
      // Only until a picture is chosen: an empty figure has nothing to see or aim at.
      const empty = el('button', 'fig-empty', 'No picture'); empty.type = 'button';
      empty.onclick = choose;
      const paint = () => {
        if (src.value) { img.src = srcFor(src.value); img.hidden = false; } else img.hidden = true;
        empty.hidden = !!src.value;
      };
      img.onerror = () => { img.hidden = true; };
      // In a row of pictures each one grows by its own shape, which is what puts
      // them all on one height. The ratio is read off the picture itself.
      img.onload = () => {
        if (img.naturalHeight && f.closest('.imgrid')) {
          f.style.flex = (img.naturalWidth / img.naturalHeight).toFixed(3);
        }
      };
      src.oninput = (e) => { paint(); sync(e); };
      paint();
      const cap = editable(mdToHtml(d.caption || ''), 'Caption', lineBreak);
      cap.classList.add('cap');
      // Change and remove sit together in the corner, out of the picture's way.
      const tools = el('div', 'fig-tools');
      // Leftmost: what shape the picture takes. Painted once it is in the document,
      // since a figure does not know which kind of block it belongs to until then.
      const lay = el('button', 'fig-layout', '');
      lay.type = 'button';
      lay.onmousedown = (e) => e.preventDefault();
      lay.onclick = (e) => { e.stopPropagation(); cycleLayout(f); };
      // A timer, not an animation frame: a frame never comes while the tab is in the
      // background, and a picture added there would keep a blank, hidden button forever.
      setTimeout(() => {
        const kind = f.closest('.blk')?.dataset.kind;
        if (!LAYOUTS.includes(kind)) { lay.hidden = true; return; }
        const next = LAYOUTS[(LAYOUTS.indexOf(kind) + 1) % LAYOUTS.length];
        lay.textContent = LAYOUT_GLYPH[kind];
        lay.title = `Layout: ${LAYOUT_NAME[kind]}. Click for ${LAYOUT_NAME[next]}.`;
      });
      const swap = el('button', null, '⇄'); swap.type = 'button'; swap.title = 'Change this picture';
      swap.onmousedown = (e) => e.preventDefault();
      swap.onclick = choose;
      tools.append(lay, swap);
      if (removable) {
        const x = el('button', null, '✕'); x.type = 'button'; x.title = 'Remove this picture';
        x.onmousedown = (e) => e.preventDefault();
        x.onclick = () => { f.remove(); sync(); };
        tools.append(x);
      }
      f.append(img, empty, src, cap, tools);
      return f;
    }

    /** A cell is a string, or an object once it carries a span or is a header. */
    const cellText = (c) => (typeof c === 'string' ? c : c?.text ?? '');
    const cellSpan = (c, k) => (typeof c === 'string' ? 1 : Math.max(1, c?.[k] ?? 1));
    const cellHead = (c, r) => (typeof c === 'string' ? r === 0 : !!c?.head);

    /**
     * Where every cell sits once spans are accounted for. grid[r][c] is the element
     * covering that square, so a cell with rowspan 4 appears at four rows.
     */
    function tableGrid(tbody) {
      const grid = [];
      [...tbody.rows].forEach((tr, r) => {
        grid[r] ??= [];
        let c = 0;
        for (const td of [...tr.children]) {
          while (grid[r][c]) c++;
          for (let i = 0; i < (td.rowSpan || 1); i++) {
            grid[r + i] ??= [];
            for (let j = 0; j < (td.colSpan || 1); j++) grid[r + i][c + j] = td;
          }
          c += td.colSpan || 1;
        }
      });
      return grid;
    }

/**
 * A cell's text, wherever in the cell it ended up. Each cell holds an editable box,
 * but the caret can land in the cell itself, and anything typed there sat outside the
 * box where the serializer never looked: the rows showed on screen and saved blank.
 */
    function cellMd(c) {
      let out = '';
      for (const n of c.childNodes) {
        if (n.nodeType === 3) { out += n.nodeValue; continue; }
        if (n.nodeType !== 1) continue;
        out += n.classList.contains('ce') ? htmlToMd(n, '<br>') : htmlToMd({ childNodes: [n] }, '<br>');
      }
      // A cell whose last letter is deleted is left holding one <br>, which is how the
      // browser keeps an empty line open. That is a blank cell, and is saved as one.
      out = out.trim();
      return out === '<br>' ? '' : out;
    }

    /* ---------- the caret, between boxes ----------
       Each paragraph, heading and list item is an editing box of its own, and a browser
       will not carry the caret out of one box into the next. The arrow keys do it here,
       so the body reads as one document, as in Google Docs: Up and Down at a box's first
       or last line, Left and Right at its very start or end. A table steers itself and
       hands over at its edges. */
    function putRange(r) { const s = getSelection(); s.removeAllRanges(); s.addRange(r); }
    /**
     * Whether anything of the box lies before the caret, or after it. A line break or a
     * picture counts as well as a letter; the one <br> a browser leaves at the end of a
     * box to hold an empty last line open does not, because nothing shows for it.
     */
    function caretEdges(box) {
      const s = getSelection();
      const some = (r, tail) => {
        const f = r.cloneContents();
        if (tail && f.lastChild?.nodeName === 'BR') f.lastChild.remove();
        return !!(f.textContent || f.querySelector('br, img'));
      };
      const before = document.createRange(), after = document.createRange();
      before.selectNodeContents(box); before.setEnd(s.focusNode, s.focusOffset);
      after.selectNodeContents(box); after.setStart(s.focusNode, s.focusOffset);
      return { atStart: !some(before, false), atEnd: !some(after, true) };
    }
    /** Where the caret stands across the page, for keeping to a column line to line. */
    function caretLeft(box) {
      const r = getSelection().getRangeAt(0).getBoundingClientRect();
      return r.left || r.width ? r.left : box.getBoundingClientRect().left + 1;
    }
    /** How far into the box the caret is, line breaks counted. One place in a page can
        be written two ways (after a word, or after the element holding it), and this
        reads both the same, which comparing them raw does not. */
    function caretOffset(box) {
      const s = getSelection();
      const r = document.createRange();
      r.selectNodeContents(box);
      r.setEnd(s.focusNode, s.focusOffset);
      return r.toString().length + r.cloneContents().querySelectorAll('br').length;
    }
    /** How far down the page the caret's line is, or null where the browser gives it no
        box. Where it sits between elements, the line of the one beside it is used. */
    function caretY() {
      const r = getSelection().getRangeAt(0);
      let rect = r.getClientRects()[0];
      if (!rect && r.startContainer.nodeType === 1) {
        const before = r.startContainer.childNodes[r.startOffset - 1];
        const n = before || r.startContainer.childNodes[r.startOffset];
        if (n) {
          const around = document.createRange();
          around.selectNode(n);
          rect = [...around.getClientRects()].at(before ? -1 : 0);
        }
      }
      return rect && rect.height ? rect.top + rect.height / 2 : null;
    }
    /**
     * Up or down a line inside the box, as the arrow keys move; false when the caret is
     * already on its first or last line. On a Mac, Up on the first line runs the caret to
     * the start of it rather than refusing, so a move counts only if the line changed.
     */
    function lineWithin(box, back) {
      const s = getSelection();
      const was = s.getRangeAt(0).cloneRange(), from = caretOffset(box), y0 = caretY();
      s.modify('move', back ? 'backward' : 'forward', 'line');
      const y1 = caretY();
      const changed = y0 != null && y1 != null ? Math.abs(y1 - y0) > 2 : caretOffset(box) !== from;
      if (box.contains(s.focusNode) && changed) return true;
      putRange(was);
      return false;
    }
    /**
     * The caret into a box: at its end or its start, or given a point across, as near to
     * it as it gets on the box's last line or first. A box in a table means the table's
     * bottom or top row, in the cell under that point.
     */
    function landIn(box, end, x = null) {
      let target = box;
      const table = box.closest('.ed-tbl');
      if (table && x != null) {
        const rows = table.tBodies[0].rows;
        const cells = [...(end ? rows[rows.length - 1] : rows[0]).children];
        const td = cells.find((c) => { const b = c.getBoundingClientRect(); return x >= b.left && x < b.right; }) || cells[0];
        if (td) target = td.querySelector('.ce');
      }
      (table || target).focus({ preventScroll: true });
      target.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      if (x != null) {
        const b = target.getBoundingClientRect();
        const hit = document.caretRangeFromPoint?.(
          Math.min(Math.max(x, b.left + 1), b.right - 1), end ? b.bottom - 3 : b.top + 3);
        if (hit && target.contains(hit.startContainer)) { putRange(hit); return; }
      }
      const r = document.createRange();
      r.selectNodeContents(target);
      r.collapse(!end);
      putRange(r);
    }
    body.addEventListener('keydown', (e) => {
      const step = { ArrowUp: -1, ArrowDown: 1, ArrowLeft: -1, ArrowRight: 1 }[e.key];
      if (!step || e.defaultPrevented || e.shiftKey || e.altKey || e.ctrlKey || e.metaKey || e.isComposing) return;
      const box = e.target.closest?.('.ce');
      if (!box || box.closest('.ed-tbl') || !getSelection().rangeCount) return;
      const vertical = e.key === 'ArrowUp' || e.key === 'ArrowDown';
      const x = vertical ? caretLeft(box) : null;
      if (vertical) {
        e.preventDefault();
        if (lineWithin(box, step < 0)) return;
      } else {
        if (!getSelection().isCollapsed) return;
        const edge = caretEdges(box);
        if (step < 0 ? !edge.atStart : !edge.atEnd) return;
        e.preventDefault();
      }
      const stops = [...body.querySelectorAll('.ce')];
      const next = stops[stops.indexOf(box) + step];
      if (next) landIn(next, step < 0, x);
    });
    /** A list item's text as saved: a line break inside it kept as <br>, and the one a
        browser leaves at the end to hold an empty line open dropped. */
    const itemMd = (box) => htmlToMd(box, '<br>').replace(/(\s*<br>\s*)+$/, '').trim();

    /**
     * A table, edited the way Google Docs edits one. Tab and Shift+Tab walk the cells,
     * and Tab past the last adds a row. The arrow keys move through a cell's text and
     * on into the next cell at its edge. Dragging across cells, or Shift with a click or
     * an arrow key at a cell's edge, selects whole cells. Rows, columns, merging and the
     * header band are on the right-click menu. The whole table is one editing host, so a
     * selection can run across cells and copy as a grid; each cell's text lives in its
     * .ce box, which is what is saved.
     */
    function tableEditor(rows) {
      const wrap = el('div', 'tbl-wrap');
      const table = el('table', 'ed-tbl');
      table.contentEditable = 'true';
      table.spellcheck = false;
      table.addEventListener('input', sync);
      const tbody = el('tbody');
      table.append(tbody);

      const cell = (tag, html, colspan = 1, rowspan = 1) => {
        const c = el(tag);
        if (colspan > 1) c.colSpan = colspan;
        if (rowspan > 1) c.rowSpan = rowspan;
        const inner = el('div', 'ce');
        inner.innerHTML = html || '';
        c.append(inner);
        return c;
      };
      const boxOf = (td) => td.querySelector('.ce');

      /* ---------- the grid ---------- */
      const grid = () => tableGrid(tbody);
      const width = () => grid().reduce((w, r) => Math.max(w, r.length), 0);
      /** Where every cell sits: its first row and column and its last, in reading order. */
      const spots = (g = grid()) => {
        const m = new Map();
        g.forEach((row, r) => row.forEach((td, c) => {
          if (!td) return;
          const s = m.get(td);
          if (!s) m.set(td, { r, c, r2: r, c2: c });
          else { s.r2 = Math.max(s.r2, r); s.c2 = Math.max(s.c2, c); }
        }));
        return m;
      };
      const order = () => [...spots().keys()];
      const cellOf = (n) => {
        const e = n?.nodeType === 1 ? n : n?.parentElement;
        const td = e?.closest?.('td, th');
        return td && tbody.contains(td) ? td : null;
      };

      /* ---------- the caret ---------- */
      /**
       * The caret into a cell, at its end or its start. Given a point across, it lands as
       * near to it as it can on the cell's last line or first, which is where Up and Down
       * leave it in running text.
       */
      const enter = (td, end, x = null) => {
        const box = boxOf(td);
        if (document.activeElement !== table) table.focus({ preventScroll: true });
        td.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        if (x != null) {
          const b = box.getBoundingClientRect();
          const hit = document.caretRangeFromPoint?.(
            Math.min(Math.max(x, b.left + 1), b.right - 1), end ? b.bottom - 3 : b.top + 3);
          if (hit && box.contains(hit.startContainer)) { putRange(hit); return; }
        }
        const r = document.createRange();
        r.selectNodeContents(box);
        r.collapse(!end);
        putRange(r);
      };
      /** The cell a row up or down from this one, under the given point across. */
      const verticalFrom = (td, down, x) => {
        const g = grid(), at = spots(g).get(td);
        const row = g[down ? at.r2 + 1 : at.r - 1];
        if (!row) return null;
        const cells = [...new Set(row)].filter(Boolean);
        return cells.find((c) => { const b = c.getBoundingClientRect(); return x >= b.left && x < b.right; })
          || row[Math.min(at.c, row.length - 1)];
      };
      /** Out of the table, into the block above or below; one below is made if none. */
      const leave = (down) => {
        const blk = wrap.closest('[data-kind]');
        let next = down ? blk.nextElementSibling : blk.previousElementSibling;
        if (!next && down) { next = block('para'); blk.after(next); sync(); }
        const boxes = next ? [...next.querySelectorAll('.ce')] : [];
        const box = down ? boxes[0] : boxes.at(-1);
        if (!box) return;
        box.closest('[contenteditable="true"]')?.focus({ preventScroll: true });
        const r = document.createRange();
        r.selectNodeContents(box);
        r.collapse(down);
        putRange(r);
        box.scrollIntoView({ block: 'nearest' });
      };

      /* ---------- whole cells selected ---------- */
      let span = null;               // { a, b }: the cell it began in and the one it reaches
      /** The rectangle between two cells, grown over any merged cell it would cut. */
      const rect = (a, b, sp = spots()) => {
        const p = sp.get(a), q = sp.get(b);
        let r1 = Math.min(p.r, q.r), c1 = Math.min(p.c, q.c);
        let r2 = Math.max(p.r2, q.r2), c2 = Math.max(p.c2, q.c2);
        for (let grew = true; grew;) {
          grew = false;
          for (const s of sp.values()) {
            if (s.r > r2 || s.r2 < r1 || s.c > c2 || s.c2 < c1) continue;
            if (s.r < r1) { r1 = s.r; grew = true; }
            if (s.r2 > r2) { r2 = s.r2; grew = true; }
            if (s.c < c1) { c1 = s.c; grew = true; }
            if (s.c2 > c2) { c2 = s.c2; grew = true; }
          }
        }
        return { r1, c1, r2, c2 };
      };
      const inside = (box, sp = spots()) => [...sp]
        .filter(([, s]) => s.r >= box.r1 && s.r2 <= box.r2 && s.c >= box.c1 && s.c2 <= box.c2)
        .map(([td]) => td);
      const picked = () => (span ? inside(rect(span.a, span.b)) : []);
      const paint = () => {
        const on = new Set(picked());
        for (const td of tbody.querySelectorAll('td, th')) td.classList.toggle('cell-sel', on.has(td));
        table.classList.toggle('cell-mode', on.size > 1);
      };
      const spanTo = (a, b) => { span = a && b && a !== b ? { a, b } : null; paint(); };
      const drop = () => { if (span) spanTo(null); };

      let pressed = null;
      table.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        const td = cellOf(e.target);
        if (!td) return;
        // Shift-click reaches from where the caret is, as dragging does.
        const from = span?.a || cellOf(getSelection().anchorNode);
        if (e.shiftKey && from && from !== td) { e.preventDefault(); spanTo(from, td); return; }
        drop();
        pressed = td;
      });
      table.addEventListener('mouseover', (e) => {
        if (!pressed || !(e.buttons & 1)) return;
        const td = cellOf(e.target);
        if (td) spanTo(pressed, td);
      });

      /* ---------- rows and columns ---------- */
      /** A new row at `at`: a cell per column, except where a merged cell runs across
          the gap, which grows over the new row instead. */
      const addRowAt = (at) => {
        const g = grid(), w = width(), tr = el('tr'), grown = new Set();
        for (let c = 0; c < w; c++) {
          const above = g[at - 1]?.[c], below = g[at]?.[c];
          if (above && above === below) {
            if (!grown.has(above)) { above.rowSpan += 1; grown.add(above); }
            continue;
          }
          tr.append(cell('td', ''));
        }
        tbody.insertBefore(tr, tbody.rows[at] || null);
      };
      /** A new column at `at`, the same way across. A row holds only the cells that
          begin in it, so the new one goes before the first of those beyond the gap. */
      const addColAt = (at) => {
        const g = grid(), sp = spots(g), grown = new Set();
        [...tbody.rows].forEach((tr, r) => {
          const left = g[r]?.[at - 1], right = g[r]?.[at];
          if (left && left === right) {
            if (!grown.has(left)) { left.colSpan += 1; grown.add(left); }
            return;
          }
          const fresh = cell((right || left)?.tagName === 'TH' ? 'th' : 'td', '');
          tr.insertBefore(fresh, [...tr.children].find((td) => sp.get(td).c >= at) || null);
        });
      };
      /** A row gone. A merged cell that begins in it moves down into the next row. */
      const deleteRow = (r) => {
        const g = grid(), sp = spots(g), tr = tbody.rows[r], next = tbody.rows[r + 1];
        for (const td of new Set(g[r])) {
          if (!td || td.rowSpan < 2) continue;
          td.rowSpan -= 1;
          const s = sp.get(td);
          if (s.r === r && next) next.insertBefore(td, [...next.children].find((x) => sp.get(x).c > s.c) || null);
        }
        tr.remove();
      };
      const deleteCol = (c) => {
        for (const td of new Set(grid().map((row) => row[c]))) {
          if (!td) continue;
          if (td.colSpan > 1) td.colSpan -= 1; else td.remove();
        }
      };
      const deleteTable = () => {
        const blk = wrap.closest('[data-kind]');
        const near = blk.previousElementSibling || blk.nextElementSibling;
        blk.remove();
        if (!body.children.length) body.append(block('para'));
        sync();
        const box = (near && near.isConnected ? near : body.firstElementChild).querySelector('.ce');
        if (box) {
          box.closest('[contenteditable="true"]')?.focus({ preventScroll: true });
          const r = document.createRange(); r.selectNodeContents(box); r.collapse(false); putRange(r);
        }
      };
      /** Into the cell at a spot once the table has changed, or the nearest one left. */
      const settle = (r, c) => {
        const g = grid();
        const row = g[Math.max(0, Math.min(r, g.length - 1))] || [];
        const td = row[Math.max(0, Math.min(c, row.length - 1))];
        if (td) enter(td, true);
      };

      /** Merged as the smallest rectangle covering the selection. Nothing written is
          thrown away: what the other cells held is carried over, a line each. */
      const merge = (box) => {
        const g = grid(), keep = g[box.r1][box.c1], gone = new Set();
        for (let r = box.r1; r <= box.r2; r++) {
          for (let c = box.c1; c <= box.c2; c++) {
            const td = g[r]?.[c];
            if (td && td !== keep) gone.add(td);
          }
        }
        const into = boxOf(keep);
        const blank = (h) => !h || h === '<br>';
        for (const td of gone) {
          const html = boxOf(td)?.innerHTML.trim();
          if (!blank(html)) into.innerHTML = blank(into.innerHTML.trim()) ? html : `${into.innerHTML}<br>${html}`;
          td.remove();
        }
        keep.colSpan = box.c2 - box.c1 + 1;
        keep.rowSpan = box.r2 - box.r1 + 1;
      };
      /** Each slot the merged cell covered gets a cell again, placed after the last cell
          of its row's own before the gap: shrinking the merged cell shifts the rest left,
          so the grid is read afresh for every one. */
      const unmerge = (cells) => {
        for (const keep of cells.filter((c) => c.colSpan > 1 || c.rowSpan > 1)) {
          const at = spots().get(keep), cs = keep.colSpan, rs = keep.rowSpan;
          const tag = keep.tagName.toLowerCase();
          keep.colSpan = 1; keep.rowSpan = 1;
          for (let r = at.r; r < at.r + rs; r++) {
            const tr = tbody.rows[r];
            if (!tr) continue;
            for (let c = at.c; c < at.c + cs; c++) {
              if (r === at.r && c === at.c) continue;
              const own = [...new Set(grid()[r]?.slice(0, c) || [])]
                .filter((x) => x && x.parentElement === tr).pop();
              const fresh = cell(tag, '');
              if (own) own.after(fresh); else tr.prepend(fresh);
            }
          }
        }
      };
      /** A header band can run to several rows, as a two-level column header does. */
      const setHead = (r1, r2, on) => {
        for (let r = r1; r <= r2; r++) {
          for (const td of [...tbody.rows[r].children]) {
            if ((td.tagName === 'TH') === on) continue;
            td.replaceWith(cell(on ? 'th' : 'td', boxOf(td)?.innerHTML || '', td.colSpan || 1, td.rowSpan || 1));
          }
        }
      };

      table.addEventListener('contextmenu', (e) => {
        const td = cellOf(e.target);
        if (!td) return;
        e.preventDefault();
        if (!picked().includes(td)) drop();
        const cells = span ? picked() : [td];
        const sp = spots();
        const box = cells.reduce((b, c) => {
          const s = sp.get(c);
          return { r1: Math.min(b.r1, s.r), c1: Math.min(b.c1, s.c), r2: Math.max(b.r2, s.r2), c2: Math.max(b.c2, s.c2) };
        }, { r1: Infinity, c1: Infinity, r2: -1, c2: -1 });
        const nr = box.r2 - box.r1 + 1, nc = box.c2 - box.c1 + 1;
        const head = cells.every((c) => c.tagName === 'TH');
        const act = (fn) => () => { drop(); fn(); sync(); };
        pointMenu([
          { label: 'Insert row above', run: act(() => { addRowAt(box.r1); settle(box.r1, box.c1); }) },
          { label: 'Insert row below', run: act(() => { addRowAt(box.r2 + 1); settle(box.r2 + 1, box.c1); }) },
          { label: 'Insert column left', run: act(() => { addColAt(box.c1); settle(box.r1, box.c1); }) },
          { label: 'Insert column right', run: act(() => { addColAt(box.c2 + 1); settle(box.r1, box.c2 + 1); }) },
          '-',
          { label: nr > 1 ? `Delete ${nr} rows` : 'Delete row', run: () => {
            drop();
            if (nr >= tbody.rows.length) { deleteTable(); return; }
            for (let r = box.r2; r >= box.r1; r--) deleteRow(r);
            sync(); settle(box.r1, box.c1);
          } },
          { label: nc > 1 ? `Delete ${nc} columns` : 'Delete column', run: () => {
            drop();
            if (nc >= width()) { deleteTable(); return; }
            for (let c = box.c2; c >= box.c1; c--) deleteCol(c);
            sync(); settle(box.r1, box.c1);
          } },
          { label: 'Delete table', run: () => { drop(); deleteTable(); } },
          '-',
          { label: 'Merge cells', off: cells.length < 2, run: act(() => { merge(box); settle(box.r1, box.c1); }) },
          { label: 'Unmerge cells', off: !cells.some((c) => c.colSpan > 1 || c.rowSpan > 1),
            run: act(() => { unmerge(cells); settle(box.r1, box.c1); }) },
          { label: head ? (nr > 1 ? 'Make body rows' : 'Make body row') : (nr > 1 ? 'Make header rows' : 'Make header row'),
            run: act(() => { setHead(box.r1, box.r2, !head); settle(box.r1, box.c1); }) },
        ], e.clientX, e.clientY);
      });

      /* ---------- keys ---------- */
      const MOVE = { ArrowUp: [-1, 0], ArrowDown: [1, 0], ArrowLeft: [0, -1], ArrowRight: [0, 1] };
      table.addEventListener('keydown', (e) => {
        if (e.isComposing) return;
        const s = getSelection();
        const td = cellOf(s.focusNode);
        if (!td || !s.rangeCount) return;
        const box = boxOf(td);
        const move = MOVE[e.key];
        const bare = !e.ctrlKey && !e.metaKey && !e.altKey;

        if (span && e.key === 'Tab') drop();          // Tab moves on from whole cells too
        if (span) {
          if (move && e.shiftKey && bare) {            // grow the selection a cell at a time
            e.preventDefault();
            const g = grid(), at = spots(g).get(span.b);
            const r = move[0] < 0 ? at.r - 1 : move[0] > 0 ? at.r2 + 1 : at.r;
            const c = move[1] < 0 ? at.c - 1 : move[1] > 0 ? at.c2 + 1 : at.c;
            if (g[r]?.[c]) spanTo(span.a, g[r][c]);
            return;
          }
          if (e.key === 'Backspace' || e.key === 'Delete' || (e.key.length === 1 && bare)) {
            // Deleting empties every selected cell; typing does too, and starts in the
            // first of them, as a spreadsheet does.
            e.preventDefault();
            const cells = picked();
            cells.forEach((c) => { boxOf(c).innerHTML = ''; });
            drop();
            enter(cells[0], false);
            if (e.key.length === 1) document.execCommand('insertText', false, e.key);
            else sync();
            return;
          }
          if (move || e.key === 'Escape') {
            e.preventDefault();
            const to = span.b;
            drop();
            enter(to, true);
          }
          return;
        }

        if (e.key === 'Enter') { e.preventDefault(); lineBreak(); return; }
        if (e.key === 'Tab' && bare) {
          e.preventDefault();
          const cells = order();
          const i = cells.indexOf(td) + (e.shiftKey ? -1 : 1);
          if (i < 0) return;
          if (i >= cells.length) { addRowAt(grid().length); sync(); }
          enter(order()[i], true);
          return;
        }
        if (e.key === 'Backspace' || e.key === 'Delete') {
          // At the edge of a cell there is nothing of this cell left to delete, and the
          // browser would start taking the table apart instead.
          if (s.isCollapsed && caretEdges(box)[e.key === 'Backspace' ? 'atStart' : 'atEnd']) e.preventDefault();
          return;
        }
        if (!move || !bare) return;

        const vertical = move[0] !== 0;
        const back = move[0] < 0 || move[1] < 0;
        const x = caretLeft(box);
        const beyond = () => {
          if (vertical) return verticalFrom(td, !back, x);
          const cells = order();
          return cells[cells.indexOf(td) + (back ? -1 : 1)];
        };

        if (e.shiftKey) {
          // Within the cell the selection grows as it always has; at its edge it takes
          // whole cells.
          const was = [s.anchorNode, s.anchorOffset, s.focusNode, s.focusOffset];
          s.modify('extend', back ? 'backward' : 'forward', vertical ? 'line' : 'character');
          const moved = !(s.focusNode === was[2] && s.focusOffset === was[3]);
          e.preventDefault();
          if (moved && box.contains(s.focusNode)) return;
          s.setBaseAndExtent(...was);
          const next = beyond();
          if (next) spanTo(cellOf(s.anchorNode) || td, next);
          return;
        }

        if (vertical) {
          e.preventDefault();
          if (lineWithin(box, back)) return;
          const next = beyond();
          if (next) enter(next, back, x); else leave(!back);
          return;
        }
        if (!s.isCollapsed) return;                   // the browser collapses a selection first
        const at = caretEdges(box);
        if (back ? !at.atStart : !at.atEnd) return;   // within the text: the browser's own move
        e.preventDefault();
        const next = beyond();
        if (next) enter(next, back); else leave(!back);
      });

      table.addEventListener('paste', (e) => {
        const dt = e.clipboardData;
        const text = dt.getData('text/plain');
        const html = dt.getData('text/html');
        const cellEl = span ? picked()[0] : cellOf(getSelection().anchorNode);
        e.preventDefault();
        if (cellEl && /[\t\n]/.test(text.trim())) { drop(); pasteGrid(cellEl, text); return; }
        if (html && /data-tok=|data-slug=/.test(html)) {
          document.execCommand('insertHTML', false, keepTokens(html));
          unglue(ceOf(getSelection().anchorNode));
          return;
        }
        document.execCommand('insertText', false, text);
      });
      // Put stray text back inside the cell's box once the caret has gone, when
      // moving a node can no longer drag the caret along with it.
      table.addEventListener('focusout', () => {
        let moved = false;
        for (const c of table.querySelectorAll('th, td')) {
          const box = boxOf(c);
          if (!box) continue;
          const before = [], after = [];
          let seen = false;
          for (const n of c.childNodes) {
            if (n === box) { seen = true; continue; }
            (seen ? after : before).push(n);
          }
          if (!before.length && !after.length) continue;
          before.reverse().forEach((n) => box.prepend(n));
          after.forEach((n) => box.append(n));
          moved = true;
        }
        if (moved) sync();
      });

      const addRow = (cells, headRow = false) => {
        const tr = el('tr');
        cells.forEach((v) => tr.append(cell(
          cellHead(v, headRow ? 0 : 1) ? 'th' : 'td',
          mdToHtml(cellText(v)), cellSpan(v, 'colspan'), cellSpan(v, 'rowspan'))));
        tbody.append(tr);
      };
      const seed = rows?.length ? rows : [['Column', 'Column'], ['', '']];
      seed.forEach((r, i) => addRow(r, i === 0));
      table._addRow = () => addRowAt(grid().length);
      table._addCol = () => addColAt(width());

      // Whole cells copy as tab-separated rows, so a table goes straight into a
      // spreadsheet; cutting them empties them.
      const tdText = (c) => htmlToMd(boxOf(c), ' ').replace(/\s+/g, ' ').trim();
      const asTsv = (cells) => {
        const sp = spots(), rowsOf = new Map();
        for (const c of cells) {
          const r = sp.get(c).r;
          if (!rowsOf.has(r)) rowsOf.set(r, []);
          rowsOf.get(r).push(c);
        }
        return [...rowsOf.keys()].sort((a, b) => a - b).map((r) => rowsOf.get(r).map(tdText).join('\t')).join('\n');
      };
      const onCopy = (e) => {
        const sel = getSelection();
        let cells = picked();
        if (!cells.length) {
          if (!sel.rangeCount || sel.isCollapsed) return;
          if (!table.contains(sel.anchorNode) || !table.contains(sel.focusNode)) return;
          if (cellOf(sel.anchorNode) === cellOf(sel.focusNode)) return;   // an ordinary copy within a cell
          cells = order().filter((c) => sel.containsNode(c, true));
        }
        if (!cells.length) return;
        e.preventDefault();
        e.clipboardData.setData('text/plain', asTsv(cells));
        if (e.type === 'cut') {
          cells.forEach((c) => { boxOf(c).innerHTML = ''; });
          drop();
          sync();
        }
      };
      table.addEventListener('copy', onCopy);
      table.addEventListener('cut', onCopy);

      wrap.append(table);
      return wrap;
    }

    /* ---------- a menu at the pointer, which is what right-click gives ---------- */
    const pointMenu = (() => {
      const m = el('div', 'drop-menu list point-menu');
      m.hidden = true;
      document.body.append(m);
      const close = () => { m.hidden = true; };
      addEventListener('mousedown', (e) => { if (!m.hidden && !m.contains(e.target)) close(); }, true);
      addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); }, true);
      addEventListener('scroll', (e) => { if (!m.contains(e.target)) close(); }, true);
      addEventListener('blur', close);
      return (items, x, y) => {
        m.innerHTML = '';
        for (const it of items) {
          if (it === '-') { m.append(el('div', 'menu-sep')); continue; }
          const b = el('button', null, it.label);
          b.type = 'button';
          b.disabled = !!it.off;
          b.onmousedown = (e) => e.preventDefault();      // the caret stays in the table
          b.onclick = () => { close(); it.run(); };
          m.append(b);
        }
        m.hidden = false;
        m.style.left = `${Math.max(8, Math.min(x, innerWidth - m.offsetWidth - 8))}px`;
        m.style.top = `${Math.max(8, Math.min(y, innerHeight - m.offsetHeight - 8))}px`;
      };
    })();


    function readBody() {
      return [...body.children].map((b) => {
        const kind = b.dataset.kind;
        const ratioOf = (f) => ([...f.classList].find((c) => /^r-/.test(c)) || '').replace(/^r-/, '');
        if (kind === 'image') {
          const f = b.querySelector('figure');
          return { kind, src: f.querySelector('input').value.trim(),
            caption: htmlToMd(f.querySelector('.cap')).trim(), ratio: ratioOf(f) };
        }
        if (kind === 'float') {
          const f = b.querySelector('figure');
          return {
            kind,
            src: f.querySelector('input').value.trim(),
            caption: htmlToMd(f.querySelector('.cap')).trim(),
            align: f.classList.contains('float-left') ? 'left' : 'right',
            width: Math.round(parseFloat(f.style.width) || 300),
            ratio: ratioOf(f),
          };
        }
        if (kind === 'grid') return {
          kind,
          items: [...b.querySelectorAll('figure')].map((f) => ({
            src: f.querySelector('input').value.trim(),
            caption: htmlToMd(f.querySelector('.cap')).trim(),
            flex: f.style.flex || '',
            ratio: ratioOf(f),
          })),
        };
        if (kind === 'table') return {
          kind,
          ...(b.hasAttribute('data-sortable') && { sortable: true }),
          rows: [...b.querySelectorAll('tbody tr')].map((tr, r) =>
            [...tr.children].map((c) => {
              const text = cellMd(c);
              const head = c.tagName === 'TH', cs = c.colSpan || 1, rs = c.rowSpan || 1;
              // A plain cell stays a plain string, so a table with no spans and one
              // header row serializes as the markdown table it has always been.
              return cs === 1 && rs === 1 && head === (r === 0)
                ? text : { text, ...(cs > 1 && { colspan: cs }), ...(rs > 1 && { rowspan: rs }), head };
            })),
        };
        if (kind === 'list') {
          const lis = [...b.querySelectorAll('li')];
          return {
            kind,
            // Every item, empty ones included: this is what undo restores, and dropping
            // them here made the history disagree with what is on screen.
            items: lis.map((li) => itemMd(li.querySelector('.ce'))),
            levels: lis.map((li) => +li.dataset.level || 0),
          };
        }
        return { kind, text: htmlToMd(b.querySelector('.ce')).trim() };
      });
    }

    /* ---------- insert, relative to where the cursor is ---------- */
    function insert(kind, data = {}) {
      const n = block(kind, data);
      const here = activeText()?.closest?.('.blk');
      // The caret may be in the sidebar, which is no place to hang an article block;
      // fall back to the last block of the body itself rather than to its end.
      const at = here?.parentElement === body ? here
        : lastBodyBlk?.isConnected && lastBodyBlk.parentElement === body ? lastBodyBlk : null;
      if (at) at.after(n);
      else body.append(n);
      (n.querySelector('.ce') || n.querySelector('input'))?.focus();
      sync();
    }

    /* ---------- serialize ---------- */
    function toMarkdown() {
      const v = (id) => $(id).value.trim();
      if (pageKind === 'navbox') return navboxYaml();
      const fm = [`title: ${q(v('#f-title'))}`];
      if (pageKind === 'portal') {
        fm.push(`nation: ${v('#f-nation')}`);
        if (v('#f-banner')) fm.push(`banner: ${v('#f-banner')}`);
        if (v('#f-welcome')) fm.push(`welcome: ${q(v('#f-welcome'))}`);
        const kept = portalBody.trim();
        return `---\n${fm.join('\n')}\n---\n${kept ? `\n${kept}\n` : ''}`;
      }
      // Only when it differs; a sidebar heading that repeats the title is the default.
      if (v('#f-boxtitle') && v('#f-boxtitle') !== v('#f-title')) {
        fm.push(`sidebarTitle: ${q(v('#f-boxtitle'))}`);
      }
      const natives = v('#f-native').split('\n').map((x) => x.trim()).filter(Boolean);
      if (natives.length === 1) fm.push(`nativeTitle: ${q(natives[0])}`);
      else if (natives.length) {
        fm.push('nativeTitle:');
        natives.forEach((n) => fm.push(`  - ${q(n)}`));
      }
      if (v('#f-romaji')) fm.push(`romaji: ${q(v('#f-romaji'))}`);
      fm.push(`type: ${v('#f-type')}`);
      if (v('#f-nation')) fm.push(`nation: ${v('#f-nation')}`);
      if (v('#f-icon')) fm.push(`icon: ${q(v('#f-icon'))}`);
      // A communal article credits its writers but carries a navbox of its own.
      const authors = v('#f-authors').split(',').map((a) => a.trim()).filter(Boolean);
      if (authors.length) fm.push(`authors: [${authors.join(', ')}]`);
      if (!$('#f-navbox-on').checked) fm.push('navbox: none');
      else if (!v('#f-nation')) fm.push('navbox: site');
      if (v('#f-coords')) fm.push(`coords: ${q(v('#f-coords'))}`);
      if ($('#f-ooc').checked) fm.push('ooc: true');

      // The type skeleton stays on screen to be filled in; only filled rows are written.
      const some = (v) => (Array.isArray(v) ? v.length : v !== '');
      const filled = readInfobox().filter((r) =>
        r.pair ? r.pair.some((c) => c.heading !== '' || c.items.length)
        : r.office != null ? r.office !== '' || r.term !== ''
        : r.section != null ? r.section !== ''
        : r.images ? r.images.some((i) => i.src)
        : r.image != null ? r.image !== ''
        : r.label == null ? some(r.value)
        : r.label !== '' && some(r.value));
      const rows = filled.filter((r, i) =>
        r.section == null || (filled[i + 1] && filled[i + 1].section == null));

      if (rows.length && $('#f-sidebar-on').checked) {
        fm.push('infobox:');
        for (const r of rows) {
          if (r.office != null) { fm.push(`  - { office: ${q(r.office)}, term: ${q(r.term)} }`); continue; }
          if (r.section != null) { fm.push(`  - { section: ${q(r.section)} }`); continue; }
          if (r.images) {
            // Only filled slots are written, and one of them is the plain single form,
            // or the file would change shape again the next time it was saved.
            const got = r.images.filter((i) => i.src);
            if (got.length > 1) {
              fm.push('  - images:');
              for (const im of got) fm.push(`      - { src: ${q(im.src)}, caption: ${q(im.caption)} }`);
            } else {
              const one = got[0] || { src: '', caption: '' };
              fm.push(`  - { image: ${q(one.src)}, caption: ${q(one.caption)} }`);
            }
            continue;
          }
          if (r.image != null) { fm.push(`  - { image: ${q(r.image)}, caption: ${q(r.caption)} }`); continue; }
          if (r.pair) {
            fm.push('  - pair:');
            for (const col of r.pair) {
              fm.push(`      - heading: ${q(col.heading)}`);
              fm.push('        items:');
              col.items.forEach((it) => fm.push(`          - ${q(it)}`));
            }
            continue;
          }
          if (r.label == null) {
            if (Array.isArray(r.value)) {
              fm.push('  - value:');
              r.value.forEach((l) => fm.push(`      - ${q(l)}`));
            } else fm.push(`  - { value: ${q(r.value)} }`);
            continue;
          }
          if (Array.isArray(r.value)) {
            fm.push(`  - label: ${q(r.label)}`);
            if (r.sub) fm.push('    sub: true');
            fm.push('    value:');
            r.value.forEach((l) => fm.push(`      - ${q(l)}`));
          } else {
            fm.push(`  - { label: ${q(r.label)}${r.sub ? ', sub: true' : ''}, value: ${q(r.value)} }`);
          }
        }
      }

      // Bold or italic that took a space along shows as bold here but prints its
      // asterisks on the page, so it is fixed in every copy written out.
      const md = `---\n${fm.join('\n')}\n---\n\n${bodyMarkdown()}\n`;
      return window.fixEmphasis ? window.fixEmphasis(md) : md;
    }

    /* ---------- navboxes ----------
       A navbox is the same tree the block editor already draws: a group is a heading,
       a row is a subheading, and the row's articles are a list. So it is edited with
       the blocks and controls everything else uses, and converted at the two ends. */

    /** The stored groups, as blocks. */
    function navboxBlocks(groups) {
      const out = [];
      for (const g of groups) {
        out.push({ kind: 'section', text: g.label || '' });
        for (const r of g.rows || []) {
          if (r.label != null) out.push({ kind: 'subsection', text: r.label });
          if (r.note != null) out.push({ kind: 'para', text: r.note });
          // A stored item is a slug, or "slug|Display"; either way it is a link here,
          // so it shows the article's real title and the link popover can edit it.
          if (r.items?.length) {
            out.push({
              kind: 'list',
              items: r.items.map((i) => (String(i).startsWith('[[') || String(i).startsWith('[')
                ? String(i) : `[[${i}]]`)),
            });
          }
        }
      }
      return out.length ? out : [{ kind: 'section', text: '' }];
    }

    /** Those blocks, back as the YAML file. */
    function navboxYaml() {
      const v = (id) => $(id).value.trim();
      const lines = [];
      if (v('#f-title')) lines.push(`title: ${q(v('#f-title'))}`);
      if (v('#f-crumb')) lines.push(`crumb: ${q(v('#f-crumb'))}`);
      const blocks = readBody().filter((b) => ['section', 'subsection', 'para', 'list'].includes(b.kind));
      if (!blocks.length) { lines.push('groups: []'); return navboxLead + lines.join('\n') + '\n'; }
      lines.push('groups:');

      let open = false;                       // a row is waiting for its items
      let group = false;                      // a group is open to hang rows on
      // Nothing may sit above the first heading, or the file it writes is not a navbox.
      const need = () => { if (!group) { lines.push('  - label: ""', '    rows:'); group = true; } };
      const openRow = (label) => { need(); lines.push(`      - label: ${q(label)}`); open = true; };

      for (const b of blocks) {
        if (b.kind === 'section') {
          lines.push(`  - label: ${q(b.text)}`, '    rows:');
          open = false; group = true;
        } else if (b.kind === 'subsection') {
          openRow(b.text);
        } else if (b.kind === 'para') {
          need();
          lines.push(`      - note: ${q(b.text)}`);
          open = false;
        } else if (b.kind === 'list') {
          need();
          // A list with no subheading over it is a row with items and no label.
          if (!open) lines.push('      - items:');
          else lines.push('        items:');
          for (const it of b.items.filter(Boolean)) {
            const m = it.match(/^\[\[([^\]|]+?)(?:\|([^\]]+?))?\]\]$/);
            lines.push(`          - ${q(m ? (m[2] ? `${m[1]}|${m[2]}` : m[1]) : it)}`);
          }
          open = false;
        }
      }
      return navboxLead + lines.join('\n') + '\n';
    }

    /** The blocks of the article body alone, as markdown. A portal page has the
        same body and none of the frontmatter, so both callers share this. */
    function bodyMarkdown() {
      const fig = (i) => {
        const alt = (i.caption || '').replace(/"/g, '&quot;');
        const style = i.flex ? ` style="flex:${parseFloat(i.flex).toFixed(3)}"` : '';
        const cls = i.ratio ? ` class="r-${i.ratio}"` : '';
        return `<figure${cls}${style}><img src="${i.src}" alt="${alt}"><figcaption>${i.caption}</figcaption></figure>`;
      };
      return readBody().map((b) => {
        if (b.kind === 'section') return '## ' + b.text;
        if (b.kind === 'subsection') return '### ' + b.text;
        if (b.kind === 'para') return b.text;
        if (b.kind === 'list') {
          // Two spaces deeper for each level, which markdown reads as the list below.
          return b.items.map((t, i) => [t, b.levels?.[i] || 0]).filter(([t]) => t)
            .map(([t, lv]) => '  '.repeat(lv) + '- ' + t).join('\n');
        }
        if (b.kind === 'image') return b.src ? fig(b) : '';
        if (b.kind === 'float') {
          if (!b.src) return '';
          const cls = `float float-${b.align === 'left' ? 'left' : 'right'}`
            + (b.ratio ? ` r-${b.ratio}` : '');
          const cap = b.caption ? `<figcaption>${b.caption}</figcaption>` : '<figcaption></figcaption>';
          return `<figure class="${cls}" style="width:${b.width || 300}px">`
            + `<img src="${b.src}" alt="${(b.caption || '').replace(/"/g, '&quot;')}">${cap}</figure>`;
        }
        if (b.kind === 'grid') {
          const items = b.items.filter((i) => i.src);
          return items.length ? '<div class="imgrid">\n' + items.map(fig).join('\n') + '\n</div>' : '';
        }
        if (b.kind === 'table') {
          const [head, ...rest] = b.rows;
          if (!head) return '';
          // Markdown tables cannot express a merged cell or a second header row, so a
          // table that carries either is written as HTML instead. Everything else keeps
          // the pipe form, which stays readable in a diff.
          // A pipe in a cell can be escaped for GFM, but not when it sits inside a
          // token: :img[path|96] would come back as :img[path\|96]. Those go to HTML too.
          if (!b.sortable && b.rows.every((r) => r.every((c) => typeof c === 'string' && !c.includes('|')))) {
            // A pipe inside a cell would split it, so it is escaped for GFM.
            const cell = (c) => String(c).replace(/\|/g, '\\|');
            return ['| ' + head.map(cell).join(' | ') + ' |', '| ' + head.map(() => '---').join(' | ') + ' |',
              ...rest.map((r) => '| ' + r.map(cell).join(' | ') + ' |')].join('\n');
          }
          // Cell text is left as written, exactly as a figure's caption is: it may
          // legitimately hold <br>, <sup> or a token, and escaping would print those.
          const td = (c, r) => {
            const text = typeof c === 'string' ? c : c.text ?? '';
            const head2 = typeof c === 'string' ? r === 0 : !!c.head;
            const cs = typeof c === 'string' ? 1 : c.colspan || 1;
            const rs = typeof c === 'string' ? 1 : c.rowspan || 1;
            const tag = head2 ? 'th' : 'td';
            return `<${tag}${cs > 1 ? ` colspan="${cs}"` : ''}${rs > 1 ? ` rowspan="${rs}"` : ''}>`
              + `${text}</${tag}>`;
          };
          return [b.sortable ? '<table class="sortable">' : '<table>',
            ...b.rows.map((r, i) => '<tr>' + r.map((c) => td(c, i)).join('') + '</tr>'),
            '</table>'].join('\n');
        }
        return '';
      }).filter(Boolean).join('\n\n');
    }

    /* ---------- parse an article body back into blocks ---------- */
    function parseBody(md) {
      const blocks = [];
      for (const chunk of md.trim().split(/\n{2,}/)) {
        const t = chunk.trim();
        if (!t) continue;
        if (t.startsWith('### ')) blocks.push({ kind: 'subsection', text: t.slice(4) });
        else if (t.startsWith('## ')) blocks.push({ kind: 'section', text: t.slice(3) });
        else if (t.startsWith('<div class="imgrid"')) {
          blocks.push({
            kind: 'grid',
            items: [...t.matchAll(/<figure([^>]*)><img src="([^"]*)"[^>]*>\s*<figcaption>([\s\S]*?)<\/figcaption>/g)]
              .map((m) => ({ src: m[2], caption: m[3],
                ratio: (m[1].match(/\br-(\S+?)(?=["\s])/) || [])[1] || '' })),
          });
        } else if (t.startsWith('<figure')) {
          const m = t.match(/<img src="([^"]*)"[^>]*>\s*<figcaption>([\s\S]*?)<\/figcaption>/);
          const cls = t.match(/^<figure[^>]*class="([^"]*)"/)?.[1] || '';
          const ratio = (cls.match(/\br-(\S+)/) || [])[1] || '';
          if (cls.includes('float')) {
            blocks.push({
              kind: 'float', src: m?.[1] || '', caption: m?.[2] || '',
              align: cls.includes('float-left') ? 'left' : 'right',
              width: parseInt(t.match(/width:\s*(\d+)px/)?.[1] || '300', 10),
              ratio,
            });
          } else {
            blocks.push({ kind: 'image', src: m?.[1] || '', caption: m?.[2] || '', ratio });
          }
        } else if (t.startsWith('<table')) {
          const doc = new DOMParser().parseFromString(t, 'text/html');
          blocks.push({
            kind: 'table',
            ...(doc.querySelector('table')?.classList.contains('sortable') && { sortable: true }),
            rows: [...doc.querySelectorAll('tr')].map((tr, r) =>
              [...tr.children].map((c) => {
                // The cell goes on as written text, the form a markdown table gives, so the
                // entities the parser wrote back are turned into their characters here.
                // Left in, & showed in the editor as &amp; and was saved that way.
                const text = c.innerHTML.trim().replace(/&lt;/g, '<').replace(/&gt;/g, '>')
                  .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&');
                const head = c.tagName === 'TH', cs = c.colSpan || 1, rs = c.rowSpan || 1;
                return cs === 1 && rs === 1 && head === (r === 0)
                  ? text : { text, ...(cs > 1 && { colspan: cs }), ...(rs > 1 && { rowspan: rs }), head };
              })),
          });
        } else if (/^\|/.test(t)) {
          blocks.push({
            kind: 'table',
            rows: t.split('\n').filter((l) => !/^\|[\s|:-]+\|$/.test(l)).map((l) =>
              l.replace(/^\||\|$/g, '').split(/(?<!\\)\|/).map((s) => s.trim().replace(/\\\|/g, '|'))),
          });
        } else if (t.split('\n').every((l) => /^ *- /.test(l))) {
          // An item two or four spaces deeper than the one above is one level below it.
          const stack = [], items = [], levels = [];
          for (const l of t.split('\n')) {
            const ind = l.length - l.trimStart().length;
            while (stack.length && stack[stack.length - 1] >= ind) stack.pop();
            levels.push(stack.length);
            stack.push(ind);
            items.push(l.trimStart().slice(2));
          }
          blocks.push({ kind: 'list', items, levels });
        } else blocks.push({ kind: 'para', text: t.replace(/\n/g, ' ') });
      }
      return blocks;
    }

    /* ---------- canvas mirrors the settings ---------- */
    function paintCanvas() {
      const t = $('#f-title').value.trim();
      // Never over the field somebody is typing in: these are edited in place now, and
      // rewriting one under the caret throws the cursor back to the start.
      const idle = (el) => document.activeElement !== el;
      // A sidebar heading nobody has set shows the article's title, greyed, which is
      // what the page will carry.
      $('#ib-title').dataset.ph = t || 'Article title';
      if (idle($('#ib-title'))) $('#ib-title').textContent = $('#f-boxtitle').value.trim();
      if (idle($('#ib-native'))) {
        $('#ib-native').innerHTML = $('#f-native').value.trim()
          .split('\n').map((n) => esc(n.trim())).filter(Boolean).join('<br>');
      }
      if (idle($('#ib-romaji'))) $('#ib-romaji').textContent = $('#f-romaji').value.trim();
      if ($('#canvas-title').textContent !== t && idle($('#canvas-title'))) {
        $('#canvas-title').textContent = t;
      }
      const nat = $('#f-nation');
      const name = nat.value ? nat.options[nat.selectedIndex].text : '';
      $('#canvas-by').innerHTML = name ? `By <a href="#">${esc(name)}</a>` : '';
      $('#ooc-note').hidden = !$('#f-ooc').checked;
    }

    /* ---------- draft survives a reload ---------- */
    const DRAFT = 'talopedia-draft';
    const fields = ['#f-title', '#f-boxtitle', '#f-native', '#f-romaji', '#f-type', '#f-nation', '#f-icon',
      '#f-authors', '#f-coords', '#f-banner', '#f-welcome', '#f-crumb'];
    const snapshot = () => ({
      meta: Object.fromEntries(fields.map((f) => [f, $(f).value])),
      ooc: $('#f-ooc').checked,
      navbox: $('#f-navbox-on').checked,
      sidebar: $('#f-sidebar-on').checked,
      slug: slugValue(),
      from: loadedFrom,
      // What is being edited, and the two things it holds that are never on screen.
      // Without these an undo, or the reload after a save, turns a portal into an article.
      kind: pageKind,
      portalBody,
      navboxLead,
      infobox: readInfobox(),
      blocks: readBody(),
    });

    function restore(d) {
      for (const [f, v] of Object.entries(d.meta || {})) if ($(f)) $(f).value = v;
      $('#f-ooc').checked = !!d.ooc;
      $('#f-navbox-on').checked = d.navbox !== false;
      $('#f-sidebar-on').checked = d.sidebar !== false;
      if (d.slug) { setSlug(d.slug); slugTouched = true; }
      if (d.from !== undefined) loadedFrom = d.from;
      pageKind = d.kind || 'article';
      portalBody = d.portalBody || '';
      navboxLead = d.navboxLead || '';
      setInfobox(d.infobox || []);
      body.innerHTML = '';
      (d.blocks || []).forEach((b) => body.append(block(b.kind, b)));
      if (!body.children.length && pageKind !== 'portal') body.append(block('para'));
      paintSettings();
    }

    let draftTimer;
    function stash() {
      clearTimeout(draftTimer);
      draftTimer = setTimeout(() => {
        try { sessionStorage.setItem(DRAFT, JSON.stringify(snapshot())); } catch {}
      }, 400);
    }

    const tocToggle = $('#ed-toc-toggle');
    tocToggle.onclick = () => {
      tocToggle.textContent = $('.ed-rail').classList.toggle('collapsed') ? 'show' : 'hide';
    };
    // A long contents list above the article is in the way on a phone.
    if (innerWidth <= 1000) { $('.ed-rail').classList.add('collapsed'); tocToggle.textContent = 'show'; }

    function paintToc() {
      const nav = $('#ed-toc');
      nav.innerHTML = '';
      const top = el('li', 'top');
      const a0 = el('a', null, '(Top)');
      a0.href = '#';
      a0.onclick = (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: 'smooth' }); };
      top.append(a0);
      nav.append(top);
      let sub = null;
      for (const b of body.children) {
        const kind = b.dataset.kind;
        if (kind !== 'section' && kind !== 'subsection') continue;
        const text = b.querySelector('.ce')?.textContent.trim();
        if (!text) continue;
        const li = el('li');
        const a = el('a', null, text);
        a.href = '#';
        a.onclick = (e) => {
          e.preventDefault();
          b.scrollIntoView({ block: 'center', behavior: 'smooth' });
          b.querySelector('.ce')?.focus();
        };
        li.append(a);
        if (kind === 'section') { nav.append(li); sub = null; }
        else {
          if (!sub) { sub = el('ul'); (nav.lastElementChild || nav).append(sub); }
          sub.append(li);
        }
      }
    }

    // Coordinates only mean something for a nation or a city.
    function paintSettings() {
      const t = $('#f-type').value;
      // A portal carries a banner and a welcome line and nothing else; a navbox carries
      // a title and a breadcrumb. Neither has a type, a byline, coordinates or an infobox.
      const art = pageKind === 'article', portal = pageKind === 'portal', nav = pageKind === 'navbox';
      for (const [id, on] of [
        ['#banner-field', portal], ['#welcome-field', portal], ['#crumb-field', nav],
        ['#type-field', art], ['#authors-field', art], ['#icon-field', art],
        ['#nation-field', !nav],
      ]) $(id).hidden = !on;
      // The byline says who may edit the page once it exists, so it stops being
      // editable once the page does. `authors` carries the byline when it is set and
      // `nation` carries it when it is not, so whichever one is holding it locks; a
      // nation that is only choosing the navbox stays free. The dev server is the way
      // back in, and a pull request that moves a byline is reviewed rather than merged.
      const settled = !DEV && ARTICLES.some((a) => a.slug === indexKey(pageKind, slugValue()));
      $('#f-authors').readOnly = settled;
      $('#f-authors').title = settled ? 'Set when the page was created.' : '';
      $('#f-nation').disabled = settled && !$('#f-authors').value.trim();
      $('#settings').querySelector('.set-toggles').hidden = !art;
      // Not every article wants a sidebar. The rows stay in the editor while it is
      // off, so turning it back on before saving brings them back untouched.
      const sidebar = $('#f-sidebar-on').checked;
      $('#sidebar-note').textContent = sidebar ? '' : 'none';
      document.querySelector('.ib-edit').hidden = !art || !sidebar;
      // Only the types that sit somewhere on the map.
      const PLACED = ['overview', 'city', 'subdivision', 'continent', 'geography'];
      $('#coords-field').hidden = !art || !PLACED.includes(t);
      // A portal has no body of its own to edit: the template is the page.
      $('#portal-note').hidden = !portal;
      body.hidden = portal;
      document.querySelector('.ed').dataset.kind = pageKind;
      if (portal) {
        const n = $('#f-nation').value;
        const named = n ? ($('#f-nation').selectedOptions[0]?.textContent || n) : 'this nation';
        $('#portal-overview').textContent = n
          ? `the overview article for ${named}.`
          : 'choose the nation in page settings first.';
        $('#go-navbox').disabled = !n;
      }
      // Where this page lives when it is not being edited. A navbox has no page of
      // its own, so the portal carrying it is the nearest thing to go back to.
      const to = !pageSlug ? ''
        : pageKind === 'article' ? (pageSlug === 'home' ? '/' : `/${pageSlug}`)
        : pageKind === 'navbox' && pageSlug === 'site' ? '/'
        : `/portal/${pageSlug}`;
      $('#back').dataset.to = to;
      $('#back').disabled = !to;

      $('#navbox-note').textContent = !$('#f-navbox-on').checked ? 'none'
        : $('#f-nation').value ? `${$('#f-nation').selectedOptions[0].textContent}'s navbox`
        : 'site navbox';
    }
    /* ---------- undo / redo ----------
       Modelled on Google Docs. A snapshot stack rather than execCommand('undo'),
       because adding or removing a block is not a text edit and the browser's own
       history does not see it. Typing is gathered a word at a time; everything else
       (a paste, bold, a new block, a moved row) is a step of its own; and undoing puts
       the caret back where the change was, so the writer can see what went.

       Each step keeps the whole page as it stood after it, and where the caret was
       when it began and when it ended. The history belongs to one page: opening,
       starting or duplicating another clears it, since undoing into the last page
       is how one article's text ends up under another's name. */
    const PAUSE = 1000;      // a stop this long in typing starts the next step
    const DEPTH = 200;
    const past = [], future = [];
    let quiet = false;       // true while a remembered state is being put back
    let run = null;          // the typing the newest step is still gathering
    let settling = true;     // just opened, and nobody has touched it yet

    function paintHistory() {
      $('#undo').disabled = past.length < 2;
      $('#redo').disabled = !future.length;
    }
    function resetHistory() {
      past.length = 0;
      future.length = 0;
      run = null;
      settling = true;
      paintHistory();
    }

    /** Typing and deleting gather into runs; anything else stands alone. */
    function editKind(e) {
      const t = e?.inputType || '';
      if (t === 'insertText' || t === 'insertCompositionText') return 'type';
      if (/^delete(Content|Word|SoftLine|HardLine)/.test(t)) return 'delete';
      return 'other';
    }

    /** Where the caret is, in terms that survive the page being rebuilt: which
        editable box, counted in page order, and how many characters into it. */
    function caretMark() {
      const sel = getSelection();
      if (!sel.rangeCount) return null;
      const n = sel.focusNode;
      const box = (n?.nodeType === 1 ? n : n?.parentElement)?.closest('[contenteditable="true"]');
      const i = box ? [...document.querySelectorAll('.ed-canvas [contenteditable="true"]')].indexOf(box) : -1;
      if (i < 0) return null;
      const r = document.createRange();
      r.selectNodeContents(box);
      r.setEnd(n, sel.focusOffset);
      const before = r.toString();
      return { i, at: before.length, prev: before.slice(-1) };
    }
    function placeCaret(mark) {
      if (!mark) return null;
      const box = document.querySelectorAll('.ed-canvas [contenteditable="true"]')[mark.i];
      if (!box) return null;
      const r = document.createRange();
      const walk = document.createTreeWalker(box, NodeFilter.SHOW_TEXT);
      let left = mark.at, node, placed = false;
      while ((node = walk.nextNode())) {
        if (left <= node.nodeValue.length) {
          // Never inside an arrow, a flag or a date: after it.
          const lock = node.parentElement.closest('[contenteditable="false"]');
          if (lock) r.setStartAfter(lock); else r.setStart(node, left);
          placed = true;
          break;
        }
        left -= node.nodeValue.length;
      }
      if (!placed) {
        // A space at the end of a line is trimmed from what is saved, so a step that
        // began just after one comes back without it. Put it back, or the next word
        // typed runs straight into the last.
        const t = box.textContent;
        if (t && mark.at === t.length + 1 && !/\s$/.test(t)) box.append('\u00a0');
        r.selectNodeContents(box);
        r.collapse(false);
      }
      r.collapse(true);
      box.focus({ preventScroll: true });
      const sel = getSelection();
      sel.removeAllRanges();
      sel.addRange(r);
      return r;
    }
    /** Bring the caret into view, but only if it is out of sight. */
    function reveal(r) {
      if (!r) return;
      let box = r.getBoundingClientRect();
      if (!box.height) {
        const n = r.startContainer;
        box = (n.nodeType === 1 ? n : n.parentElement).getBoundingClientRect();
      }
      const top = Math.max(0, $('.ed-tools').getBoundingClientRect().bottom) + 16;
      const bottom = innerHeight - 24;
      if (box.top >= top && box.bottom <= bottom) return;
      // A third of the way down rather than at an edge, so what surrounds it shows too.
      window.scrollBy(0, box.top - (top + (bottom - top) / 3));
    }

    function remember(e) {
      if (quiet) return;
      const kind = editKind(e);
      const mark = caretMark();
      const state = JSON.stringify(snapshot());
      const top = past[past.length - 1];
      const changed = !top || top.state !== state;
      const box = e?.target?.closest?.('[contenteditable="true"]') || e?.target || null;
      if (changed && settling && past.length === 1) {
        // A page that has just opened is still settling (link titles arriving, say)
        // until somebody touches it. That is the page as opened, not an edit to undo.
        top.state = state;
      } else if (changed) {
        const t = Date.now();
        const joins = run && !run.closed && kind !== 'other' && kind === run.kind
          && box === run.box && t - run.last < PAUSE;
        if (joins) {
          top.state = state;
          top.end = mark;
          run.last = t;
        } else {
          // Typing leaves the caret after what it typed; the step began before it.
          const back = kind === 'type' ? (e.data?.length ?? 1) : 0;
          const start = mark && { i: mark.i, at: Math.max(0, mark.at - back) };
          past.push({ state, start, end: mark });
          if (past.length > DEPTH) past.shift();
          run = kind === 'other' ? null : { kind, box, last: t, closed: false };
        }
        future.length = 0;
        paintHistory();
      } else if (run && kind === run.kind && box === run.box) {
        // Nothing saved changed (a space at the end of a line), but the step still
        // ends where the caret now is, so a redo puts the space back too.
        top.end = mark;
      }
      // A space ends the word before it, so the next letter starts a step of its own.
      // Checked even when nothing saved changed: a space at the end of a line is
      // trimmed from what is saved, so the page reads the same with it as without.
      if (run && kind === 'type' && /\s/.test(mark?.prev || '')) run.closed = true;
    }

    // Putting the caret somewhere by hand ends the run, as it does in Google Docs:
    // whatever is typed next is somewhere else, and is a step of its own.
    addEventListener('pointerdown', () => { run = null; settling = false; }, true);
    addEventListener('keydown', (e) => {
      settling = false;
      if (/^(Arrow|Home$|End$|Page)/.test(e.key)) run = null;
    }, true);

    /**
     * Put a remembered state back without the page jumping, then put the caret where
     * the change was and scroll only if that is out of sight. restore() rebuilds the
     * body and the sidebar, which drops the scroll position to wherever the shorter
     * document ends, so the position is held across it first.
     */
    function apply(state, mark) {
      const y = window.scrollY;
      quiet = true;
      // finally: a restore that throws must not leave the history deaf for the rest
      // of the session, or the next undo would throw away everything since.
      try { restore(JSON.parse(state)); } finally { quiet = false; }
      paintCanvas(); paintToc();
      $('#preview').textContent = toMarkdown();
      run = null;
      paintHistory();
      stash();
      window.scrollTo(0, y);
      reveal(placeCaret(mark));
    }
    $('#undo').onclick = () => {
      if (past.length < 2) return;
      const undone = past.pop();
      future.push(undone);
      apply(past[past.length - 1].state, undone.start);
    };
    $('#redo').onclick = () => {
      if (!future.length) return;
      const redone = future.pop();
      past.push(redone);
      apply(redone.state, redone.end);
    };
    // Undo from the Edit menu or the right-click menu is the browser's own, whose
    // history knows nothing of rebuilt blocks. Routed here wherever it can be.
    addEventListener('beforeinput', (e) => {
      if (e.inputType !== 'historyUndo' && e.inputType !== 'historyRedo') return;
      if (!e.cancelable) return;
      e.preventDefault();
      $(e.inputType === 'historyUndo' ? '#undo' : '#redo').click();
    }, true);

    function sync(e) {
      paintSettings();
      paintCanvas();
      paintToc();
      $('#preview').textContent = toMarkdown();
      remember(e);
      stash();
    }

    /* ---------- open an existing article ---------- */
    async function load(slug) {
      await titlesReady;
      pageKind = slug.startsWith('portal:') ? 'portal' : slug.startsWith('navbox:') ? 'navbox' : 'article';
      const bare = slug.replace(/^(portal|navbox):/, '');
      const path = pageKind === 'article' ? `/raw/${bare}.json` : `/raw/${pageKind}/${bare}.json`;
      const r = await fetch(`${BASE.replace(/\/$/, '')}${path}`);
      // A portal or navbox that does not exist yet is not an error: it is the one
      // you are about to write, which is how a new nation gets either of them.
      if (!r.ok) {
        if (pageKind === 'article') { flash('Could not open that page.', true); return; }
        blank(pageKind, bare);
        flash(`New ${pageKind}: ${bare}. Nothing saved yet.`);
        return;
      }
      const loaded = await r.json();
      const { data, body: md } = loaded;
      loadedFrom = loaded.commit || '';
      navboxLead = loaded.lead || '';
      portalBody = pageKind === 'portal' ? (md || '') : '';
      $('#f-crumb').value = data.crumb || '';
      $('#f-banner').value = data.banner || '';
      $('#f-welcome').value = data.welcome || '';
      $('#f-title').value = data.title || '';
      $('#f-boxtitle').value = data.sidebarTitle || '';
      $('#f-native').value = [].concat(data.nativeTitle ?? []).join('\n');
      $('#f-romaji').value = data.romaji || '';
      $('#f-type').value = data.type || 'overview';
      $('#f-nation').value = data.nation || '';
      $('#f-icon').value = data.icon || '';
      $('#f-authors').value = (data.authors || []).join(', ');
      $('#f-navbox-on').checked = data.navbox !== 'none';
      $('#f-sidebar-on').checked = !!(data.infobox || []).length;
      $('#f-coords').value = data.coords || '';
      $('#f-ooc').checked = !!data.ooc;
      pageSlug = bare;
      loadedTitle = (data.title || '').trim();
      setSlug(bare); slugTouched = true;
      setInfobox(data.infobox || []);
      paintSettings();
      body.innerHTML = '';
      (pageKind === 'navbox' ? navboxBlocks(loaded.groups || []) : parseBody(md || ''))
        .forEach((b) => body.append(block(b.kind, b)));
      // A portal has no body of its own, so it is not given an empty paragraph.
      if (!body.children.length && pageKind !== 'portal') body.append(block('para'));
      resetHistory();
      sync();
      loadedBody = toMarkdown();
      flash(`Opened ${data.title}.`);
    }

    /* ---------- chrome ---------- */
    let statusTimer;
    function flash(msg, bad = false) {
      const s = $('#status');
      s.textContent = msg;
      s.className = 'status ' + (bad ? 'bad' : 'good');
      clearTimeout(statusTimer);
      statusTimer = setTimeout(() => { s.textContent = ''; s.className = 'status'; }, 4000);
    }

    function dropdown(btn, menu) {
      btn.onclick = (e) => {
        e.stopPropagation();
        document.querySelectorAll('.drop-menu').forEach((m) => { if (m !== menu) m.hidden = true; });
        menu.hidden = !menu.hidden;
        if (menu.hidden) return;
        // A wide panel opened from the middle of the toolbar would run off the
        // screen, so slide it back until it fits.
        menu.style.left = '0px';
        const r = menu.getBoundingClientRect();
        const over = r.right - (innerWidth - 12);
        if (over > 0) menu.style.left = `${-over}px`;
      };
    }
    dropdown($('#file'), $('#file-menu'));
    dropdown($('#insert'), $('#insert-menu'));

    function paintFileList() {
      const q = $('#file-q').value.trim().toLowerCase();
      const list = $('#file-list');
      list.innerHTML = '';
      const hits = ARTICLES.filter((a) => !q || a.title.toLowerCase().includes(q) || a.slug.includes(q));
      if (!hits.length) { list.innerHTML = '<p class="mp-empty">No article matches.</p>'; return; }
      for (const a of hits) {
        const b = el('button', null, a.title);
        b.type = 'button';
        b.onclick = () => { $('#file-menu').hidden = true; load(a.slug); };
        list.append(b);
      }
    }
    $('#file-q').oninput = paintFileList;
    $('#file').addEventListener('click', () => {
      if (!$('#file-menu').hidden) { paintFileList(); $('#file-q').focus(); }
    });
    dropdown($('#more'), $('#more-menu'));
    dropdown($('#style'), $('#style-menu'));
    dropdown($('#ins'), $('#ins-menu'));
    document.addEventListener('click', () => {
      document.querySelectorAll('.drop-menu').forEach((m) => m.hidden = true);
      pickTarget = null;      // the panel is shut; it is not aimed at anything now
    });
    $('#settings-btn').onclick = () => { $('#settings').hidden = !$('#settings').hidden; };

    $('#back').onclick = () => {
      const to = $('#back').dataset.to;
      if (to) location.href = BASE.replace(/\/$/, '') + to;
    };
    $('#source').onclick = () => { $('#source-panel').hidden = false; };
    $('#source-close').onclick = () => { $('#source-panel').hidden = true; };

    document.querySelectorAll('[data-add]').forEach((b) => b.onclick = () => insert(b.dataset.add));

    /* ---------- table size pickers ---------- */
    // Docs-style grid: hovering sizes the table, clicking inserts it. A data table is
    // the same table, written so that a reader can sort it by any column.
    function sizePicker(pick, label, extra) {
      const MAXR = 8, MAXC = 8;
      for (let r = 1; r <= MAXR; r++) {
        for (let c = 1; c <= MAXC; c++) {
          const cell = el('span', 'tbl-cell');
          cell.dataset.r = r; cell.dataset.c = c;
          cell.onmouseenter = () => {
            label.textContent = `${c} \u00d7 ${r}`;
            pick.querySelectorAll('.tbl-cell').forEach((x) =>
              x.classList.toggle('on', +x.dataset.r <= r && +x.dataset.c <= c));
          };
          cell.onmousedown = (e) => e.preventDefault();
          cell.onclick = () => {
            insert('table', { rows: r, cols: c, ...extra });
            document.querySelectorAll('.drop-menu').forEach((m) => m.hidden = true);
          };
          pick.append(cell);
        }
      }
      pick.onmouseleave = () => {
        label.textContent = '0 \u00d7 0';
        pick.querySelectorAll('.tbl-cell').forEach((x) => x.classList.remove('on'));
      };
    }
    sizePicker($('#tbl-pick'), $('#tbl-label'), {});
    sizePicker($('#dtbl-pick'), $('#dtbl-label'), { sortable: true });

    /* ---------- date ---------- */
    let dtMode = '';
    const dtArg = () => {
      const d = $('#dt-date').value;
      if (!d) return '';
      if (dtMode === 'age') {
        // For an age the date above is the birth. A death date, when there is one, is
        // the date printed, with the age that was reached by then.
        const died = $('#dt-died').value;
        return died ? `${died}|age:${d}` : `${d}|age`;
      }
      return dtMode ? `${d}|${dtMode}` : d;
    };
    function paintDate() {
      const age = dtMode === 'age';
      $('#dt-date-label').textContent = age ? 'Born' : 'Date';
      $('#dt-died-row').hidden = !age;
      const arg = dtArg();
      $('#dt-preview').textContent = arg ? dateLabel(arg) : 'Pick a date.';
      $('#dt-preview').className = 'mp-hint' + (arg ? ' ok' : '');
      $('#dt-go').disabled = !arg;
    }
    document.querySelectorAll('#dt-mode button').forEach((b) => {
      b.onmousedown = (e) => e.preventDefault();
      b.onclick = () => {
        document.querySelectorAll('#dt-mode button').forEach((x) => x.classList.toggle('on', x === b));
        dtMode = b.dataset.mode;
        paintDate();
      };
    });
    // A native date picker opens wherever its value points, and with none it opens on
    // the real year. Avium is in 1934, which is where the writer means to be.
    $('#dt-date').value = IC_NOW;
    $('#dt-date').oninput = paintDate;
    $('#dt-died').oninput = paintDate;
    $('#dt-go').onclick = () => {
      const arg = dtArg();
      if (!arg) return;
      if (!insertToken('date', arg)) return;
      document.querySelectorAll('.drop-menu').forEach((m) => { m.hidden = true; });
    };
    paintDate();

    /* ---------- link popover ---------- */
    const pop = $('#link-pop');
    const lpText = $('#lp-text');
    const lpTarget = $('#lp-target');
    let savedRange = null;
    let editingAnchor = null;

    const closeLink = () => { pop.hidden = true; savedRange = null; editingAnchor = null; };

    function anchorAtCaret() {
      const sel = window.getSelection();
      if (!sel.anchorNode) return null;
      const node = sel.anchorNode.nodeType === 1 ? sel.anchorNode : sel.anchorNode.parentElement;
      const a = node?.closest?.('a');
      return a && a.closest('.ce') ? a : null;
    }

    function openLink() {
      const where = activeText();
      if (!where) { flash('Put the cursor in the text first.', true); return; }
      const sel = window.getSelection();
      savedRange = sel.rangeCount ? sel.getRangeAt(0).cloneRange() : null;
      editingAnchor = anchorAtCaret();

      lpText.value = editingAnchor ? editingAnchor.textContent : (sel.toString() || '');
      lpTarget.value = editingAnchor
        ? (editingAnchor.dataset.slug || editingAnchor.getAttribute('href') || '')
        : '';
      $('#lp-remove').hidden = !editingAnchor;

      // Sit under the selection, or under the block if the caret is collapsed.
      const box = (editingAnchor || where).getBoundingClientRect();
      const r = savedRange && savedRange.getBoundingClientRect();
      const anchorRect = r && r.width ? r : box;
      pop.hidden = false;
      const w = pop.offsetWidth;
      pop.style.left = `${Math.max(12, Math.min(anchorRect.left, innerWidth - w - 12))}px`;
      pop.style.top = `${Math.min(anchorRect.bottom + 8, innerHeight - pop.offsetHeight - 12)}px`;
      paintLinkResults();
      (lpText.value ? lpTarget : lpText).focus();
      lpTarget.select?.();
    }

    function paintLinkResults() {
      const q = lpTarget.value.trim().toLowerCase();
      const list = $('#lp-list');
      list.innerHTML = '';
      if (/^https?:/i.test(q)) {
        list.innerHTML = '<p class="lp-empty">External link. Apply to insert it.</p>';
        return;
      }
      const hits = ARTICLES.filter((a) => !q || a.title.toLowerCase().includes(q) || a.slug.includes(q)).slice(0, 6);
      for (const a of hits) {
        const b = el('button', 'lp-hit');
        b.type = 'button';
        b.innerHTML = `<span class="lp-title">${esc(a.title)}</span><span class="lp-slug">${esc(a.slug)}</span>`;
        b.onmousedown = (e) => e.preventDefault();
        b.onclick = () => { lpTarget.value = a.slug; applyLink(); };
        list.append(b);
      }
      const slug = slugify(q);
      if (slug && !ARTICLES.some((a) => a.slug === slug)) {
        const b = el('button', 'lp-hit new');
        b.type = 'button';
        b.innerHTML = `<span class="lp-title">Link to a new article</span><span class="lp-slug">${esc(slug)} — shows red until it is written</span>`;
        b.onmousedown = (e) => e.preventDefault();
        b.onclick = () => { lpTarget.value = slug; applyLink(); };
        list.append(b);
      }
      if (!list.children.length) list.innerHTML = '<p class="lp-empty">Type a title, a slug, or a URL.</p>';
    }

    function applyLink() {
      const target = lpTarget.value.trim();
      if (!target) { lpTarget.focus(); return; }
      const external = /^https?:/i.test(target);
      const slug = external ? target : slugify(target);
      const text = lpText.value.trim() || (external ? target : displayOf(slug));
      const html = external
        ? `<a href="${esc(target)}">${esc(text)}</a>`
        : `<a href="#" data-slug="${esc(slug)}">${esc(text)}</a>`;
      if (editingAnchor) {
        editingAnchor.outerHTML = html;
      } else {
        const host = activeText();
        host?.focus();
        if (savedRange) putRange(savedRange);
        document.execCommand('insertHTML', false, html);
        unglue(ceOf(getSelection().anchorNode) || host);
      }
      closeLink();
      sync();
    }

    $('#lp-apply').onclick = applyLink;
    $('#lp-remove').onclick = () => {
      if (editingAnchor) editingAnchor.replaceWith(document.createTextNode(editingAnchor.textContent));
      closeLink();
      sync();
    };
    lpTarget.oninput = paintLinkResults;
    for (const input of [lpText, lpTarget]) {
      input.onkeydown = (e) => {
        if (e.key === 'Enter') { e.preventDefault(); applyLink(); }
        if (e.key === 'Escape') { e.preventDefault(); closeLink(); }
      };
    }
    pop.addEventListener('mousedown', (e) => e.stopPropagation());
    document.addEventListener('mousedown', (e) => { if (!pop.hidden && !pop.contains(e.target)) closeLink(); });

    function runCmd(cmd) {
      if (cmd === 'link') { openLink(); return; }
      document.execCommand(cmd);
      sync();
    }
    document.querySelectorAll('[data-cmd]').forEach((b) => b.onmousedown = (e) => {
      e.preventDefault();
      // Without this the same mousedown reaches the popover's outside-click closer.
      e.stopPropagation();
      runCmd(b.dataset.cmd);
    });
    addEventListener('keydown', (e) => {
      if (!(e.metaKey || e.ctrlKey)) return;
      const k = e.key.toLowerCase();
      if (k === 'b' || k === 'i' || k === 'k') { e.preventDefault(); runCmd(k === 'k' ? 'link' : k === 'b' ? 'bold' : 'italic'); }
      if (k === 'z') { e.preventDefault(); (e.shiftKey ? $('#redo') : $('#undo')).click(); }
      if (k === 'y') { e.preventDefault(); $('#redo').click(); }
      if (k === 's' && DEV) { e.preventDefault(); $('#save').click(); }
    });

    // The canvas title is the real title field; the settings box is the same value.
    $('#canvas-title').addEventListener('input', (e) => {
      $('#f-title').value = $('#canvas-title').textContent.trim();
      if (!slugTouched) setSlug(slugify($('#f-title').value));
      sync(e);
    });
    $('#canvas-title').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); body.querySelector('.ce')?.focus(); }
    });
    $('#canvas-title').addEventListener('paste', (e) => {
      e.preventDefault();
      document.execCommand('insertText', false, e.clipboardData.getData('text/plain'));
    });

    // The sidebar heading, edited at the top of the sidebar. The hidden inputs behind
    // these three are what the markdown, the draft and the slug are built from, so
    // everything downstream still reads one place.
    for (const [id, field, multi] of [
      ['#ib-title', '#f-boxtitle', false],
      ['#ib-native', '#f-native', true],
      ['#ib-romaji', '#f-romaji', false],
    ]) {
      const el = $(id);
      el.addEventListener('input', (e) => {
        const text = el.innerText.replace(/\u00a0/g, ' ');
        $(field).value = multi
          ? text.split('\n').map((l) => l.trim()).filter(Boolean).join('\n')
          : text.replace(/\s+/g, ' ').trim();
        sync(e);
      });
      el.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter') return;
        // A native title carries one line per official language, so shift ↵ opens
        // another. Every other line here is a single one, and ↵ moves on.
        if (multi && e.shiftKey) return;
        e.preventDefault();
        if (!e.shiftKey) body.querySelector('.ce')?.focus();
      });
      el.addEventListener('paste', (e) => {
        e.preventDefault();
        const t = e.clipboardData.getData('text/plain');
        document.execCommand('insertText', false, multi ? t : t.replace(/\s*\n+\s*/g, ' '));
      });
    }

    $('#f-type').onchange = () => {
      if (ib.querySelector('tr[data-kind]') && !confirm('Replace the sidebar with this type’s template?')) return;
      setInfobox(TEMPLATES[$('#f-type').value] || []);
      sync();
    };
    /** Clear the desk and start a page of the given kind. */
    function blank(kind, slug = '') {
      loadedFrom = BUILT_FROM;           // a page not on main yet: any copy of main will do
      pageKind = kind; navboxLead = ''; portalBody = ''; pageSlug = slug; loadedTitle = ''; loadedBody = '';
      $('#settings').querySelectorAll('input[type=text], input[type=hidden], textarea').forEach((i) => i.value = '');
      $('#f-ooc').checked = false;
      $('#f-navbox-on').checked = true;
      $('#f-sidebar-on').checked = true;
      $('#canvas-title').textContent = '';
      setSlug(slug); slugTouched = !!slug;
      try { sessionStorage.removeItem(DRAFT); } catch {}
      setInfobox(kind === 'article' ? (TEMPLATES[$('#f-type').value] || []) : []);
      body.innerHTML = '';
      // A portal has no body at all; a navbox opens on its first heading.
      if (kind === 'article') body.append(block('para'));
      else if (kind === 'navbox') body.append(block('section'));
      // A portal or navbox is named after its nation, so the slug is the nation id.
      if (slug && kind !== 'article') {
        const opt = [...$('#f-nation').options].find((o) => o.value === slug);
        if (opt) {
          $('#f-nation').value = slug;
          $('#f-title').value = kind === 'portal' ? `Portal:${opt.textContent}` : `${opt.textContent} Articles`;
          if (kind === 'navbox') {
            $('#f-crumb').value = `[[portal:${slug}|Portal:${opt.textContent}]] • [[${slug}|Overview]]`;
          }
        }
      }
      paintSettings();
      resetHistory();
      sync();
    }

    const NEW = { '#new': 'article', '#new-portal': 'portal', '#new-navbox': 'navbox' };
    for (const [id, kind] of Object.entries(NEW)) {
      $(id).onclick = () => {
        if (!confirm(`Discard this draft and start a new ${kind}?`)) return;
        blank(kind);
      };
    }

    // The nation is what a portal or a navbox is filed under, so it names the file.
    $('#f-nation').addEventListener('change', () => {
      if (pageKind === 'article' || !DEV) return;
      const id = $('#f-nation').value;
      const name = $('#f-nation').selectedOptions[0]?.textContent || id;
      if (!id) return;
      pageSlug = id;
      setSlug(id);
      if (!$('#f-title').value.trim()) {
        $('#f-title').value = pageKind === 'portal' ? `Portal:${name}` : `${name} Articles`;
      }
      if (pageKind === 'navbox' && !$('#f-crumb').value.trim()) {
        $('#f-crumb').value = `[[portal:${id}|Portal:${name}]] • [[${id}|Overview]]`;
      }
      sync();
    });

    $('#go-navbox').onclick = () => {
      const id = $('#f-nation').value;
      if (id) location.href = `${BASE.replace(/\/$/, '')}/edit?a=navbox:${id}`;
    };
    $('#f-banner-pick').onclick = () => { $('#f-banner').focus(); openMedia(); };
    ['#f-type', '#f-nation', '#f-navbox-on', '#f-sidebar-on'].forEach((id) => {
      $(id).addEventListener('change', paintSettings);
    });
    $('#settings').addEventListener('input', (e) => { paintSettings(); sync(e); });
    $('#settings').addEventListener('change', sync);

    const saveAs = (blob, name) => {
      const a = el('a');
      a.href = URL.createObjectURL(blob);
      a.download = name;
      a.click();
      URL.revokeObjectURL(a.href);
    };
    async function downloadPage() {
      const stem = slugify(slugValue() || pageSlug || $('#f-title').value) || 'article';
      const md = toMarkdown();
      const used = [...staged.entries()].filter(([p]) => md.includes(p));
      if (!used.length) { saveAs(new Blob([md], { type: 'text/markdown' }), `${stem}.md`); return; }
      const entries = [{ name: `${stem}.md`, data: new TextEncoder().encode(md) }];
      for (const [path, s] of used) {
        entries.push({ name: path.replace(/^\//, ''), data: new Uint8Array(await s.file.arrayBuffer()) });
      }
      saveAs(zip(entries), `${stem}.zip`);
      flash(`Zipped with ${used.length} image${used.length === 1 ? '' : 's'}.`);
    }
    /* ---------- publish: a pull request, straight from the browser ----------
       api.github.com allows cross-origin calls, so the whole flow runs here with no
       server of any kind. A contributor without push access gets a fork first. */

    const GH = 'https://api.github.com';
    const TOKEN_KEY = 'talopedia-gh-token';
    const token = {
      get: () => { try { return localStorage.getItem(TOKEN_KEY) || ''; } catch { return ''; } },
      set: (v) => { try { v ? localStorage.setItem(TOKEN_KEY, v) : localStorage.removeItem(TOKEN_KEY); } catch {} },
    };

    async function gh(path, opts = {}) {
      const r = await fetch(path.startsWith('http') ? path : GH + path, {
        ...opts,
        headers: {
          accept: 'application/vnd.github+json',
          authorization: `Bearer ${token.get()}`,
          ...(opts.body ? { 'content-type': 'application/json' } : {}),
          ...opts.headers,
        },
      });
      const text = await r.text();
      const data = text ? JSON.parse(text) : {};
      if (!r.ok) {
        const where = path.replace(GH, '').split('?')[0];
        // GitHub's own wording says nothing about which permission is missing, and the
        // cause is nearly always one of two things, so name whichever it is.
        const msg = data.message || '';
        const why = /Bad credentials/i.test(msg)
          ? '. The token is wrong or has expired'
          : /not accessible|Not Found|Resource not accessible/i.test(msg)
          ? '. The token is missing the public_repo scope'
          : '';
        throw new Error(`${msg || r.statusText} (${opts.method || 'GET'} ${where})${why}.`);
      }
      return data;
    }

    /** base64 of a byte array, in chunks: spreading a whole file blows the call stack. */
    function b64(bytes) {
      let out = '';
      for (let i = 0; i < bytes.length; i += 0x8000) {
        out += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
      }
      return btoa(out);
    }
    const b64text = (s) => b64(new TextEncoder().encode(s));

    /** Where this page belongs in the repository. */
    function targetPath(slug) {
      if (pageKind === 'portal') return `src/content/portals/${slug}.md`;
      if (pageKind === 'navbox') return `src/content/data/navboxes/${slug}.yaml`;
      return `src/content/articles/${slug}.md`;
    }

    const pubSay = (msg, bad = false) => {
      const el = $('#pub-status');
      el.textContent = msg;
      el.className = 'pub-status' + (bad ? ' bad' : '');
    };

    async function putFile(repo, branch, path, contentB64, message) {
      // An existing file needs the blob it replaces, or GitHub refuses the write.
      let sha;
      try {
        sha = (await gh(`/repos/${repo}/contents/${encodeURI(path)}?ref=${branch}`)).sha;
      } catch { /* new file */ }
      await gh(`/repos/${repo}/contents/${encodeURI(path)}`, {
        method: 'PUT',
        body: JSON.stringify({ message, content: contentB64, branch, ...(sha && { sha }) }),
      });
    }

    /* ---------- reading a file back in ----------
       The editor writes a narrow slice of YAML, so it can read that slice back without
       carrying a parser. Anything it did not write is not promised. */

    const unquote = (v) => {
      const t = String(v).trim();
      return /^".*"$/.test(t)
        ? t.slice(1, -1).replace(/\\"/g, '"').replace(/\\\\/g, '\\')
        : t;
    };

    /** `{ label: "x", sub: true, value: "y" }` as an object. */
    function inlineObj(text) {
      const out = {};
      for (const m of text.replace(/^\{|\}$/g, '').matchAll(/(\w+):\s*("(?:[^"\\]|\\.)*"|[^,}]+)/g)) {
        const v = unquote(m[2]);
        out[m[1]] = v === 'true' ? true : v === 'false' ? false : v;
      }
      return out;
    }

    const indent = (l) => l.length - l.trimStart().length;

    /** The frontmatter block, and the infobox rows inside it. */
    function readHead(lines) {
      const data = {}, rows = [];
      for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        if (!line.trim() || indent(line) > 0) continue;
        const m = line.match(/^(\w+):\s*(.*)$/);
        if (!m) continue;
        const [, key, rest] = m;
        if (key === 'infobox') {
          // Rows run until the indentation comes back to the left margin.
          let j = i + 1;
          const block = [];
          while (j < lines.length && (!lines[j].trim() || indent(lines[j]) > 0)) block.push(lines[j++]);
          i = j - 1;
          for (let k = 0; k < block.length; k++) {
            const l = block[k];
            if (!/^\s*- /.test(l)) continue;
            const body = l.replace(/^\s*- /, '');
            if (body.startsWith('{')) { rows.push(inlineObj(body)); continue; }
            if (/^images:/.test(body)) {
              const images = [];
              let k2 = k + 1;
              while (k2 < block.length && indent(block[k2]) > indent(l)) {
                const im = block[k2].match(/^\s*- (\{.*\})\s*$/);
                if (im) images.push(inlineObj(im[1]));
                k2++;
              }
              rows.push({ images });
              k = k2 - 1;
              continue;
            }
            if (/^pair:/.test(body)) {
              const pair = [];
              let k2 = k + 1;
              while (k2 < block.length && indent(block[k2]) > indent(l)) {
                const h = block[k2].match(/^\s*- heading:\s*(.*)$/);
                if (h) pair.push({ heading: unquote(h[1]), items: [] });
                const it = block[k2].match(/^\s*- (".*")\s*$/);
                if (it && pair.length) pair[pair.length - 1].items.push(unquote(it[1]));
                k2++;
              }
              rows.push({ pair });
              k = k2 - 1;
              continue;
            }
            // `- label: "x"` with its own indented keys under it
            const row = {};
            const first = body.match(/^(\w+):\s*(.*)$/);
            if (!first) continue;
            let k2 = k + 1;
            const take = (key2, rest2) => {
              if (rest2) { row[key2] = rest2 === 'true' ? true : unquote(rest2); return; }
              const list = [];
              while (k2 < block.length && /^\s*- /.test(block[k2]) && indent(block[k2]) > indent(l)) {
                list.push(unquote(block[k2].replace(/^\s*- /, '')));
                k2++;
              }
              row[key2] = list;
            };
            take(first[1], first[2]);
            while (k2 < block.length && indent(block[k2]) > indent(l) && !/^\s*- /.test(block[k2])) {
              const nx = block[k2].match(/^\s*(\w+):\s*(.*)$/);
              k2++;
              if (nx) take(nx[1], nx[2]);
            }
            rows.push(row);
            k = k2 - 1;
          }
          continue;
        }
        if (rest) {
          data[key] = /^\[.*\]$/.test(rest)
            ? rest.slice(1, -1).split(',').map((x) => x.trim()).filter(Boolean)
            : unquote(rest);
        } else {
          const list = [];
          let j = i + 1;
          while (j < lines.length && /^\s*- /.test(lines[j])) list.push(unquote(lines[j++].replace(/^\s*- /, '')));
          data[key] = list;
          i = j - 1;
        }
      }
      return { data, rows };
    }

    /** A navbox file's groups, which the block editor draws as headings and lists. */
    function readGroups(lines) {
      const groups = [];
      let group = null, row = null;
      for (const line of lines) {
        const t = line.trim();
        if (!t || t === 'groups:' || t === 'rows:') continue;
        let m;
        if ((m = t.match(/^- label:\s*(.*)$/)) && indent(line) <= 2) {
          group = { label: unquote(m[1]), rows: [] }; groups.push(group); row = null;
        } else if ((m = t.match(/^- label:\s*(.*)$/))) {
          row = { label: unquote(m[1]), items: [] }; group?.rows.push(row);
        } else if ((m = t.match(/^- note:\s*(.*)$/))) {
          group?.rows.push({ note: unquote(m[1]) }); row = null;
        } else if (t === '- items:') {
          row = { items: [] }; group?.rows.push(row);
        } else if (t === 'items:') {
          if (row) row.items = [];
        } else if ((m = t.match(/^- (.*)$/)) && row) {
          row.items.push(unquote(m[1]));
        }
      }
      return groups;
    }

    /** Put a whole stored file back on screen. */
    function fromMarkdown(text) {
      resetHistory();
      const src = String(text).replace(/\r\n/g, '\n');
      if (!src.startsWith('---')) {
        // No frontmatter means a navbox, which is YAML all the way down.
        const lines = src.split('\n');
        const { data } = readHead(lines.filter((l) => indent(l) === 0 && !/^groups:/.test(l)));
        pageKind = 'navbox';
        navboxLead = (src.match(/^(?:#[^\n]*\n)+/) || [''])[0];
        $('#f-title').value = data.title || '';
        $('#f-crumb').value = data.crumb || '';
        setInfobox([]);
        body.innerHTML = '';
        navboxBlocks(readGroups(lines)).forEach((b) => body.append(block(b.kind, b)));
        sync();
        return;
      }
      const end = src.indexOf('\n---', 3);
      const head = src.slice(4, end === -1 ? src.length : end).split('\n');
      const rest = end === -1 ? '' : src.slice(end + 4).replace(/^\n+/, '');
      const { data, rows } = readHead(head);

      pageKind = data.type ? 'article' : 'portal';
      portalBody = pageKind === 'portal' ? rest : '';
      $('#f-title').value = data.title || '';
      $('#f-boxtitle').value = data.sidebarTitle || '';
      $('#f-native').value = [].concat(data.nativeTitle ?? []).join('\n');
      $('#f-romaji').value = data.romaji || '';
      $('#f-type').value = data.type || 'overview';
      $('#f-nation').value = data.nation || '';
      $('#f-icon').value = data.icon || '';
      $('#f-banner').value = data.banner || '';
      $('#f-welcome').value = data.welcome || '';
      $('#f-crumb').value = '';
      $('#f-authors').value = [].concat(data.authors ?? []).join(', ');
      $('#f-navbox-on').checked = data.navbox !== 'none';
      $('#f-sidebar-on').checked = !!rows.length;
      $('#f-coords').value = data.coords || '';
      $('#f-ooc').checked = data.ooc === true || data.ooc === 'true';
      setInfobox(rows);
      body.innerHTML = '';
      if (pageKind !== 'portal') parseBody(rest).forEach((b) => body.append(block(b.kind, b)));
      if (!body.children.length && pageKind === 'article') body.append(block('para'));
      sync();
    }

    if ($('#open-file')) {
      $('#open-file').onclick = () => $('#open-file-input').click();
      $('#duplicate').onclick = duplicate;
      $('#open-file-input').onchange = async (e) => {
        const f = e.target.files[0];
        e.target.value = '';
        if (!f) return;
        try {
          fromMarkdown(await f.text());
          pageSlug = f.name.replace(/\.(md|markdown|ya?ml)$/i, '');
          loadedFrom = '';               // a file from disk says nothing of which copy it was
          loadedTitle = $('#f-title').value.trim();
          setSlug(pageSlug); slugTouched = true;
          sync();
          flash(`Opened ${f.name}.`);
        } catch (err) {
          flash(`Could not read ${f.name}: ${err.message}`, true);
        }
      };
    }

    /* ---------- the changes waiting to go ----------
       Kept in IndexedDB rather than localStorage: a change carries the image files
       that go with it, and those are Blobs, which localStorage cannot hold. */

    const DB = 'talopedia-changes';
    let dbp = null;
    const db = () => (dbp ??= new Promise((res, rej) => {
      const r = indexedDB.open(DB, 1);
      r.onupgradeneeded = () => r.result.createObjectStore('changes', { keyPath: 'key' });
      r.onsuccess = () => res(r.result);
      r.onerror = () => rej(r.error);
    }));
    async function store(mode, run) {
      const tx = (await db()).transaction('changes', mode);
      const out = run(tx.objectStore('changes'));
      return new Promise((res, rej) => {
        tx.oncomplete = () => res(out.result ?? out);
        tx.onerror = () => rej(tx.error);
      });
    }
    const cart = {
      all: () => store('readonly', (s) => s.getAll()),
      put: (c) => store('readwrite', (s) => s.put(c)),
      drop: (k) => store('readwrite', (s) => s.delete(k)),
      clear: () => store('readwrite', (s) => s.clear()),
    };

    /** This page as a change: the file it writes, and the pictures it brings with it. */
/**
 * The line that goes into the commit and so into the page's history. Every commit the
 * editor made before this field existed says the same thing, which made the log
 * useless for review.
 */
    const commitMsg = (slug, summary, from) => `${slug}: ${summary || 'edit from the wiki editor'}`
      + (from ? `\n\nBased-on: ${from}` : '');

    /** How a page is named in the index: bare for an article, prefixed for the rest.
        Declared rather than assigned: it is called from further up the file. */
    function indexKey(kind, slug) { return kind === 'article' ? slug : `${kind}:${slug}`; }

    /**
     * The first page in a push that the workflow will not merge on its own, if there
     * is one, so the writer is told what actually happens rather than a hopeful guess.
     * The rule lives in .github/gate.mjs; this is the sentence of it that decides the
     * ordinary case, which is that a nation is editing a page credited to it alone.
     */
    function heldBack(changes, login) {
      if (login === ADMIN) return null;
      const mine = NATION_OF[login];
      for (const c of changes) {
        const held = ARTICLES.find((a) => a.slug === indexKey(c.kind, c.slug));
        // A page not on the site yet is the writer's when it credits their own nation,
        // which is the same test the gate puts it to.
        const by = held ? held.by : creditIn(c.markdown || '', c.kind, c.slug);
        if (!mine || by.length !== 1 || by[0] !== mine) return { title: held?.title || c.title || c.slug, by };
      }
      return null;
    }

    /** Who a page's own text credits: the byline, as .github/gate.mjs reads it. */
    function creditIn(md, kind, slug) {
      if (kind === 'navbox') return slug === 'site' ? [] : [slug];
      const head = md.startsWith('---') ? md.slice(3, md.indexOf('\n---', 3)) : '';
      const clean = (x) => x.trim().replace(/^["']|["']$/g, '');
      const list = head.match(/^authors:[ \t]*\[([^\]]*)\]/m);
      if (list) return list[1].split(',').map(clean).filter(Boolean);
      const one = head.match(/^nation:[ \t]*(\S.*)$/m);
      return one ? [clean(one[1])] : [];
    }

    /** What to tell the writer once the pull request is open. */
    function sentWord(changes, login) {
      const held = heldBack(changes, login);
      if (!held) return 'Your edit is on its way.';
      const who = held.by.map((n) => NATION_NAMES[n] || n).join(' and ');
      return `Sent. ${held.title} is credited to ${who || 'nobody'}, so it waits for a look.`;
    }

    function currentChange() {
      const slug = slugify(slugValue() || pageSlug || $('#f-title').value);
      if (!slug) return null;
      const markdown = toMarkdown();
      return {
        key: `${pageKind}:${slug}`,
        kind: pageKind,
        slug,
        title: $('#f-title').value || slug,
        summary: $('#f-summary').value.trim(),
        path: targetPath(slug),
        from: loadedFrom,
        markdown,
        images: [...staged.entries()].filter(([p]) => markdown.includes(p))
          .map(([p, item]) => ({ path: p, file: item.file })),
        at: Date.now(),
      };
    }

    async function paintCart() {
      const list = await cart.all();
      const n = $('#cart-n');
      if (n) n.textContent = list.length;
      const box = $('#cart-list');
      if (!box) return list;
      box.innerHTML = '';
      if (!list.length) {
        box.innerHTML = '<p class="mp-empty">Nothing waiting. Edit a page and press Commit.</p>';
      }
      for (const c of list.sort((a, b) => a.at - b.at)) {
        const row = el('div', 'cart-row');
        const known = ARTICLES.some((a) => a.slug === c.key.replace(/^article:/, ''));
        row.append(el('span', 'cart-tag', known ? 'edit' : 'new'));
        const who = el('span', 'cart-name');
        who.append(el('b', null, c.title));
        who.append(el('span', 'cart-path', c.path
          + (c.images.length ? `  ·  ${c.images.length} image${c.images.length === 1 ? '' : 's'}` : '')));
        const open = el('button', null, 'Open'); open.type = 'button';
        open.onclick = () => { $('#pub-panel').hidden = true; loadChange(c); };
        const x = el('button', 'cart-x', '\u2715'); x.type = 'button'; x.title = 'Drop this change';
        x.onclick = async () => { await cart.drop(c.key); paintCart(); };
        row.append(who, open, x);
        box.append(row);
      }
      return list;
    }

    /** Put a waiting change back on screen, exactly as it was set aside. */
    function loadChange(c) {
      loadedFrom = c.from || '';
      pageKind = c.kind;
      pageSlug = c.slug;
      fromMarkdown(c.markdown);
      for (const im of c.images) {
        if (!staged.has(im.path)) staged.set(im.path, { file: im.file, url: URL.createObjectURL(im.file) });
      }
      // Its own address, or Commit would file it under whatever page was open before.
      setSlug(c.slug); slugTouched = true;
      paintAssets();
      sync();
      flash(`Opened ${c.title} from your changes.`);
    }

    /* ---------- sending them ---------- */

    async function publishAll() {
      const list = await cart.all();
      if (!list.length) { pubSay('Nothing to push yet.', true); return; }

      $('#pub-go').disabled = true;
      try {
        pubSay('Checking the token\u2026');
        const me = await gh('/user');
        const base = await gh(`/repos/${REPO}`);
        const canPush = !!base.permissions?.push;
        const mine = (base.owner?.login || '').toLowerCase() === (me.login || '').toLowerCase();

        let work = REPO;
        if (!canPush) {
          if (mine) {
            throw new Error(`This token cannot write to ${REPO}, which you own. `
              + 'It needs the public_repo scope.');
          }
          pubSay(`Forking ${REPO}\u2026`);
          await gh(`/repos/${REPO}/forks`, { method: 'POST' });
          work = `${me.login}/${base.name}`;
          for (let i = 0; i < 20; i++) {
            try { await gh(`/repos/${work}`); break; }
            catch { await new Promise((r) => setTimeout(r, 1500)); }
          }
          // An old fork still sits where it was left, so bring it level first.
          try {
            await gh(`/repos/${work}/merge-upstream`, {
              method: 'POST', body: JSON.stringify({ branch: base.default_branch }),
            });
          } catch {
            // GitHub refuses whenever main has changed a workflow file, which this token
            // may not touch, so a fork can sit days behind. The branch then starts from
            // that old copy; the Based-on line on each commit is what lets it merge.
          }
        }

        const main = base.default_branch;
        const tip = await gh(`/repos/${work}/git/ref/heads/${main}`);
        const branch = `talopedia/${list.length > 1 ? 'batch' : list[0].slug}-${Date.now().toString(36)}`;
        pubSay('Making a branch\u2026');
        await gh(`/repos/${work}/git/refs`, {
          method: 'POST',
          body: JSON.stringify({ ref: `refs/heads/${branch}`, sha: tip.object.sha }),
        });

        let done = 0;
        for (const c of list) {
          pubSay(`Committing ${++done} of ${list.length}: ${c.title}\u2026`);
          await putFile(work, branch, c.path, b64text(c.markdown), commitMsg(c.slug, c.summary, c.from));
          for (const im of c.images) {
            const bytes = new Uint8Array(await im.file.arrayBuffer());
            await putFile(work, branch, 'public' + im.path, b64(bytes),
              `${c.slug}: add ${im.path.split('/').pop()}`);
          }
        }

        pubSay('Opening the pull request\u2026');
        const lines = list.map((c) => `- \`${c.path}\``).join('\n');
        await gh(`/repos/${REPO}/pulls`, {
          method: 'POST',
          body: JSON.stringify({
            title: list.length === 1 ? list[0].title : `${list.length} pages from the wiki editor`,
            head: canPush ? branch : `${me.login}:${branch}`,
            base: main,
            body: `Written in the wiki editor by @${me.login}.\n\n${lines}\n`,
          }),
        });

        await cart.clear();
        await paintCart();
        pubSay('');
        $('#pub-panel').hidden = true;
        flash(sentWord(list, me.login));
      } catch (e) {
        pubSay(String(e.message || e), true);
      } finally {
        $('#pub-go').disabled = false;
      }
    }

    if ($('#cart-add')) {
      const panel = $('#pub-panel');
      $('#cart-add').onclick = async () => {
        const c = currentChange();
        if (!c) { flash('Give the page a title first.', true); return; }
        const held = occupiedBy(c.slug);
        if (held) { refuseReplace(c.slug, held); return; }
        if (overwrites(c.slug)) {
          // Same file, different subject, and the text has gone too. That is a new
          // page wearing an old file name, and it is refused rather than queried.
          if (keptFraction() < 0.35) { refuseReplace(c.slug, loadedTitle); return; }
          if (!confirm(`${c.slug} is "${loadedTitle}". Saving renames it to "${c.title}".\n\n`
              + 'To keep both, cancel and use File \u25b8 Duplicate as a new page.')) return;
        }
        await cart.put(c);
        $('#f-summary').value = '';       // the next edit gets its own line
        await paintCart();
        flash(`${c.title} is waiting with ${(await cart.all()).length - 1} other change(s).`
          .replace(' with 0 other change(s)', ', on its own so far'));
      };
      $('#cart-open').onclick = async () => {
        await paintCart();
        panel.hidden = false;
        $('#pub-token').value = token.get();
        $('#pub-make').href = 'https://github.com/settings/tokens/new?scopes=public_repo'
          + `&description=${encodeURIComponent('The Talopedia editor')}`;
        $('#pub-help').open = !token.get();
        pubSay(token.get() ? '' : 'Paste a token to push.');
      };
      $('#pub-close').onclick = () => { panel.hidden = true; };

      panel.onclick = (e) => { if (e.target === panel) panel.hidden = true; };
      $('#pub-token').oninput = () => token.set($('#pub-token').value.trim());
      $('#pub-forget').onclick = () => { token.set(''); $('#pub-token').value = ''; pubSay('Token forgotten.'); };
      $('#pub-go').onclick = () => {
        if (!token.get()) { pubSay('Paste a token first.', true); $('#pub-token').focus(); return; }
        publishAll();
      };
      paintCart();
    }

    $('#download').onclick = downloadPage;
    $('#copy').onclick = async () => {
      await navigator.clipboard.writeText(toMarkdown());
      flash('Markdown copied.');
    };

    /* ---------- save to disk (dev server only) ---------- */
    const slugify = (s) => s.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    let slugTouched = false;

    $('#f-slug').oninput = () => { slugTouched = true; showUrl($('#f-slug').value); };
    if (DEV) {
      const slugBox = $('#slug');
      // Typing in either box is the same act, and both show the same name.
      slugBox.oninput = () => { slugTouched = true; $('#f-slug').value = slugBox.value; };
      $('#f-slug').addEventListener('input', () => { slugBox.value = $('#f-slug').value; });
      $('#save').onclick = async () => {
        const slug = slugify(slugValue() || $('#f-title').value);
        if (!slug) { flash('Give the article a title first.', true); return; }
        const held = occupiedBy(slug);
        if (held) { refuseReplace(slug, held); return; }
        if (overwrites(slug)) {
          if (keptFraction() < 0.35) { refuseReplace(slug, loadedTitle); return; }
          if (!confirm(`${slug} is "${loadedTitle}". Saving renames it to "${$('#f-title').value.trim()}".\n\n`
              + 'To keep both, cancel and use File \u25b8 Duplicate as a new page.')) return;
        }
        setSlug(slug);
        try {
          const r = await fetch(`${BASE.replace(/\/$/, '')}/__save`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ slug, markdown: toMarkdown(), kind: pageKind }),
          });
          const out = await r.json();
          if (!r.ok) throw new Error(out.error || r.statusText);
          const line = `${out.created ? 'Created' : 'Updated'} ${out.file}`;
          flash(line);
          // Writing into src/ restarts the dev server, which reloads this page.
          try { sessionStorage.setItem(DRAFT, JSON.stringify({ ...snapshot(), saved: line })); } catch {}
        } catch (e) {
          flash(`Not saved: ${e.message}`, true);
        }
      };
    }

    /* ---------- staged images (no server to upload to) ---------- */
    const staged = new Map();           // '/assets/media/x.jpg' -> { file, url }
    const slugFile = (n) => n.toLowerCase().replace(/[^a-z0-9.]+/g, '-').replace(/^-|-$/g, '');
    const ALLOWED = /\.(png|jpe?g|webp|gif|avif)$/i;

    /** Writes an upload to disk. Only the dev server offers uploads, so only it calls this. */
    async function takeImage(file, chosen) {
      if (!ALLOWED.test(file.name)) { flash(`${file.name} is not an allowed image type.`, true); return null; }
      // Every upload is named by hand; that name, kebab-cased, is the filename the article carries.
      const ext = (file.name.match(/\.[^.]+$/) || [''])[0].toLowerCase();
      const name = chosen ? slugFile(chosen).replace(/\.[^.]*$/, '') + ext : slugFile(file.name);
      const data = await new Promise((res) => {
        const fr = new FileReader();
        fr.onload = () => res(String(fr.result).split(',')[1]);
        fr.readAsDataURL(file);
      });
      const r = await fetch(`${BASE.replace(/\/$/, '')}/__upload`, {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ name, data }),
      });
      const out = await r.json();
      if (!r.ok) { flash(out.error || 'Upload failed.', true); return null; }
      flash(`Uploaded ${out.path}`);
      loadAssets(true);
      return out.path;
    }

    /** A staged file has no server path yet, so previews come from the blob. */
    // A staged upload shows from memory; anything else is a site path, which on a
    // project site lives under /<repo>/. Every <img> in the editor goes through here,
    // or it 404s wherever the site is not served from the domain root.
    const srcFor = (p) => staged.get(p)?.url || (String(p || '').startsWith('/')
      ? BASE.replace(/\/$/, '') + p : p);

    /* ---------- media panel ---------- */
    let ASSETS = [];
    let assetsLoaded = null;

    const mpIcons = $('#mp-icons');

    function loadAssets(force = false) {
      if (!force && assetsLoaded) return assetsLoaded;
      assetsLoaded = fetch(`${BASE.replace(/\/$/, '')}/assets.json`)
        .then((r) => r.json()).then((a) => { ASSETS = a; paintAssets(); })
        .catch(() => { $('#mp-icons').innerHTML = '<p class="mp-empty">Could not read the asset list.</p>'; });
      return assetsLoaded;
    }

    // macOS stores "Kōrihama" decomposed, as o plus a combining macron, while typing
    // it gives the single precomposed character. Comparing them raw finds nothing, so
    // both sides are folded down to plain letters first.
    const fold = (s) => String(s).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

    function paintAssets() {
      const iq = fold($('#mp-iq').value.trim());
      // Inline icons: the trend arrows, then nation flags, then articles with an icon.
      mpIcons.innerHTML = '';
      const arrows = [
        { kind: 'up', label: 'Up', terms: 'up rise increase arrow green' },
        { kind: 'down', label: 'Down', terms: 'down fall decrease arrow red' },
      ].filter((a) => !iq || a.terms.includes(iq));
      if (arrows.length) mpIcons.append(el('div', 'mp-group', 'arrows'));
      for (const a of arrows) {
        const b = el('button', 'mp-icon');
        b.type = 'button';
        b.title = `:${a.kind}`;
        b.append(el('span', `tok arrow ${a.kind}`, ARROW[a.kind]), el('span', null, a.label));
        b.onmousedown = (e) => e.preventDefault();
        b.onclick = () => insertToken(a.kind);
        mpIcons.append(b);
      }
      // Registered nations first: those insert :flag[slug], which follows a rename.
      const icons = Object.entries(ICONS)
        // A nation names itself: the flag registry knows "E.S.U." where the slug reads esu.
        .map(([slug, src]) => ({ slug, src, kind: FLAGS[slug] ? 'flag' : 'icon',
          label: NATION_NAMES[slug] || displayOf(slug) }));
      // Then every other flag and emblem sitting in the folders. Most of what a war
      // article needs is here: former states, colonies and wartime variants are not
      // nations in the registry, so nothing in the registry could ever offer them.
      const held = new Set(icons.map((i) => i.src));
      // The flags, and the icons folder (medals and the like). Everything else that used
      // to be offered here now lives in the archive, which is closed: a new picture
      // comes from an image host instead.
      const GROUP = { flags: 'flag', icons: 'symbol' };
      for (const a of ASSETS) {
        if (!GROUP[a.group] || held.has(a.path)) continue;
        const stem = a.name.replace(/\.[^.]+$/, '');
        const label = displayOf(stem);
        icons.push({ slug: a.path, src: a.path, kind: GROUP[a.group], label, loose: true });
      }
      // Symbols first, next to the arrows, then flags, then emblems.
      const RANK = { symbol: 0, flag: 1, icon: 2 };
      icons.sort((a, b) => RANK[a.kind] - RANK[b.kind] || a.label.localeCompare(b.label));
      const shown = icons.filter((i) => !iq || fold(i.label).includes(iq) || fold(i.slug).includes(iq));
      if (!shown.length && !arrows.length) { mpIcons.innerHTML = '<p class="mp-empty">Nothing matches.</p>'; }
      let kind = null;
      for (const i of shown) {
        if (i.kind !== kind) {
          kind = i.kind;
          mpIcons.append(el('div', 'mp-group', { symbol: 'icons', flag: 'flags', icon: 'emblems' }[kind]));
        }
        const b = el('button', 'mp-icon');
        b.type = 'button';
        // A registered nation goes in by name, so renaming it carries. One that is
        // only a file goes in by path, because there is no name to follow.
        const token = i.loose ? 'img' : i.kind;
        b.title = `:${token}[${i.slug}]`;
        const img = el('img'); img.src = srcFor(i.src); img.alt = '';
        b.append(img, el('span', null, i.label));
        b.onmousedown = (e) => e.preventDefault();
        b.onclick = () => insertToken(token, i.slug);
        mpIcons.append(b);
      }
    }

    const fill = (input, path) => {
      input.value = path;
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.focus();
    };

    /** Clicking an image fills whichever image field you were last in, else adds a block. */
    /* ---------- pictures kept somewhere else ----------
       The archive in this repository is closed: new pictures live on an image host and
       the article keeps the link. Only hosts that serve a stable direct link are taken,
       because the alternative is an article whose pictures quietly vanish. */

    const HOSTS = ['i.ibb.co', 'ibb.co', 'i.imgur.com', 'imgur.com', 'files.catbox.moe',
      'drive.google.com', 'lh3.googleusercontent.com'];
    const hostOf = (u) => { try { return new URL(u).hostname.toLowerCase().replace(/^www\./, ''); } catch { return ''; } };
    const allowed = (u) => HOSTS.includes(hostOf(u));

    /**
     * Neither Drive nor Photos hands you a picture's own address. The share button gives
     * a page, and the picture sits at a fixed address elsewhere. Drive writes the file's
     * id into every shape of link it produces, so that address can be built here. Photos
     * does not, and its share page refuses cross-origin reads, so the address has to come
     * off the picture itself with Copy image address.
     */
    const DRIVE_ID = /(?:\/file\/d\/|[?&](?:id|docid)=|\/d\/)([A-Za-z0-9_-]{20,})/;
    const PHOTO_ID = /^https:\/\/lh3\.googleusercontent\.com\/(pw\/[A-Za-z0-9_-]+)/;
    // Wider than any column on the site, and Google does the scaling rather than the reader.
    const SIZE = 2000;

    function normaliseLink(u) {
      const host = hostOf(u);
      if (host !== 'drive.google.com' && host !== 'lh3.googleusercontent.com') return u;
      const photo = u.match(PHOTO_ID);
      // Whatever size the copied address asked for is dropped: a pasted one often carries
      // a crop, and every picture here should arrive whole and at a predictable width.
      if (photo) return `https://lh3.googleusercontent.com/${photo[1]}=w${SIZE}`;
      const id = (u.match(DRIVE_ID) || [])[1];
      // Drive's own /thumbnail address only redirects here, and carries a query string
      // that the markdown escapes twice on the way to the page. This form has neither.
      return id ? `https://lh3.googleusercontent.com/d/${id}=w${SIZE}` : u;
    }

    /** What is wrong with this link, or '' if nothing is. */
    function linkTrouble(u) {
      const host = hostOf(u);
      if (!host) return 'That is not a link.';
      // imgbb and imgur give a page for the picture first, and that is the link people
      // copy. The page is not an image, so the picture never shows.
      if (host === 'ibb.co' || host === 'imgur.com') {
        return `That is ${host}'s page for the picture, not the picture itself. Use the `
          + `direct link, the one starting https://i.${host}/`;
      }
      if (host === 'photos.google.com' || host.endsWith('goo.gl')) {
        return 'That is the share page rather than the picture. Open it, right-click the '
          + 'picture, Copy image address, and paste that.';
      }
      if (!allowed(u)) {
        return /discord/.test(host)
          ? 'Discord links expire after a few days. Upload it to imgbb instead.'
          : `${host} is not on the list.`;
      }
      if (host === 'drive.google.com' && !DRIVE_ID.test(u)) {
        return 'That Drive link has no file id in it. Use Share \u2192 Copy link.';
      }
      if (host === 'lh3.googleusercontent.com' && !PHOTO_ID.test(u) && !DRIVE_ID.test(u)) {
        return 'That is a Google address but not a picture. Use Copy image address.';
      }
      return '';
    }

    function linkNote() {
      const raw = $('#mp-link').value.trim();
      const note = $('#mp-link-note');
      if (!raw) {
        note.textContent = 'Accepted: imgbb, imgur, catbox, Google Drive, Google Photos';
        note.className = 'mp-hint';
        return;
      }
      const bad = linkTrouble(raw);
      const host = hostOf(raw);
      note.textContent = bad
        || (PHOTO_ID.test(raw) ? 'Google Photos \u2713  the picture must be shared'
        : host.includes('google') ? 'Google Drive \u2713  the file must be shared with anyone who has the link'
        : `${host} \u2713`);
      note.className = 'mp-hint ' + (bad ? 'bad' : 'ok');
    }

    /**
     * Cut this page loose from the file it was opened from, so what follows is saved
     * as a new one. Using an article as a template and saving it back over the
     * original is the accident this exists to prevent.
     */
    function duplicate() {
      if (!pageSlug && !slugValue()) { flash('Nothing is open to copy.', true); return; }
      const from = pageSlug || slugValue();
      pageSlug = '';
      loadedFrom = BUILT_FROM;           // the copy is a new page, not on main yet
      loadedTitle = '';
      loadedBody = '';
      setSlug('');
      slugTouched = false;          // the URL follows the title again until it is typed in
      $('#settings').hidden = false;
      // The copy is a page of its own; undoing back past this would put the old
      // page's address on it again.
      resetHistory();
      sync();
      $('#f-title').focus();
      flash(`Copy of ${from}. Give it a new title, and check the URL before saving.`);
    }

    /**
     * The subject already living at this file name, when that file is not the one this
     * page was opened from. Writing there replaces one subject with another, which is
     * how three articles were lost in a day: everything changed except the file name.
     *
     * Read from the live index rather than from what was loaded, so a name typed by
     * hand, restored from a draft, or left behind by a copy is caught the same way.
     * A matching title is the same subject arriving by another route, and is allowed.
     */
    function occupiedBy(slug) {
      if (!slug || (pageSlug && slug === pageSlug)) return null;
      const key = pageKind === 'article' ? slug : `${pageKind}:${slug}`;
      const held = ARTICLES.find((a) => a.slug === key);
      if (!held) return null;
      return held.title === $('#f-title').value.trim() ? null : held.title;
    }

    /**
     * How much of the page that was opened is still on screen, by distinct words. A
     * rename keeps the article and changes the name; using one as a template keeps
     * the name of the file and changes everything else. This is what separates them.
     */
    function keptFraction() {
      if (!loadedBody) return 1;
      const words = (t) => new Set(t.toLowerCase().split(/[^a-z0-9\u00c0-\uffff]+/).filter((w) => w.length > 3));
      const was = words(loadedBody);
      if (was.size < 20) return 1;             // too little to judge; fall back to the prompt
      const now = words(toMarkdown());
      let hit = 0;
      for (const w of was) if (now.has(w)) hit++;
      return hit / was.size;
    }

    /** Refuse the write and put the writer in the field they have to change. */
    function refuseReplace(slug, held) {
      flash(`${slug} already holds \u201c${held}\u201d. Change the Article URL, `
        + 'or open that page if you meant to edit it.', true);
      $('#settings').hidden = false;
      $('#f-slug').focus();
      $('#f-slug').select();
    }

    /**
     * True when saving now would write over the page this one was opened from, under a
     * title that is no longer that page's.
     */
    function overwrites(slug) {
      if (!pageSlug || slug !== pageSlug || !loadedTitle) return false;
      return $('#f-title').value.trim() !== loadedTitle;
    }

    /** The file name this page is saved under, wherever it was typed. Declared
        rather than assigned: it is called from further up the file than it sits. */
    function slugValue() { return $('#f-slug').value || $('#slug')?.value || ''; }
    function setSlug(v) {
      $('#f-slug').value = v;
      if ($('#slug')) $('#slug').value = v;
      showUrl(v);
    }

    /**
     * Keep the address bar naming the page that would be written. A new page made by
     * copying an old one used to leave the old one's address on screen, which reads
     * like the original is still open and about to be written over.
     */
    function showUrl(slug) {
      const prefix = pageKind === 'article' ? '' : `${pageKind}:`;
      const q = slug ? `?a=${encodeURIComponent(prefix + slug)}` : '';
      history.replaceState(null, '', location.pathname + q);
    }

    // The picture the Media panel was opened for. Working this out from whatever has
    // focus does not survive the panel taking focus itself, so the caller says outright.
    let pickTarget = null;
    const openFor = (field) => {
      pickTarget = field;
      // A sidebar picture cannot float: the column is the frame. Choosing Static or a
      // Grid there changes how many pictures the row holds instead.
      const inSidebar = !!field?.closest?.('.ib-media');
      document.querySelector('[data-as="float"]')?.toggleAttribute('hidden', inSidebar);
      if (inSidebar) {
        const slots = field.closest('.ib-media').querySelectorAll('.ib-slot').length;
        const want = slots > 1 ? 'grid' : 'image';
        document.querySelectorAll('[data-as]').forEach((x) => x.classList.toggle('on', x.dataset.as === want));
        insertAs = want;
      }
      openMedia();
    };

    /** Make a sidebar picture row hold one picture or two. */
    function setSidebarSlots(cell, n) {
      const tr = cell.closest('tr');
      const rows = readInfobox();
      const i = [...ib.querySelectorAll('tr[data-kind]')].indexOf(tr);
      if (i < 0) return;
      const cur = rows[i];
      const held = cur.images || [{ src: cur.image || '', caption: cur.caption || '' }];
      if (held.length === n) return;
      const next = n > held.length ? [...held, { src: '', caption: '' }] : held.slice(0, n);
      rows[i] = next.length > 1
        ? { images: next }
        : { image: next[0].src, caption: next[0].caption };
      // Rebuilt from the row data rather than by moving nodes, so every slot comes
      // out with its own handlers.
      setInfobox(rows);
      sync();
    }

    // Static, floating or a grid: whichever the Media panel is set to, and the shape
    // the picture is cut to, which is its own proportions unless one is chosen.
    let insertAs = 'image';
    let insertRatio = '';

    /** How wide a picture dropped into a table cell starts out. */
    const CELL_WIDTH = 96;

    function useImage(path) {
      // Whatever the panel was opened for wins, then a field still being typed in.
      if (pickTarget?.isConnected) {
        const t = pickTarget;
        pickTarget = null;
        return fill(t, path);
      }
      const field = activeField();
      if (field) return fill(field, path);
      const near = activeText()?.closest?.('figure, tr[data-kind="image"]');
      if (near) return fill(near.querySelector('input.path'), path);
      // A picture in a table cell is an inline mark, because a figure cannot live in
      // a cell. It carries a width so it renders as a picture; an icon left at its
      // natural size comes out one line tall, which is right for a flag and useless
      // for a photograph.
      if (activeText()?.closest?.('.ed-tbl')) {
        insertToken('img', `${path}|${CELL_WIDTH}`);
        return;
      }
      // A grid the writer is already standing in gains another picture.
      const grid = activeText()?.closest?.('.blk-grid');
      if (insertAs === 'grid' && grid) {
        const f = figure({ src: path }, true);
        (grid.querySelector('.imgrid') || grid).append(f);
        sync();
        return;
      }
      // block() already carries the path in; hunting down "the last block of this
      // kind" afterwards filled whichever figure happened to sit lowest on the page.
      insert(insertAs, insertAs === 'grid'
        ? { items: [{ src: path, caption: '', ratio: insertRatio }] }
        : { src: path, ratio: insertRatio });
    }

    function insertToken(kind, slug) {
      const mark = 'tok-' + Date.now();
      const html = tokenHtml(kind, slug).replace('<img ', `<img data-new="${mark}" `) + '\u00a0';
      if (!insertAtCaret(html)) {
        flash('Put the cursor where it should go.', true);
        return false;                    // the caller leaves its menu open to retry
      }
      // execCommand leaves a trailing <br> after the inserted run; a table cell
      // would serialize that as a line break, so drop the one we just caused.
      const img = document.querySelector(`[data-new="${mark}"]`);
      if (img) {
        let n = img.nextSibling;
        while (n && n.nodeType === 3 && !n.nodeValue.trim()) n = n.nextSibling;
        if (n && n.nodeName === 'BR') n.remove();
        img.removeAttribute('data-new');
      }
      sync();
      return true;
    }

    const PANES = ['images', 'icons'];
    /** Open the Media panel on its image list, to fill whichever field was just focused. */
    function openMedia() {
      document.querySelectorAll('.drop-menu').forEach((m) => { m.hidden = m.id !== 'insert-menu'; });
      document.querySelectorAll('#insert-menu > .mp-tabs button')
        .forEach((x) => x.classList.toggle('on', x.dataset.pane === 'images'));
      for (const p of PANES) $('#pane-' + p).hidden = p !== 'images';
      loadAssets();
      $('#mp-link')?.focus();
    }
    document.querySelectorAll('#insert-menu > .mp-tabs button').forEach((b) => b.onclick = () => {
      document.querySelectorAll('#insert-menu > .mp-tabs button')
        .forEach((x) => x.classList.toggle('on', x === b));
      for (const p of PANES) $('#pane-' + p).hidden = b.dataset.pane !== p;
    });
    document.querySelectorAll('[data-as]').forEach((b) => b.onclick = () => {
      document.querySelectorAll('[data-as]').forEach((x) => x.classList.toggle('on', x === b));
      insertAs = b.dataset.as;
      // Aimed at the sidebar, this is a choice about that row rather than about what
      // the next insert will be.
      const cell = pickTarget?.closest?.('.ib-media');
      if (cell) setSidebarSlots(cell, insertAs === 'grid' ? 2 : 1);
    });
    document.querySelectorAll('[data-ratio]').forEach((b) => b.onclick = () => {
      document.querySelectorAll('[data-ratio]').forEach((x) => x.classList.toggle('on', x === b));
      insertRatio = b.dataset.ratio;
      // A shape the writer has just chosen applies to the picture they are standing in.
      const fig = activeText()?.closest?.('figure') || activeField()?.closest?.('figure');
      if (fig) { setRatio(fig, insertRatio); sync(); }
    });

    /** Put a shape on a figure, or take the one it has off. */
    function setRatio(fig, r) {
      [...fig.classList].filter((c) => /^r-/.test(c)).forEach((c) => fig.classList.remove(c));
      if (r) fig.classList.add(`r-${r}`);
    }

    if ($('#mp-link')) {
      const go = () => {
        const u = $('#mp-link').value.trim();
        if (!u) return;
        const bad = linkTrouble(u);
        if (bad) { linkNote(); flash(bad, true); return; }
        useImage(normaliseLink(u));
        $('#mp-link').value = '';
        linkNote();
      };
      $('#mp-link').oninput = linkNote;
      $('#mp-link').onkeydown = (e) => { if (e.key === 'Enter') { e.preventDefault(); go(); } };
      $('#mp-link-go').onclick = go;
      linkNote();
    }
    $('#mp-iq').oninput = paintAssets;
    // The menu stays open while you browse it, unlike a one-shot command.
    // A click anywhere shuts every menu. These two are panels to work in rather than
    // lists to pick from, so a click inside one must not reach that handler; each
    // closes itself once it has done the thing it was opened for.
    $('#insert-menu').addEventListener('click', (e) => e.stopPropagation());
    $('#ins-menu').addEventListener('click', (e) => e.stopPropagation());
    // Nothing in the panel may take focus, or the caret in the article is lost
    // before the chosen image or icon can be inserted at it.
    $('#insert-menu').addEventListener('mousedown', (e) => {
      if (e.target.closest('input, textarea')) return;
      e.preventDefault();
    });
    $('#insert').addEventListener('mousedown', (e) => e.preventDefault());
    $('#insert').addEventListener('click', () => { if (!$('#insert-menu').hidden) loadAssets(); });
    $('#mp-add')?.addEventListener('click', () => $('#mp-file').click());

    /* ---------- upload queue: name every file first ---------- */
    let queue = [];
    const qList = $('#mp-queue-list');
    const qBox = $('#mp-queue');
    const qBtn = $('#mp-upload');

    function paintQueue() {
      qBox.hidden = !queue.length;
      qList.innerHTML = '';
      queue.forEach((item, i) => {
        const row = el('div', 'mp-qrow');
        const thumb = el('img'); thumb.src = item.url; thumb.alt = '';
        const name = el('input'); name.type = 'text'; name.placeholder = 'Name this image';
        name.value = item.name;
        name.oninput = () => { queue[i].name = name.value; refreshBtn(); };
        const ext = el('span', 'mp-qext', (item.file.name.match(/\.[^.]+$/) || [''])[0].toLowerCase());
        const x = el('button', 'mp-qx', '\u2715'); x.type = 'button';
        x.onclick = () => { URL.revokeObjectURL(item.url); queue.splice(i, 1); paintQueue(); };
        row.append(thumb, name, ext, x);
        qList.append(row);
      });
      refreshBtn();
    }
    const refreshBtn = () => {
      qBtn.disabled = !queue.length || queue.some((q) => !slugFile(q.name).replace(/\.[^.]*$/, ''));
    };

    function enqueue(files) {
      for (const f of files) {
        if (!ALLOWED.test(f.name)) { flash(`${f.name} is not an allowed image type.`, true); continue; }
        queue.push({ file: f, name: '', url: URL.createObjectURL(f) });
      }
      paintQueue();
      qList.querySelector('input')?.focus();
    }

    // The queue only exists where uploading does, which is the dev server.
    if (qBtn) qBtn.onclick = async () => {
      const items = queue.slice();
      queue = []; paintQueue();
      for (const it of items) {
        await takeImage(it.file, it.name);
        URL.revokeObjectURL(it.url);
      }
      flash(`Uploaded ${items.length} image${items.length === 1 ? '' : 's'}.`);
    };

    if ($('#mp-file')) $('#mp-file').onchange = (e) => { enqueue(e.target.files); e.target.value = ''; };
    const pane = $('#pane-images');
    if (DEV) {
    pane.addEventListener('dragover', (e) => { e.preventDefault(); pane.classList.add('over'); });
    pane.addEventListener('dragleave', () => pane.classList.remove('over'));
    pane.addEventListener('drop', (e) => {
      e.preventDefault(); pane.classList.remove('over');
      enqueue([...(e.dataTransfer?.files || [])].filter((f) => f.type.startsWith('image/')));
    });

    // Dropping a file anywhere on the canvas files it and puts it in the article.
    const canvas = $('.ed-canvas');
    canvas.addEventListener('dragover', (e) => { e.preventDefault(); canvas.classList.add('drop'); });
    canvas.addEventListener('dragleave', () => canvas.classList.remove('drop'));
    canvas.addEventListener('drop', async (e) => {
      const files = [...(e.dataTransfer?.files || [])].filter((f) => f.type.startsWith('image/'));
      if (!files.length) return;
      e.preventDefault();
      canvas.classList.remove('drop');
      // Dropped files go to the naming queue like any other upload.
      enqueue(files);
      $('#insert').click();
    });
    canvas.addEventListener('paste', async (e) => {
      const files = [...(e.clipboardData?.files || [])].filter((f) => f.type.startsWith('image/'));
      if (!files.length) return;
      e.preventDefault();
      for (const f of files) {
        const path = await takeImage(f);
        if (path) useImage(path);
      }
    });
    }   // end of the upload paths, which only the dev server has

    /* ---------- zip, store-only, so images travel with the article ---------- */
    const CRC = (() => {
      const t = new Uint32Array(256);
      for (let n = 0; n < 256; n++) {
        let c = n;
        for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
        t[n] = c >>> 0;
      }
      return (buf) => {
        let crc = 0xffffffff;
        for (let i = 0; i < buf.length; i++) crc = t[(crc ^ buf[i]) & 0xff] ^ (crc >>> 8);
        return (crc ^ 0xffffffff) >>> 0;
      };
    })();

    function zip(entries) {
      const enc = new TextEncoder();
      const parts = [], central = [];
      let offset = 0;
      for (const { name, data } of entries) {
        const nameBytes = enc.encode(name);
        const crc = CRC(data);
        const lh = new DataView(new ArrayBuffer(30));
        lh.setUint32(0, 0x04034b50, true);
        lh.setUint16(4, 20, true);
        lh.setUint32(14, crc, true);
        lh.setUint32(18, data.length, true);
        lh.setUint32(22, data.length, true);
        lh.setUint16(26, nameBytes.length, true);
        parts.push(new Uint8Array(lh.buffer), nameBytes, data);

        const cd = new DataView(new ArrayBuffer(46));
        cd.setUint32(0, 0x02014b50, true);
        cd.setUint16(4, 20, true);
        cd.setUint16(6, 20, true);
        cd.setUint32(16, crc, true);
        cd.setUint32(20, data.length, true);
        cd.setUint32(24, data.length, true);
        cd.setUint16(28, nameBytes.length, true);
        cd.setUint32(42, offset, true);
        central.push(new Uint8Array(cd.buffer), nameBytes);
        offset += 30 + nameBytes.length + data.length;
      }
      const cdSize = central.reduce((n, c) => n + c.length, 0);
      const end = new DataView(new ArrayBuffer(22));
      end.setUint32(0, 0x06054b50, true);
      end.setUint16(8, entries.length, true);
      end.setUint16(10, entries.length, true);
      end.setUint32(12, cdSize, true);
      end.setUint32(16, offset, true);
      return new Blob([...parts, ...central, new Uint8Array(end.buffer)], { type: 'application/zip' });
    }

    /* ---------- boot ---------- */
    let booted = null;
    try { booted = JSON.parse(sessionStorage.getItem(DRAFT) || 'null'); } catch {}
    const want = new URLSearchParams(location.search).get('a');
    if (want) {
      setInfobox([]);
      body.append(block('para'));
      load(want);
    } else if (booted) {
      restore(booted);
      if (booted.saved) flash(`${booted.saved} — draft restored.`);
    } else {
      setInfobox(TEMPLATES.overview);
      body.append(block('para'));
    }
    sync();
    titlesReady.then(() => { sync(); paintAssets(); });
    loadAssets();
  </script>

