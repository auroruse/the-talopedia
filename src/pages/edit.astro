    /* ---- tables ---- */
    .tbl-wrap { margin: 16px 0; overflow-x: auto; max-width: 100%; min-width: 0; }
    /* max-content plus a scrolling wrapper: the table keeps its real width and the
       wrapper scrolls, instead of the table squeezing and spilling its cells. */
    .ed-tbl { width: max-content; min-width: 100%; }
    .ed-tbl { border-collapse: collapse; font-size: 14px; }
    /* An empty block with no height is no place for a caret, so a click in an empty
