    .src-head button { font: 12px var(--body); color: var(--muted); background: none; border: 1px solid var(--rule); border-radius: 3px; padding: 4px 10px; cursor: pointer; }
    #preview { flex: 1; overflow: auto; margin: 0; padding: 14px; font-size: 12px; line-height: 1.55; color: #cfd6db; background: #0b0e11; }

    .ed-rail.collapsed .toc-list { display: none; }

    /* ---- narrow: controls join the flow instead of floating beside the content ---- */
    @media (max-width: 1000px) {
      .blk > .ctl {
        position: static; display: none; width: max-content;
        margin-top: 6px; border-right-width: 1px;
