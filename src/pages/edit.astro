    .cart-n {
      display: inline-block; min-width: 16px; padding: 0 4px; margin-left: 5px;
      font: 10.5px var(--body); line-height: 16px; text-align: center; color: var(--ink);
      background: var(--band); border: 1px solid var(--rule); border-radius: 8px;
    }
    .pub-help { margin-top: 14px; border-top: 1px solid var(--rule); padding-top: 12px; }
    .pub-help summary { font: 12.5px var(--body); color: var(--link); cursor: pointer; }
    .pub-help[open] summary { margin-bottom: 4px; }
    .pub { max-height: calc(100vh - 80px); overflow-y: auto; }
    .pub-status { font-size: 12.5px; color: var(--muted); margin: 12px 0 0; min-height: 1.2em; }
    .pub-status.bad { color: #e08c8c; }
    .pub-row { display: flex; align-items: center; gap: 8px; margin-top: 16px; }
    .pub-row .spacer { flex: 1; }
    .pub-row button {
      font: 12.5px var(--body); color: var(--ink); background: var(--paper);
      border: 1px solid var(--rule); border-radius: 5px; padding: 7px 14px; cursor: pointer;
    }
