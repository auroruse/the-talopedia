    .cart-path { font: 11.5px ui-monospace, monospace; color: var(--muted);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cart-row button {
      flex: none; font: 11.5px var(--body); color: var(--muted); background: var(--paper);
      border: 1px solid var(--rule); border-radius: 4px; padding: 4px 9px; cursor: pointer;
    }
