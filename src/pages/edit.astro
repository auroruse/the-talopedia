    /* ---- figures ---- */
    .blk figure { margin: 16px 0; }
    .blk figure img { max-width: 100%; display: block; }
    .blk .cap { font-size: 12px; color: var(--muted); margin-top: 4px; }
    .blk .imgrid figure { margin: 0; position: relative; }
    .blk figure { position: relative; }
    .blk figure input.path { position: absolute; width: 1px; height: 1px; padding: 0; border: 0; opacity: 0; }
    .blk figure img { cursor: pointer; }
