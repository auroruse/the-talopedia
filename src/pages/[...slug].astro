---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Infobox from '../components/Infobox.astro';
import { coordsFor, nation, mapUrl, url } from '../lib/registry.mjs';
import { categoryOf } from '../lib/categories.mjs';
import { resolveHtml, renderNavbox } from '../lib/navbox.mjs';
import { ledeOf } from '../lib/inline.mjs';
import { firstImage } from '../lib/featured.mjs';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  // `home` is served at / by index.astro.
  return all.filter((e) => e.id !== 'home').map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const headings = entry.rendered?.metadata?.headings ?? [];
const html = resolveHtml(entry.rendered?.html ?? '');
const lede = ledeOf(entry.body);
// Explicit coords win; otherwise the map's own table answers for this subject.
const found = d.coords ? { position: d.coords } : coordsFor(d.title, entry.id);
// Nations link by their registry name, cities by the map's own spelling.
const href = found?.type === 'nation' ? mapUrl(nation(d.nation)?.name ?? d.title, 'nation')
  : found?.kind === 'city' ? mapUrl(found.name, 'city')
  : null;
const coords = found && { ...found, href };
const category = categoryOf(d.type);
---
<Base title={d.title} description={lede} image={firstImage(d)} headings={headings} coords={coords} nationId={d.nation} authorIds={d.authors} slug={entry.id}>
  {d.ooc && (
    <p class="notice">
      This article contains out-of-character (OOC) information. Some details presented here are
      not publicly available in-character (IC).
    </p>
  )}
  <article class="article" data-pagefind-body>
    {d.infobox.length > 0 && (
      <Infobox title={d.sidebarTitle || d.title} nativeTitle={d.nativeTitle} romaji={d.romaji} rows={d.infobox} />
    )}
    <Fragment set:html={html} />
  </article>
  {(d.navbox ?? d.nation) && <Fragment set:html={renderNavbox(d.navbox ?? d.nation, 'Navigation')} />}
  <nav class="catlinks" aria-label="Categories">
    <a href={url('/categories')}>Category</a>: <a href={url(`/category/${category.slug}`)}>{category.name}</a>
  </nav>
</Base>
