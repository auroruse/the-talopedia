---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, coordsFor, nation, mapUrl, navbox } from '../../lib/registry.mjs';
import { resolveHtml, renderNavbox } from '../../lib/navbox.mjs';

export async function getStaticPaths() {
  const all = await getCollection('portals');
  const articles = await getCollection('articles');
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      // The nation's own overview opens the portal, so the paragraph is written once
      // and read in both places. A nation with no overview yet keeps its portal's text.
      overview: articles.find((a) => a.data.type === 'overview' && a.data.nation === entry.data.nation),
    },
  }));
}

const { entry, overview } = Astro.props;
const d = entry.data;
const headings = entry.rendered?.metadata?.headings ?? [];
const own = resolveHtml(entry.rendered?.html ?? '');
const lede = resolveHtml((overview?.rendered?.html ?? '').match(/<p>[\s\S]*?<\/p>/)?.[0] ?? '');
// The portal's own text is drawn from the overview, so the thing on this page worth
// editing is its navbox. A nation without one falls back to the portal file itself.
const hasNavbox = !!navbox(d.nation);
const found = coordsFor(nation(d.nation)?.name, d.nation);
const coords = found && { ...found, href: found.type === 'nation' ? mapUrl(nation(d.nation)?.name ?? d.nation) : null };
---
<Base title={d.title} image={d.banner} headings={headings} coords={coords} nationId={d.nation} slug={`portal:${entry.id}`}
  editSlug={hasNavbox ? `navbox:${d.nation}` : `portal:${entry.id}`}
  editLabel={hasNavbox ? 'Edit navbox' : 'Edit'}>
  {d.banner && <img class="portal-banner" src={url(d.banner)} alt={d.title} />}
  {d.welcome && <p class="portal-welcome">{d.welcome}</p>}
  <div class="portal-lede article">
    {lede && <Fragment set:html={lede} />}
    {own && <Fragment set:html={own} />}
  </div>
  <Fragment set:html={renderNavbox(d.nation)} />
</Base>
